---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import FooterInfo from '../components/FooterInfo.astro';
import Contact from '../components/Contact.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import FaqSection from '../components/ui/FaqSection.astro';
import RelatedTreatments from '../components/ui/RelatedTreatments.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import CoralBranch from '../components/svg/CoralBranch.astro';
import Bubbles from '../components/svg/Bubbles.astro';
import Waves from '../components/svg/Waves.astro';
import TreatmentIcon from '../components/svg/TreatmentIcon.astro';
import { TEAM } from '../data/team';
import { useTranslations, getLangFromUrl } from '../i18n/utils';
import { pathFor, absoluteUrl, HTML_LANG, SITE_URL } from '../i18n/routes';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Short UI labels that only exist on this page.
const copy = ({
  es: {
    smileDesign: 'Diseño de sonrisa',
    dsd: 'Diseño digital de la sonrisa',
    golden: 'Proporción áurea',
    arc: 'Arco de la sonrisa',
    midline: 'Línea media',
    enamel: 'Esmalte',
    dentin: 'Dentina',
    solutions: 'Soluciones',
    goodToKnow: 'Bueno saberlo',
    ortho: 'Si los espacios o los dientes torcidos son el origen, la ortodoncia invisible puede ser la opción más conservadora.',
    lips: 'Los labios enmarcan la sonrisa: complétala con un tratamiento de ácido hialurónico.',
    budget: 'Consulta nuestros precios y las opciones de financiación para tu tratamiento estético.',
  },
  en: {
    smileDesign: 'Smile design',
    dsd: 'Digital smile design',
    golden: 'Golden proportion',
    arc: 'Smile arc',
    midline: 'Midline',
    enamel: 'Enamel',
    dentin: 'Dentin',
    solutions: 'Solutions',
    goodToKnow: 'Good to know',
    ortho: 'If gaps or crooked teeth are the cause, clear aligners may be the most conservative option.',
    lips: 'Your lips frame your smile: complete it with a hyaluronic acid treatment.',
    budget: 'See our prices and the financing options for your cosmetic treatment.',
  },
  de: {
    smileDesign: 'Smile-Design',
    dsd: 'Digitales Smile-Design',
    golden: 'Goldener Schnitt',
    arc: 'Lachlinie',
    midline: 'Mittellinie',
    enamel: 'Zahnschmelz',
    dentin: 'Dentin',
    solutions: 'Lösungen',
    goodToKnow: 'Gut zu wissen',
    ortho: 'Sind Lücken oder schiefe Zähne die Ursache, kann eine unsichtbare Zahnspange die schonendste Lösung sein.',
    lips: 'Die Lippen umrahmen Ihr Lächeln: Vollenden Sie es mit einer Hyaluronsäure-Behandlung.',
    budget: 'Sehen Sie sich unsere Preise und Finanzierungsmöglichkeiten für Ihre ästhetische Behandlung an.',
  },
  nl: {
    smileDesign: 'Glimlachontwerp',
    dsd: 'Digitaal glimlachontwerp',
    golden: 'Gulden snede',
    arc: 'Glimlachlijn',
    midline: 'Middellijn',
    enamel: 'Glazuur',
    dentin: 'Dentine',
    solutions: 'Oplossingen',
    goodToKnow: 'Goed om te weten',
    ortho: 'Zijn spleten of scheve tanden de oorzaak, dan kan onzichtbare orthodontie de meest conservatieve optie zijn.',
    lips: 'Uw lippen omlijsten uw glimlach: maak hem compleet met een behandeling met hyaluronzuur.',
    budget: 'Bekijk onze prijzen en de financieringsmogelijkheden voor uw esthetische behandeling.',
  },
  fr: {
    smileDesign: 'Design du sourire',
    dsd: 'Conception numérique du sourire',
    golden: 'Proportion dorée',
    arc: 'Courbe du sourire',
    midline: 'Ligne médiane',
    enamel: 'Émail',
    dentin: 'Dentine',
    solutions: 'Solutions',
    goodToKnow: 'Bon à savoir',
    ortho: 'Si des espaces ou des dents mal alignées sont en cause, l’orthodontie invisible peut être l’option la plus conservatrice.',
    lips: 'Les lèvres encadrent votre sourire : sublimez-le avec un traitement à l’acide hyaluronique.',
    budget: 'Consultez nos tarifs et les options de financement de votre traitement esthétique.',
  },
} as const)[lang];

const unquote = (s: string) => s.replace(/^["“]|["”]$/g, '');
/** "Carillas dentales: La magia…" → title + italic accent. */
const splitTitle = (s: string) => {
  const i = s.indexOf(':');
  return i < 0 ? { title: s, accent: undefined } : { title: s.slice(0, i).trim(), accent: s.slice(i + 1).trim() };
};

const specialists = ['/equipo/Ana-padilla.jpg', '/equipo/minerva.jpg', '/equipo/blaneirys.jpg']
  .map((image) => TEAM.find((m) => m.image === image))
  .filter((m) => m !== undefined);

/* ---------- Smile design drawing (front view, golden proportion) ---------- */
const INCISOR = 'M-15 0Q0-5 15 0C21 14 23 36 21 55Q20 64 12 65.5H-12Q-20 64-21 55C-23 36-21 14-15 0Z';
const CANINE = 'M-14 0Q0-5 14 0C20 16 22 36 18 50Q11 63 0 68Q-11 63-18 50C-22 36-20 16-14 0Z';
// Apparent widths shrink towards the back (1.618 : 1 : 0.618).
const smileTeeth = [
  { d: INCISOR, x: 137, y: 122, sx: 0.28, sy: 0.8, back: true },
  { d: INCISOR, x: 343, y: 122, sx: 0.28, sy: 0.8, back: true },
  { d: CANINE, x: 152.7, y: 116, sx: 0.45, sy: 0.95 },
  { d: CANINE, x: 327.3, y: 116, sx: 0.45, sy: 0.95 },
  { d: INCISOR, x: 176.6, y: 124, sx: 0.68, sy: 0.84 },
  { d: INCISOR, x: 303.4, y: 124, sx: 0.68, sy: 0.84 },
  { d: INCISOR, x: 215.8, y: 118, sx: 1.1, sy: 1.06 },
  { d: INCISOR, x: 264.2, y: 118, sx: 1.1, sy: 1.06 },
];
const goldenLines = [143.7, 161.7, 191.6, 240, 288.4, 318.3, 336.3];
const goldenLabels = [
  { x: 152.7, label: '0.618' },
  { x: 176.6, label: '1' },
  { x: 215.8, label: '1.618' },
  { x: 264.2, label: '1.618' },
  { x: 303.4, label: '1' },
  { x: 327.3, label: '0.618' },
];

const whiteningSteps = [
  { text: t('estetica.whitening.method.step1'), icon: 'tray' },
  { text: t('estetica.whitening.method.step2'), icon: 'calendar' },
  { text: t('estetica.whitening.method.step3'), icon: 'check' },
];
const shades = ['#E2C690', '#EAD3A6', '#F0DFBD', '#F6EAD3', '#FBF4E8', '#FFFFFF'];

const veneers = [
  {
    key: 'porcelain',
    badge: t('estetica.veneers.porcelain.badge'),
    title: t('estetica.veneers.porcelain.title'),
    desc: t('estetica.veneers.porcelain.desc'),
    feature: t('estetica.veneers.porcelain.feature'),
  },
  {
    key: 'composite',
    badge: t('estetica.veneers.composite.badge'),
    title: t('estetica.veneers.composite.title'),
    desc: t('estetica.veneers.composite.desc'),
    feature: t('estetica.veneers.composite.feature'),
  },
];
const veneersTitle = splitTitle(t('estetica.veneers.title'));

// Bespoke 48×48 icons for each problem (teal strokes, coral detail).
const CROWN = 'M15 10Q24 7 33 10C36 18 37 28 35 37Q34 42 29 42.5H19Q14 42 13 37C11 28 12 18 15 10Z';
const problems = [
  {
    text: t('estetica.problems.list.1'),
    icon: `<path d="${CROWN}"/><path d="M5 13C11 6 18 5.5 24 8.5 30 5.5 37 6 43 13" stroke="#F2617A"/><path d="M15.6 12.4Q24 9.6 32.4 12.4" stroke="#0A1F33" stroke-width="3.2"/>`,
  },
  {
    text: t('estetica.problems.list.2'),
    icon: `<path d="${CROWN}"/><path d="M14.5 19.5h19M14 26.5h20.5M14.5 33.5h19" stroke="#F2617A" stroke-width="2.6" stroke-opacity=".75"/>`,
  },
  {
    text: t('estetica.problems.list.3'),
    icon: `<path d="${CROWN}" stroke="#F2617A" stroke-dasharray="2.5 3"/><path d="M15 10Q24 7 33 10C35.5 17 36.5 24 36 31L32.5 35 29.5 32.5 26 40.5H19.5Q14.5 40 13.5 35.5C11.5 27 12.5 18 15 10Z"/>`,
  },
  {
    text: t('estetica.problems.list.4'),
    icon: `<path d="M15 10Q24 7 33 10C36 18 37 25 36.2 30L30.5 33.5 32.5 37.5 28.5 42.5H19Q14 42 13 37C11 28 12 18 15 10Z"/><path d="M39 33.5l4 3.5-2.5 5-4.5-2.5Z" stroke="#F2617A" fill="#FFE4E8"/><path d="M30.5 33.5 26 31.5" stroke="#F2617A"/>`,
  },
  {
    text: t('estetica.problems.list.5'),
    icon: '<path d="M6 10Q12.5 7.5 19 10C21 18 22 28 20.5 37Q19.5 42 15.5 42.5H10Q6 42 5 37C3.5 28 4 18 6 10Z"/><path d="M29 10Q35.5 7.5 42 10C44 18 44.5 28 43 37Q42 42 38 42.5H32.5Q28.5 42 27.5 37C26 28 27 18 29 10Z"/><path d="M21.5 25h5M23.5 23l-2 2 2 2M24.5 23l2 2-2 2" stroke="#F2617A"/>',
  },
];

const tips = [
  { href: pathFor('ortodoncia', lang), label: t('nav.treatments.ortodoncia'), text: copy.ortho, icon: 'ortodoncia' as const },
  { href: pathFor('armonia', lang), label: t('nav.treatments.armonia'), text: copy.lips, icon: 'armonia' as const },
  { href: pathFor('pricing', lang), label: t('nav.pricing'), text: copy.budget, icon: null },
];

const faqs = [1, 2, 3, 4, 5].map((n) => ({
  question: t(`estetica.faq.q${n}.q` as any),
  answer: t(`estetica.faq.q${n}.a` as any),
}));

const url = absoluteUrl(pathFor('estetica', lang));
const pageSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  '@id': `${url}#webpage`,
  url,
  name: t('estetica.meta.title'),
  description: t('estetica.meta.description'),
  inLanguage: HTML_LANG[lang],
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: {
    '@type': 'MedicalProcedure',
    name: t('nav.treatments.estetica'),
    procedureType: 'https://schema.org/NoninvasiveProcedure',
    bodyLocation: 'Mouth',
  },
  provider: { '@id': `${SITE_URL}/#dentist` },
  lastReviewed: '2026-11-11',
});
---

<Layout title={t('estetica.meta.title')} description={t('estetica.meta.description')} lang={lang} schema={pageSchema}>
  <Navigation />

  <main id="main">
    <PageHero
      badge={t('estetica.hero.badge')}
      title={t('nav.treatments.estetica')}
      accent={t('hero.in.vera')}
      subtitle={t('estetica.hero.subtitle')}
      breadcrumbs={[{ label: t('nav.treatments.estetica') }]}
      illustration="estetica"
      illustrationTitle={t('nav.treatments.estetica')}
      highlights={[t('estetica.hero.result.natural'), t('estetica.hero.result.minimal'), t('estetica.whitening.box2.title')]}
    />

    <!-- Artistic vision: smile design + the team -->
    <section class="section-y relative overflow-hidden bg-white">
      <div class="container-k">
        <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5">
            <SectionHeading eyebrow={copy.smileDesign} title={t('estetica.hero.title')} accent={t('estetica.hero.title.italic')} />

            <div class="mt-10 border-l-2 border-coral pl-6" data-reveal style="--d:.1s">
              <h3 class="font-sans text-xl font-semibold tracking-tight">{t('estetica.secret.title')}</h3>
              <blockquote class="font-display mt-3 text-xl italic leading-relaxed text-ocean-900/85">{unquote(t('estetica.secret.desc'))}</blockquote>
            </div>

            <div class="mt-10 rounded-[1.75rem] bg-sand p-6 md:p-7" data-reveal style="--d:.15s">
              <p class="eyebrow">{t('estetica.hero.specialist.role')}</p>
              <ul class="mt-5 space-y-4">
                {specialists.map((m) => (
                  <li class="flex items-center gap-4">
                    <img src={m.image} alt={`${m.name}, ${t(m.role)}`} width="52" height="52" class="h-13 w-13 shrink-0 rounded-full object-cover ring-2 ring-white" loading="lazy" decoding="async" />
                    <span class="text-sm">
                      <span class="block font-semibold text-ocean-900">{m.name}</span>
                      <span class="block text-slate-500">{t(m.role)}</span>
                    </span>
                  </li>
                ))}
              </ul>
              <a href={pathFor('team', lang)} class="prose-link mt-5 inline-block text-sm">{t('team.cta')}</a>
            </div>
          </div>

          <div class="lg:col-span-7" data-reveal="right">
            <figure class="relative overflow-hidden rounded-[2rem] bg-sand p-5 ring-1 ring-ocean-900/5 md:p-8">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <p class="eyebrow mt-2">{copy.dsd}</p>
                <p class="-rotate-3 rounded-2xl bg-ocean-900 px-5 py-3 text-white shadow-[var(--shadow-elevated)]">
                  <span class="block text-[10px] font-semibold uppercase tracking-[0.2em] text-white/60">{t('estetica.hero.floating.specialists')}</span>
                  <span class="font-display block text-xl italic leading-tight text-coral-soft">{t('estetica.hero.floating.harmony')}</span>
                </p>
              </div>

              <div class="mt-5 overflow-hidden rounded-[1.5rem] bg-white ring-1 ring-ocean-900/5" aria-hidden="true">
                <svg viewBox="0 0 480 290" class="block h-auto w-full" fill="none" stroke-linecap="round" stroke-linejoin="round">
                  <defs>
                    <pattern id="est-canvas" width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0V24" stroke="#0B7C86" stroke-opacity=".07" /></pattern>
                    <linearGradient id="est-enamel" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFFFFF" /><stop offset="1" stop-color="#EAF6F7" /></linearGradient>
                    <linearGradient id="est-lip-up" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F7A8B5" /><stop offset="1" stop-color="#EC7489" /></linearGradient>
                    <linearGradient id="est-lip-low" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F0798D" /><stop offset="1" stop-color="#FDBDC7" /></linearGradient>
                  </defs>
                  <rect width="480" height="290" fill="url(#est-canvas)" />
                  <!-- mouth, gum and teeth -->
                  <path d="M104 158C140 128 190 113 240 113S340 128 376 158C330 186 284 200 240 200S150 186 104 158Z" fill="#143B5C" />
                  <path d="M104 158C140 128 190 113 240 113S340 128 376 158V174C340 144 290 129 240 129S140 144 104 174Z" fill="#F7A6B4" />
                  {smileTeeth.map((tt) => (
                    <path d={tt.d} transform={`translate(${tt.x} ${tt.y}) scale(${tt.sx} ${tt.sy})`} fill="url(#est-enamel)" stroke="#0A1F33" stroke-opacity={tt.back ? 0.15 : 0.22} stroke-width="1.2" vector-effect="non-scaling-stroke" opacity={tt.back ? 0.75 : 1} />
                  ))}
                  <path d="M202 132C199 148 199 164 202 178M250 132C247 148 247 164 250 178" stroke="#FFFFFF" stroke-width="3" />
                  <!-- lips -->
                  <path d="M100 160C128 134 170 104 210 95Q226 92 240 101Q254 92 270 95C310 104 352 134 380 160C344 133 292 113 240 113S136 133 100 160Z" fill="url(#est-lip-up)" stroke="#C9304A" stroke-opacity=".25" />
                  <path d="M100 160C136 188 188 201 240 201S344 188 380 160C356 200 306 226 240 228S124 200 100 160Z" fill="url(#est-lip-low)" stroke="#C9304A" stroke-opacity=".2" />
                  <path d="M204 213C226 219 254 219 276 213" stroke="#FFFFFF" stroke-opacity=".5" stroke-width="3" />
                  <path d="M180 107C194 101 206 99 216 100" stroke="#FFFFFF" stroke-opacity=".45" stroke-width="2" />
                  <!-- design guides -->
                  <path d="M240 16V276" stroke="#0B7C86" stroke-opacity=".55" stroke-width="1.2" stroke-dasharray="4 5" />
                  <path d="M104 158H376" stroke="#0B7C86" stroke-opacity=".3" stroke-width="1.2" stroke-dasharray="2 5" />
                  {goldenLines.map((x) => (
                    <path d={`M${x} 58V196`} stroke="#0B7C86" stroke-opacity=".45" stroke-width="1" stroke-dasharray="2 4" />
                  ))}
                  <path d="M143.7 58H336.3" stroke="#0B7C86" stroke-opacity=".6" stroke-width="1.2" />
                  {goldenLines.map((x) => (
                    <path d={`M${x} 54V62`} stroke="#0B7C86" stroke-width="1.2" />
                  ))}
                  {goldenLabels.map((g) => (
                    <text x={g.x} y="46" text-anchor="middle" fill="#0B7C86" font-family="Inter, system-ui, sans-serif" font-size="10.5" font-weight="600">{g.label}</text>
                  ))}
                  <path d="M120 176Q240 204 360 176" stroke="#F2617A" stroke-width="2.4" pathLength="1" class="draw-me" style="--dd:.5s" />
                  <circle cx="104" cy="158" r="4" fill="#fff" stroke="#0B7C86" stroke-width="1.6" />
                  <circle cx="376" cy="158" r="4" fill="#fff" stroke="#0B7C86" stroke-width="1.6" />
                  <path d="M430 40l2.6 7.4 7.4 2.6-7.4 2.6-2.6 7.4-2.6-7.4-7.4-2.6 7.4-2.6Z" fill="#F2617A" class="animate-twinkle" />
                  <path d="M52 228l1.8 5.2 5.2 1.8-5.2 1.8-1.8 5.2-1.8-5.2-5.2-1.8 5.2-1.8Z" fill="#2CC5D2" class="animate-twinkle" style="animation-delay:-1.5s" />
                </svg>
              </div>

              <figcaption class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-600">
                <span class="inline-flex items-center gap-2"><svg width="24" height="10" aria-hidden="true"><path d="M1 5h22" stroke="#0B7C86" stroke-width="1.4" stroke-dasharray="2 3" /></svg>{copy.golden}</span>
                <span class="inline-flex items-center gap-2"><svg width="24" height="10" aria-hidden="true"><path d="M1 3q11 6 22 0" fill="none" stroke="#F2617A" stroke-width="2" /></svg>{copy.arc}</span>
                <span class="inline-flex items-center gap-2"><svg width="24" height="10" aria-hidden="true"><path d="M1 5h22" stroke="#0B7C86" stroke-width="1.4" stroke-dasharray="4 4" /></svg>{copy.midline}</span>
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- Teeth whitening -->
    <section class="section-y relative overflow-hidden bg-sand">
      <CoralBranch seed={61} color="coral" class="pointer-events-none absolute -right-12 top-12 h-[260px] w-auto opacity-[0.1]" />
      <div class="container-k relative">
        <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-6">
            <SectionHeading eyebrow={t('estetica.whitening.badge')} title={t('estetica.whitening.title')} />
            <p class="mt-6 text-lg leading-relaxed text-slate-600 [&_strong]:font-semibold [&_strong]:text-ocean-900" data-reveal style="--d:.08s" set:html={t('estetica.whitening.desc')} />

            <div class="mt-10 rounded-[2rem] bg-white p-7 shadow-[var(--shadow-card)] ring-1 ring-ocean-900/5 md:p-9" data-reveal style="--d:.12s">
              <div class="flex items-start gap-4">
                <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-coral-pale text-coral-deep">
                  <svg width="30" height="30" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 40V22a16 16 0 0 1 32 0v18" /><path d="M16 40V22a8 8 0 0 1 16 0v18" /><path d="M8 40h8M32 40h8" /><path d="M24 10v-5M14 13l-3-4M34 13l3-4" stroke="#0B7C86" /></svg>
                </span>
                <div>
                  <h3 class="font-sans text-xl font-semibold tracking-tight">{t('estetica.whitening.method.title')}</h3>
                  <p class="mt-1 text-[15px] text-slate-600">{t('estetica.whitening.method.subtitle')}</p>
                </div>
              </div>

              <ol class="relative mt-8 space-y-6">
                <span class="absolute bottom-5 left-[21px] top-5 w-px bg-gradient-to-b from-accent/40 via-coral/40 to-accent/40" aria-hidden="true"></span>
                {whiteningSteps.map((step) => (
                  <li class="relative flex items-center gap-5">
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white text-accent ring-1 ring-accent/20 shadow-[var(--shadow-soft)]">
                      {step.icon === 'tray' && (
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21v-9a8 8 0 0 1 16 0v9" /><path d="M8.5 21v-9a3.5 3.5 0 0 1 7 0v9" /><circle cx="6.2" cy="11" r=".6" fill="#F2617A" stroke="#F2617A" /><circle cx="12" cy="5.7" r=".6" fill="#F2617A" stroke="#F2617A" /><circle cx="17.8" cy="11" r=".6" fill="#F2617A" stroke="#F2617A" /></svg>
                      )}
                      {step.icon === 'calendar' && (
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="3" /><path d="M3.5 10h17M8 3v4M16 3v4" /><path d="m9 15 2 2 4-4" stroke="#F2617A" /></svg>
                      )}
                      {step.icon === 'check' && (
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4H7a2.5 2.5 0 0 0-2.5 2.5v12A2.5 2.5 0 0 0 7 21h10a2.5 2.5 0 0 0 2.5-2.5v-12A2.5 2.5 0 0 0 17 4h-2" /><rect x="9" y="2.5" width="6" height="3.5" rx="1.2" /><path d="m8.8 13.5 2.2 2.2 4.4-4.6" stroke="#F2617A" /></svg>
                      )}
                    </span>
                    <span class="text-[15px] font-medium text-ocean-900">{step.text}</span>
                  </li>
                ))}
              </ol>
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2 lg:col-span-6 lg:self-center">
            <!-- enamel vs dentin -->
            <figure class="relative overflow-hidden rounded-[2rem] bg-white p-6 shadow-[var(--shadow-card)] ring-1 ring-ocean-900/5 sm:col-span-2" data-reveal="right">
              <svg viewBox="0 0 320 250" class="mx-auto block h-auto w-full max-w-[360px]" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <defs>
