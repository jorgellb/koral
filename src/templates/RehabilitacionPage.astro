/* ---------------------------------------------------------------------------
   Icon geometry (48 / 24 grid, `currentColor` strokes + one coral detail).
   --------------------------------------------------------------------------- */
const CORAL = '#F2617A';
// Permanent molar, centred on (24, 23.5), 32 × 33 units.
const TOOTH =
  'M16 7c-4.4 0-8 3.4-8 8.6 0 5 2.6 7.9 3.6 13.4.9 5 1.5 11 5 11 3.2 0 3.3-5.6 4.6-9.6.6-1.9 1.6-2.9 2.8-2.9s2.2 1 2.8 2.9c1.3 4 1.4 9.6 4.6 9.6 3.5 0 4.1-6 5-11 1-5.5 3.6-8.4 3.6-13.4C40 10.4 36.4 7 32 7c-3.4 0-5 1.8-8 1.8S19.4 7 16 7Z';
const r2 = (n: number) => Math.round(n * 100) / 100;
/** Molar outline placed at (cx, cy) with scale s, keeping the visual stroke width `sw`. */
const tooth = (cx: number, cy: number, s: number, sw = 2) =>
  `<path d="${TOOTH}" transform="translate(${r2(cx - 24 * s)} ${r2(cy - 23.5 * s)}) scale(${s})" stroke-width="${r2(sw / s)}"/>`;
const star4 = (cx: number, cy: number, r: number) =>
  `M${cx} ${cy - r}Q${cx} ${cy} ${cx + r} ${cy}Q${cx} ${cy} ${cx} ${cy + r}Q${cx} ${cy} ${cx - r} ${cy}Q${cx} ${cy} ${cx} ${cy - r}Z`;
const coralFill = `stroke="${CORAL}" fill="${CORAL}" fill-opacity=".14"`;

const icons = {
  // Pillars
  scan: `${tooth(24, 24, 0.66)}<path d="M6 13V8a2 2 0 0 1 2-2h5M35 6h5a2 2 0 0 1 2 2v5M42 35v5a2 2 0 0 1-2 2h-5M13 42H8a2 2 0 0 1-2-2v-5"/><path d="M4 24h40" stroke="${CORAL}" stroke-dasharray="2 3"/>`,
  design: `<rect x="5" y="7" width="38" height="27" rx="4"/><path d="M18 41h12M24 34v7"/><path d="M11 13.5h26M17 13.5v7.4M24 13.5v12.6M31 13.5v7.4" stroke-opacity=".45"/><path d="M11 16.5c4 6.5 8.5 9.8 13 9.8s9-3.3 13-9.8" stroke="${CORAL}"/><circle cx="11" cy="16.5" r="2" fill="#FFFFFF" stroke="${CORAL}"/><circle cx="24" cy="26.3" r="2" fill="#FFFFFF" stroke="${CORAL}"/><circle cx="37" cy="16.5" r="2" fill="#FFFFFF" stroke="${CORAL}"/>`,
  craft: `<path d="M10 24c0-8 3.5-13 8.5-13 2.6 0 3.6 1.4 5.5 1.4s2.9-1.4 5.5-1.4c5 0 8.5 5 8.5 13 0 4-2 6.5-5 8.5H15c-3-2-5-4.5-5-8.5Z"/><path d="M12.5 21.5c7.5 1.6 15.5 1.6 23 0M14 27.5c6.6 1.4 13.4 1.4 20 0" stroke-opacity=".45"/><path d="M15 32.5l1.6 9M33 32.5l-1.6 9" stroke-opacity=".45"/><path d="${star4(40, 7, 4.5)}" ${coralFill}/>`,
  bite: `<path d="M10 5h28v7c0 4-2.2 6.5-5 6.5-2 0-3-2-4.5-2s-2.7 2-4.5 2-3-2-4.5-2-2.5 2-4.5 2c-2.8 0-5-2.5-5-6.5Z"/><path d="M10 43h28v-7c0-4-2.2-6.5-5-6.5-2 0-3 2-4.5 2s-2.7-2-4.5-2-3 2-4.5 2-2.5-2-4.5-2c-2.8 0-5 2.5-5 6.5Z"/><path d="M4 24h40" stroke="${CORAL}" stroke-dasharray="2 3"/><circle cx="15" cy="24" r="1.6" fill="${CORAL}" stroke="none"/><circle cx="24" cy="24" r="1.6" fill="${CORAL}" stroke="none"/><circle cx="33" cy="24" r="1.6" fill="${CORAL}" stroke="none"/>`,
  // Restorations
  inlay: `${tooth(24, 25.5, 0.9)}<path d="M19 12.4l1.4 8h7.2l1.4-8" ${coralFill}/>`,
  crown: `<path d="M13 18.5c0-7 4.8-12 11-12s11 5 11 12c0 1.6-1 2.6-2.6 2.6H15.6c-1.6 0-2.6-1-2.6-2.6Z" ${coralFill}/><path d="M21.5 23.3 24 25l2.5-1.7" stroke="${CORAL}" stroke-opacity=".6"/><path d="M17.5 33l1.4-6.5h10.2l1.4 6.5"/><path d="M17.5 33c0 5 1.2 9 3.2 9 1.8 0 1.8-3.6 3.3-3.6s1.5 3.6 3.3 3.6c2 0 3.2-4 3.2-9Z"/>`,
  bridge: `<path d="M5 14c0-4 2.4-6 5.5-6S16 10 16 14v8H5ZM32 14c0-4 2.4-6 5.5-6S43 10 43 14v8H32Z"/><path d="M18 14c0-4 2.4-6 6-6s6 2 6 6v8H18Z" ${coralFill}/><path d="M16 15.5h2M30 15.5h2" stroke="${CORAL}"/><path d="M6.5 22v8c0 5 1.5 10 4 10s4-5 4-10v-8M33.5 22v8c0 5 1.5 10 4 10s4-5 4-10v-8"/><path d="M3 27h42" stroke-opacity=".35" stroke-dasharray="2 3"/>`,
  implant: `<path d="M5 16c0-3 2-5 4.75-5s4.75 2 4.75 5c0-3 2-5 4.75-5s4.75 2 4.75 5c0-3 2-5 4.75-5s4.75 2 4.75 5c0-3 2-5 4.75-5s4.75 2 4.75 5v5.5c0 1.4-1.1 2.5-2.5 2.5h-33A2.5 2.5 0 0 1 5 21.5Z"/><path d="M14.5 16v3.5M24 16v3.5M33.5 16v3.5" stroke-opacity=".45"/><path d="M15 24v3.5h4V24M29 24v3.5h4V24"/><path d="M14.5 27.5h5l-.8 12.5-1.7 2.5-1.7-2.5ZM28.5 27.5h5l-.8 12.5-1.7 2.5-1.7-2.5Z"/><path d="M14.6 31.5h4.8M14.9 35.2h4.2M28.6 31.5h4.8M28.9 35.2h4.2" stroke="${CORAL}"/>`,
  // Check-ups (24 grid)
  bitewing: `<rect x="3" y="4.5" width="18" height="15" rx="3"/><path d="M7 8.3c0 1.7.9 2.9 2 2.9s2-1.2 2-2.9M13 8.3c0 1.7.9 2.9 2 2.9s2-1.2 2-2.9M7 15.7c0-1.7.9-2.9 2-2.9s2 1.2 2 2.9M13 15.7c0-1.7.9-2.9 2-2.9s2 1.2 2 2.9"/><circle cx="12" cy="13.6" r="1.2" fill="${CORAL}" stroke="none"/>`,
  interproximal: `<rect x="3" y="5" width="8" height="14" rx="3.5"/><rect x="13" y="5" width="8" height="14" rx="3.5"/><circle cx="12" cy="10" r="1.4" fill="${CORAL}" stroke="none"/><circle cx="12" cy="10" r="4.2" stroke="${CORAL}" stroke-dasharray="1.5 1.5"/>`,
};

const pillars = [
  { title: t('rehabilitacion.pillar.1.title'), desc: t('rehabilitacion.pillar.1.desc'), icon: icons.scan },
  { title: t('rehabilitacion.pillar.2.title'), desc: t('rehabilitacion.pillar.2.desc'), icon: icons.design },
  { title: t('rehabilitacion.pillar.3.title'), desc: t('rehabilitacion.pillar.3.desc'), icon: icons.craft },
  { title: t('rehabilitacion.pillar.4.title'), desc: t('rehabilitacion.pillar.4.desc'), icon: icons.bite },
];

const coordinated = (['implantes', 'endodoncia', 'periodoncia', 'ortodoncia', 'estetica'] as const).map((key) => ({
  key,
  href: pathFor(key, lang),
  label: t(`nav.treatments.${key}`),
}));

const solutions = [
  { title: copy.inlayTitle, desc: copy.inlayDesc, icon: icons.inlay },
  { title: copy.crownTitle, desc: copy.crownDesc, icon: icons.crown },
  { title: copy.bridgeTitle, desc: copy.bridgeDesc, icon: icons.bridge },
  { title: copy.implantTitle, desc: copy.implantDesc, icon: icons.implant, link: { href: pathFor('implantes', lang), label: t('nav.treatments.implantes') } },
];

const checkups = [
  { label: t('rehabilitacion.prevention.list.1'), icon: icons.bitewing },
  { label: t('rehabilitacion.prevention.list.2'), icon: icons.interproximal },
];

// Bitewing radiograph: three lower and three upper molars, with a cavity between two of them.
const xray = (cx: number, cy: number, flip: boolean) => `translate(${cx} ${cy}) scale(2.2 ${flip ? -2.2 : 2.2}) translate(-24 -23.5)`;
const xrayTeeth = [55, 130, 205];

const faqs = [1, 2, 3, 4, 5].map((n) => ({
  question: t(`rehabilitacion.faq.q${n}.q` as any),
  answer: t(`rehabilitacion.faq.q${n}.a` as any),
}));

const unquote = (s: string) => s.replace(/^\s*["“„«]\s*|\s*["”“»]\s*$/g, '');
const pad = (n: number) => String(n).padStart(2, '0');

const url = absoluteUrl(pathFor('rehabilitacion', lang));
const pageSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  '@id': `${url}#webpage`,
  url,
  name: t('rehabilitacion.meta.title'),
  description: t('rehabilitacion.meta.description'),
  inLanguage: HTML_LANG[lang],
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: {
    '@type': 'MedicalProcedure',
    name: t('nav.treatments.rehabilitacion'),
    procedureType: 'https://schema.org/NoninvasiveProcedure',
    bodyLocation: 'Mouth',
  },
  provider: { '@id': `${SITE_URL}/#dentist` },
  lastReviewed: '2026-11-11',
});
---

<Layout title={t('rehabilitacion.meta.title')} description={t('rehabilitacion.meta.description')} lang={lang} schema={pageSchema}>
  <Navigation />

  <main id="main">
    <PageHero
      badge={t('rehabilitacion.hero.badge')}
      title={t('nav.treatments.rehabilitacion')}
      accent={t('hero.in.vera')}
      subtitle={t('rehabilitacion.hero.desc')}
      breadcrumbs={[{ label: t('nav.treatments.rehabilitacion') }]}
      illustration="rehabilitacion"
      illustrationTitle={t('nav.treatments.rehabilitacion')}
      highlights={[t('rehabilitacion.hero.planning'), t('rehabilitacion.hero.results'), t('rehabilitacion.pillar.1.title')]}
    />

    <!-- Integral vision (overflow-clip, not hidden, so the sticky column follows the viewport) -->
    <section class="section-y relative overflow-clip bg-white">
      <div class="container-k">
        <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-5">
            <div class="lg:sticky lg:top-32">
              <SectionHeading eyebrow={t('rehabilitacion.vision.badge')} title={t('rehabilitacion.vision.title')} />
              <p class="mt-6 text-lg leading-relaxed text-slate-600" data-reveal style="--d:.05s">{t('rehabilitacion.vision.p1')}</p>

              <figure class="relative mt-10 rounded-[2rem] bg-sand p-8 md:p-10" data-reveal style="--d:.1s">
                <svg class="absolute -top-5 left-8 h-10 w-12 text-coral" viewBox="0 0 100 80" fill="currentColor" aria-hidden="true"><path d="M0 80V48C0 20 14 4 40 0l4 10C28 16 22 26 22 40h18v40Zm56 0V48C56 20 70 4 96 0l4 10C84 16 78 26 78 40h18v40Z" /></svg>
                <blockquote class="font-display text-xl italic leading-relaxed text-ocean-900 md:text-2xl">
                  {unquote(t('rehabilitacion.vision.quote'))}
                </blockquote>
                <figcaption class="mt-6">
                  <a href={pathFor('team', lang)} class="link-u text-sm font-semibold text-accent">{t('team.cta')} →</a>
                </figcaption>
              </figure>
            </div>
          </div>

          <div class="relative lg:col-span-7">
            <!-- blueprint grid -->
            <div
              class="pointer-events-none absolute -inset-8 hidden md:block"
              style="background-image:linear-gradient(rgba(11,124,134,0.08) 1px,transparent 1px),linear-gradient(90deg,rgba(11,124,134,0.08) 1px,transparent 1px);background-size:36px 36px;-webkit-mask-image:radial-gradient(70% 60% at 50% 40%,#000 0%,transparent 100%);mask-image:radial-gradient(70% 60% at 50% 40%,#000 0%,transparent 100%)"
              aria-hidden="true"
            ></div>

            <ol class="relative grid gap-5 sm:grid-cols-2">
              {pillars.map((pillar, i) => (
                <li class:list={['surface-card group relative p-7 md:p-8', i % 2 === 1 && 'sm:translate-y-10']} data-reveal style={`--d:${i * 0.08}s`}>
                  <div class="mb-6 flex items-start justify-between">
                    <span class="flex h-16 w-16 items-center justify-center rounded-2xl bg-aqua-pale text-accent transition-colors duration-500 group-hover:bg-accent group-hover:text-white">
                      <svg width="38" height="38" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={pillar.icon} />
                    </span>
                    <span class="font-display text-3xl italic text-coral" aria-hidden="true">{pad(i + 1)}</span>
                  </div>
                  <h3 class="font-sans text-xl font-semibold tracking-tight">{pillar.title}</h3>
                  <p class="mt-2 text-[15px] leading-relaxed text-slate-600">{pillar.desc}</p>
                </li>
              ))}
            </ol>

            <div class="relative mt-8 rounded-[1.75rem] border border-accent/15 bg-aqua-pale/40 p-6 sm:mt-16 md:p-7" data-reveal>
              <p class="font-semibold text-ocean-900">{copy.coordinate}</p>
              <ul class="mt-4 flex flex-wrap gap-2.5">
                {coordinated.map((item) => (
                  <li>
                    <a href={item.href} class="inline-flex items-center gap-2 rounded-full border border-ocean-900/10 bg-white py-2 pl-2.5 pr-4 text-sm font-semibold text-ocean-900 transition-colors duration-300 hover:border-accent hover:text-accent">
                      <TreatmentIcon name={item.key} size={22} strokeWidth={2} class="text-accent" />
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Conservative philosophy -->
    <section class="section-y relative overflow-hidden bg-sand">
      <CoralBranch seed={88} color="teal" class="pointer-events-none absolute -right-10 top-10 hidden h-[260px] w-auto opacity-[0.1] lg:block" />
      <div class="container-k relative">
        <SectionHeading eyebrow={t('rehabilitacion.philosophy.badge')} title={t('rehabilitacion.philosophy.title')} description={t('rehabilitacion.philosophy.desc')} align="center" />

        <div class="mt-16 grid gap-6 lg:grid-cols-12">
          <article class="rounded-[2rem] bg-white p-7 shadow-[var(--shadow-card)] ring-1 ring-ocean-900/5 md:p-10 lg:col-span-7" data-reveal>
            <p class="eyebrow">{t('rehabilitacion.inlays.subtitle')}</p>
            <h3 class="mt-4 text-3xl md:text-[2.4rem]">{t('rehabilitacion.inlays.title')}</h3>

            <figure class="mt-8 rounded-[1.5rem] bg-sand px-5 py-6 md:px-7 md:py-8">
              <div class="mx-auto max-w-[480px]">
                <svg class="block w-full" viewBox="0 0 360 170" aria-hidden="true">
                  <defs>
                    <clipPath id="rh-roots"><rect x="0" y="26" width="48" height="30" /></clipPath>
                    <clipPath id="rh-tooth"><path d={TOOTH} /></clipPath>
                  </defs>
                  <!-- crown: most of the tooth is replaced -->
                  <g transform="translate(90 88) scale(3.8) translate(-24 -23.5)">
                    <path d={TOOTH} fill="#D5F6F8" />
                    <path d={TOOTH} fill="#F3ECE3" clip-path="url(#rh-roots)" />
                    <path d="M15.6 26.4 17 16.2Q24 13.6 31 16.2l1.4 10.2Z" fill="#F3ECE3" stroke="#94A3B8" stroke-width="1.2" stroke-dasharray="3 3" vector-effect="non-scaling-stroke" />
                    <path d={TOOTH} fill="none" stroke="#0B7C86" stroke-width="2" vector-effect="non-scaling-stroke" />
                    <path d="M12.6 13.4c.7-2.3 2.2-3.6 4.4-4" fill="none" stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                  </g>
                  <!-- inlay: only the missing part is added -->
                  <g transform="translate(270 88) scale(3.8) translate(-24 -23.5)">
                    <path d={TOOTH} fill="#F3ECE3" />
                    <path d="M18.6 0v13.6Q24 16.4 29.4 13.6V0Z" fill="#D5F6F8" stroke="#0B7C86" stroke-width="1.4" vector-effect="non-scaling-stroke" clip-path="url(#rh-tooth)" />
                    <path d={TOOTH} fill="none" stroke="#0B7C86" stroke-width="2" vector-effect="non-scaling-stroke" />
                    <path d="M12.6 13.4c.7-2.3 2.2-3.6 4.4-4" fill="none" stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                  </g>
                  <circle cx="340" cy="28" r="13" fill="#F2617A" />
                  <path d="m334 28.5 4.2 4.2 8-8.4" fill="none" stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M180 22v130" stroke="#0A1F33" stroke-opacity=".12" stroke-dasharray="3 5" />
                </svg>
                <figcaption>
                  <div class="mt-4 grid grid-cols-2 gap-4 text-center">
                    <p class="text-sm font-semibold text-slate-600">{copy.crown}</p>
                    <p class="text-sm font-semibold text-ocean-900">
                      {copy.inlay}
                      <span class="mt-1 block text-xs font-medium text-coral-deep">{copy.preferred}</span>
                    </p>
                  </div>
                  <div class="mt-5 flex flex-wrap justify-center gap-x-6 gap-y-2 border-t border-ocean-900/[0.07] pt-4 text-xs font-medium text-slate-600">
                    <span class="inline-flex items-center gap-2"><span class="h-3 w-3 rounded-[4px] bg-[#F3ECE3] ring-1 ring-ocean-900/15"></span>{copy.natural}</span>
                    <span class="inline-flex items-center gap-2"><span class="h-3 w-3 rounded-[4px] bg-aqua-pale ring-1 ring-accent/50"></span>{copy.restoration}</span>
                  </div>
                </figcaption>
              </div>
            </figure>

            <p class="mt-8 text-[17px] leading-relaxed text-slate-600 [&_strong]:font-semibold [&_strong]:text-ocean-900" set:html={t('rehabilitacion.inlays.desc')} />
            <p class="mt-6 flex items-center gap-3 rounded-2xl border border-accent/15 bg-aqua-pale/40 p-4 text-[15px] font-medium text-ocean-900">
              <svg class="shrink-0 text-accent" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" /><path d="m9 12 2 2 4-4" stroke="#F2617A" /></svg>
              {t('rehabilitacion.inlays.check')}
            </p>
          </article>

          <article class="relative isolate overflow-hidden rounded-[2rem] bg-ocean p-7 text-white shadow-[var(--shadow-elevated)] md:p-10 lg:col-span-5" data-reveal style="--d:.1s">
