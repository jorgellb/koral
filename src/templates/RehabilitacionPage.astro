            <h3 class="text-3xl text-white md:text-[2.2rem]">{t('rehabilitacion.prevention.title')}</h3>
            <p class="mt-4 leading-relaxed text-white/70">{t('rehabilitacion.prevention.desc')}</p>

            <svg class="mt-8 w-full" viewBox="0 0 260 124" aria-hidden="true">
              <defs><clipPath id="rh-film"><rect x="2" y="2" width="256" height="120" rx="16" /></clipPath></defs>
              <rect x="2" y="2" width="256" height="120" rx="16" fill="#051321" fill-opacity=".55" stroke="#8FE3EA" stroke-opacity=".3" />
              <g clip-path="url(#rh-film)">
                {xrayTeeth.map((x) => (
                  <g>
                    <path d={TOOTH} transform={xray(x, 102.3, false)} fill="#E3EEF1" fill-opacity=".82" />
                    <path d={TOOTH} transform={xray(x, 21.7, true)} fill="#E3EEF1" fill-opacity=".82" />
                    <ellipse cx={x} cy="96" rx="9" ry="10" fill="#0E2B45" fill-opacity=".45" />
                    <ellipse cx={x} cy="28" rx="9" ry="10" fill="#0E2B45" fill-opacity=".45" />
                  </g>
                ))}
                <path d="M2 62h256" stroke="#8FE3EA" stroke-opacity=".25" stroke-dasharray="2 4" />
              </g>
              <circle cx="88.5" cy="84" r="3.6" fill="#F2617A" />
              <circle cx="92" cy="84" r="13" fill="none" stroke="#F2617A" stroke-width="1.4" stroke-dasharray="2 3" />
            </svg>

            <ul class="mt-6 space-y-3">
              {checkups.map((item) => (
                <li class="flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-4">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-aqua/15 text-aqua-soft">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
                  </span>
                  <span class="text-[15px] font-medium text-white">{item.label}</span>
                </li>
              ))}
            </ul>

            <p class="mt-8 border-t border-white/10 pt-6 text-[15px] text-white/70">
              {copy.nerveLead}{' '}
              <a href={pathFor('endodoncia', lang)} class="font-semibold text-aqua-soft underline decoration-aqua/30 underline-offset-4 hover:decoration-aqua">{t('nav.treatments.endodoncia')}</a>
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Restorations we use -->
    <section class="relative isolate overflow-hidden bg-ocean text-white">
      <Waves fill="#FBF8F4" flip class="absolute inset-x-0 top-[-1px] z-10" />
      <Waves fill="#ffffff" class="absolute inset-x-0 bottom-[-1px] z-10" />
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <Bubbles count={12} seed={58} />
        <svg class="absolute inset-0 h-full w-full opacity-[0.07]"><defs><pattern id="rh-grid" width="64" height="64" patternUnits="userSpaceOnUse"><path d="M64 0H0V64" fill="none" stroke="#8FE3EA" stroke-width=".6" /></pattern></defs><rect width="100%" height="100%" fill="url(#rh-grid)" /></svg>
        <CoralBranch seed={137} color="duo" class="absolute -left-10 -bottom-2 h-[170px] w-auto opacity-20 md:h-[200px]" />
      </div>

      <div class="container-k pb-36 pt-32 md:pb-44 md:pt-40">
        <SectionHeading
          eyebrow={copy.solutionsEyebrow}
          title={t('rehabilitacion.hero.title')}
          accent={t('rehabilitacion.hero.title.span')}
          description={copy.solutionsDesc}
          tone="dark"
          split
        />

        <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {solutions.map((item, i) => (
            <li class="group relative flex flex-col rounded-[1.75rem] border border-white/10 bg-white/[0.05] p-7 backdrop-blur-xl transition-colors duration-500 hover:border-aqua/40 hover:bg-white/[0.08]" data-reveal style={`--d:${i * 0.08}s`}>
              <span class="mb-7 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/[0.07] text-aqua-soft ring-1 ring-white/10 transition-colors duration-500 group-hover:bg-white group-hover:text-accent">
                <svg width="40" height="40" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
              </span>
              <h3 class="font-sans text-xl font-semibold tracking-tight text-white">{item.title}</h3>
              <p class="mt-2 flex-1 text-[15px] leading-relaxed text-white/65">{item.desc}</p>
              {item.link && (
                <a href={item.link.href} class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-aqua-soft">
                  <span class="link-u">{item.link.label}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
              )}
            </li>
          ))}
        </ul>

        <div class="mt-8 grid gap-4 rounded-[1.75rem] border border-white/10 bg-white/[0.04] p-6 md:grid-cols-2 md:p-7" data-reveal>
          <p class="flex items-center gap-4 text-white/75">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-coral/15 text-coral-soft" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3.5c-2.5 0-4.5 2-4.5 5 0 3 1.4 4.6 2 7.6.5 2.6.9 5.4 2.6 5.4 1.6 0 1.8-2.8 2.4-4.8.3-1 .8-1.5 1.5-1.5s1.2.5 1.5 1.5c.6 2 .8 4.8 2.4 4.8 1.7 0 2.1-2.8 2.6-5.4.6-3 2-4.6 2-7.6 0-3-2-5-4.5-5-1.8 0-2.6 1-4 1s-2.2-1-4-1Z" /><path d="M19.5 2.5v3M18 4h3" stroke="#FF9AAA" /></svg>
            </span>
            <span>
              {copy.estheticsLead}{' '}
              <a href={pathFor('estetica', lang)} class="font-semibold text-aqua-soft underline decoration-aqua/30 underline-offset-4 hover:decoration-aqua">{t('nav.treatments.estetica')}</a>
            </span>
          </p>
          <p class="flex items-center gap-4 text-white/75 md:border-l md:border-white/10 md:pl-6">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-aqua/15 text-aqua-soft" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5.5" width="18" height="13" rx="2.5" /><path d="M3 10h18" /><path d="M7 14.5h4" stroke="#FF9AAA" /></svg>
            </span>
            <span>
              {copy.pricingLead}{' '}
              <a href={pathFor('pricing', lang)} class="font-semibold text-aqua-soft underline decoration-aqua/30 underline-offset-4 hover:decoration-aqua">{t('nav.pricing')}</a>
            </span>
          </p>
        </div>
      </div>
    </section>

    <div class="bg-white py-10 md:py-14">
      <CtaBand />
    </div>

    <FaqSection eyebrow={t('rehabilitacion.faq.badge')} title={t('rehabilitacion.faq.title')} faqs={faqs} />

    <RelatedTreatments current="rehabilitacion" />

    <Contact />
  </main>

  <FooterInfo />
</Layout>
