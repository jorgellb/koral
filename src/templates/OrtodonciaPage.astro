---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import FooterInfo from '../components/FooterInfo.astro';
import Contact from '../components/Contact.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import FaqSection from '../components/ui/FaqSection.astro';
import RelatedTreatments from '../components/ui/RelatedTreatments.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import CoralBranch from '../components/svg/CoralBranch.astro';
import Bubbles from '../components/svg/Bubbles.astro';
import Waves from '../components/svg/Waves.astro';
import TreatmentIcon from '../components/svg/TreatmentIcon.astro';
import { TEAM } from '../data/team';
import { useTranslations, getLangFromUrl } from '../i18n/utils';
import { pathFor, absoluteUrl, HTML_LANG, SITE_URL } from '../i18n/routes';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Short UI labels that only exist on this page.
const copy = ({
  es: {
    simulation: 'Simulación digital',
    before: 'Posición inicial',
    after: 'Posición planificada',
    phases: ['Diagnóstico', 'Movimiento', 'Retención'],
    finishes: ['Metal', 'Cerámica', 'Oro'],
    goodToKnow: 'Bueno saberlo',
    kids: 'En niños recomendamos la primera revisión de ortodoncia hacia los 6 años.',
    finish: 'Al terminar, el blanqueamiento o las carillas pueden completar tu nueva sonrisa.',
    budget: 'Te damos un presupuesto claro y te explicamos las opciones de financiación.',
  },
  en: {
    simulation: 'Digital simulation',
    before: 'Starting position',
    after: 'Planned position',
    phases: ['Diagnosis', 'Movement', 'Retention'],
    finishes: ['Metal', 'Ceramic', 'Gold'],
    goodToKnow: 'Good to know',
    kids: 'For children, we recommend a first orthodontic check-up at around age 6.',
    finish: 'Once you finish, whitening or veneers can complete your new smile.',
    budget: 'We give you a clear quote and explain your financing options.',
  },
  de: {
    simulation: 'Digitale Simulation',
    before: 'Ausgangsposition',
    after: 'Geplante Position',
    phases: ['Diagnose', 'Bewegung', 'Retention'],
    finishes: ['Metall', 'Keramik', 'Gold'],
    goodToKnow: 'Gut zu wissen',
    kids: 'Bei Kindern empfehlen wir die erste kieferorthopädische Kontrolle mit etwa 6 Jahren.',
    finish: 'Nach der Behandlung können Bleaching oder Veneers Ihr neues Lächeln vollenden.',
    budget: 'Sie erhalten einen klaren Kostenvoranschlag und wir erklären Ihnen die Finanzierungsmöglichkeiten.',
  },
  nl: {
    simulation: 'Digitale simulatie',
    before: 'Beginpositie',
    after: 'Geplande positie',
    phases: ['Diagnose', 'Verplaatsing', 'Retentie'],
    finishes: ['Metaal', 'Keramiek', 'Goud'],
    goodToKnow: 'Goed om te weten',
    kids: 'Bij kinderen raden we een eerste orthodontische controle aan rond de leeftijd van 6 jaar.',
    finish: 'Na de behandeling kunnen bleken of facings uw nieuwe glimlach afmaken.',
    budget: 'U krijgt een duidelijke offerte en wij leggen de financieringsmogelijkheden uit.',
  },
  fr: {
    simulation: 'Simulation numérique',
    before: 'Position initiale',
    after: 'Position planifiée',
    phases: ['Diagnostic', 'Déplacement', 'Contention'],
    finishes: ['Métal', 'Céramique', 'Or'],
    goodToKnow: 'Bon à savoir',
    kids: 'Chez l’enfant, nous recommandons un premier contrôle orthodontique vers 6 ans.',
    finish: 'Une fois le traitement terminé, le blanchiment ou les facettes peuvent parfaire votre sourire.',
    budget: 'Nous vous remettons un devis clair et vous expliquons les options de financement.',
  },
} as const)[lang];

const unquote = (s: string) => s.replace(/^["“]|["”]$/g, '');
const withoutEmoji = (s: string) => s.replace(/\s*\p{Extended_Pictographic}️?/gu, '').trim();
const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
/** Splits a paragraph around its highlighted phrase so it can be wrapped in <strong>. */
const emphasize = (text: string, phrase: string) => {
  const i = text.indexOf(phrase);
  return i < 0 ? { before: text, strong: '', after: '' } : { before: text.slice(0, i), strong: phrase, after: text.slice(i + phrase.length) };
};
/** "Ventaja principal: …" → label + text. */
const splitLabel = (s: string) => {
  const i = s.indexOf(':');
  return i < 0 ? { label: '', text: s } : { label: s.slice(0, i).trim(), text: s.slice(i + 1).trim() };
};

const philosophy = [
  { ...emphasize(t('ortodoncia.philosophy.p1'), t('ortodoncia.philosophy.p1.strong')), icon: 'diagnosis' },
  { ...emphasize(t('ortodoncia.philosophy.p2'), t('ortodoncia.philosophy.p2.strong')), icon: 'digital' },
];

const orthodontist = TEAM.find((m) => m.image === '/equipo/ana-soler.jpg')!;

/* ---------- Front-view teeth shared by the simulation and the appliance drawings ---------- */
const INCISOR = 'M-15 0Q0-5 15 0C21 14 23 36 21 55Q20 64 12 65.5H-12Q-20 64-21 55C-23 36-21 14-15 0Z';
const CANINE = 'M-14 0Q0-5 14 0C20 16 22 36 18 50Q11 63 0 68Q-11 63-18 50C-22 36-20 16-14 0Z';
// Six upper front teeth, centred on x=0 with the gum line at y≈0.
const arch = [
  { d: CANINE, x: -99, y: -2, s: 0.92 },
  { d: INCISOR, x: -62, y: 4, s: 0.82 },
  { d: INCISOR, x: -22, y: 0, s: 1 },
  { d: INCISOR, x: 22, y: 0, s: 1 },
  { d: INCISOR, x: 62, y: 4, s: 0.82 },
  { d: CANINE, x: 99, y: -2, s: 0.92 },
];
// Where each tooth starts before treatment (simulation ghost).
const crooked = [
  { x: -95, y: -20, r: -12 },
  { x: -64, y: 10, r: 14 },
  { x: -24, y: 6, r: -7 },
  { x: 26, y: -2, r: 9 },
  { x: 58, y: 12, r: -14 },
  { x: 100, y: -12, r: 8 },
];
const GUM = 'M-132 6Q-99-14-80 10Q-62-6-44 12Q-22-12 0 14Q22-12 44 12Q62-6 80 10Q99-14 132 6C142-10 128-30 100-36Q0-56-100-36C-128-30-142-10-132 6Z';
const GUM_EDGE = 'M-132 6Q-99-14-80 10Q-62-6-44 12Q-22-12 0 14Q22-12 44 12Q62-6 80 10Q99-14 132 6';
const brackets = [
  { x: -99, y: 33 },
  { x: -62, y: 35.5 },
  { x: -22, y: 37 },
  { x: 22, y: 37 },
  { x: 62, y: 35.5 },
  { x: 99, y: 33 },
];

/* ---------- Small bite diagrams (120×90) for each common problem ---------- */
const r1 = (n: number) => Math.round(n * 10) / 10;
const crown = (w: number, h: number) => {
  const a = w / 2;
  return `M${r1(-a + 2)} 0Q0 -2.5 ${r1(a - 2)} 0C${r1(a + 0.8)} ${r1(h * 0.35)} ${r1(a + 0.8)} ${r1(h * 0.7)} ${r1(a - 0.6)} ${r1(h - 3)}Q${r1(a - 1.6)} ${h} ${r1(a - 4.5)} ${h}H${r1(-a + 4.5)}Q${r1(-a + 1.6)} ${h} ${r1(-a + 0.6)} ${r1(h - 3)}C${r1(-a - 0.8)} ${r1(h * 0.7)} ${r1(-a - 0.8)} ${r1(h * 0.35)} ${r1(-a + 2)} 0Z`;
};
type ToothOpts = { rot?: number; lower?: boolean; hl?: boolean; fade?: boolean };
const tooth = (x: number, y: number, w: number, h: number, { rot = 0, lower = false, hl = false, fade = false }: ToothOpts = {}) =>
  `<path d="${crown(w, h)}" transform="translate(${x} ${y})${lower ? ' scale(1 -1)' : ''}${rot ? ` rotate(${rot})` : ''}" fill="${hl ? '#FFE4E8' : '#fff'}"${hl ? ' stroke="#F2617A"' : ''}${fade ? ' stroke-opacity=".45"' : ''}/>`;
// Side view (facing right): incisor profile with the labial surface on +x.
const PROFILE = 'M-7 0H5C9 10 10 22 6 34Q4 38 1 36C-3 26-7 12-7 0Z';
type SideOpts = { lower?: boolean; hl?: boolean; s?: number };
const side = (x: number, y: number, rot: number, { lower = false, hl = false, s = 1 }: SideOpts = {}) =>
  `<path d="${PROFILE}" transform="translate(${x} ${y})${lower ? ' scale(1 -1)' : ''} rotate(${rot}) scale(${s})" fill="${hl ? '#FFE4E8' : '#fff'}"${hl ? ' stroke="#F2617A"' : ''} vector-effect="non-scaling-stroke"/>`;
const gum = (fill: string, edge: string) => `<path d="${fill}" fill="#FFE4E8" stroke="none"/><path d="${edge}" stroke="#F2617A" stroke-opacity=".5"/>`;
const gumUp = gum('M4 2H116V15Q60 9 4 15Z', 'M4 15Q60 9 116 15');
const gumLow = gum('M4 88H116V76Q60 82 4 76Z', 'M4 76Q60 82 116 76');
const molars =
  '<path d="M13 20H39V36C39 41 37 43 35 43L32 40.5 29 43 26 40.5 23 43 20 40.5 17 43C15 43 13 41 13 36Z" fill="#fff"/>' +
  '<path d="M13 70H39V53C39 48 37 46 35 46L32 48.5 29 46 26 48.5 23 46 20 48.5 17 46C15 46 13 48 13 53Z" fill="#fff"/>' +
  '<path d="M4 44.5H48" stroke-opacity=".3" stroke-dasharray="2 3"/>';
const coralMark = (d: string) => `<path d="${d}" stroke="#F2617A" stroke-width="1.8"/>`;
const lowerRow = (h: number, fade = false, xs = [22.5, 37.5, 52.5, 67.5, 82.5, 97.5]) => xs.map((x) => tooth(x, 78, 15, h, { lower: true, fade })).join('');

const bites = {
  crowding:
    [32, 46, 60, 74, 88].map((x) => tooth(x, 78, 14, 26, { lower: true, fade: true })).join('') +
    tooth(18, 13, 17, 31, { rot: -6 }) + tooth(35, 14, 17, 31, { rot: 8 }) + tooth(69, 13, 17, 31, { rot: 5 }) +
    tooth(86, 14, 17, 31, { rot: -8 }) + tooth(103, 13, 17, 31, { rot: 4 }) + tooth(52, 19, 17, 29, { rot: -16, hl: true }) +
    gumUp + gumLow,
  openBite:
    lowerRow(30, false, [22.5, 37.5, 82.5, 97.5]) + lowerRow(19, false, [52.5, 67.5]) +
    [18, 35, 86, 103].map((x) => tooth(x, 13, 17, 35)).join('') + [52, 69].map((x) => tooth(x, 13, 17, 24)).join('') +
    gumUp + gumLow + coralMark('M60.5 41V55M57.5 44l3-3 3 3M57.5 52l3 3 3-3'),
  crossbite:
    tooth(69, 13, 17, 37, { hl: true }) + lowerRow(32) + [18, 35, 52, 86, 103].map((x) => tooth(x, 13, 17, 37)).join('') +
    gumUp + gumLow,
  diastema:
    [39, 53, 67, 81].map((x) => tooth(x, 78, 14, 26, { lower: true, fade: true })).join('') +
    tooth(22, 13, 19, 34) + tooth(42, 13, 19, 38) + tooth(78, 13, 19, 38) + tooth(98, 13, 19, 34) +
    gumUp + gumLow + coralMark('M54 31H66M57 28l-3 3 3 3M63 28l3 3-3 3'),
  // Upper incisors far ahead of the lower ones (overjet).
  classII:
    molars + side(84, 17, -20, { hl: true, s: 1.1 }) + side(72, 76, -6, { lower: true }) +
    gum('M4 2H96C106 4 108 14 100 20Q52 16 4 21Z', 'M4 21Q52 16 100 20C108 14 106 4 96 2') +
    gum('M4 88H74C82 88 86 80 82 72Q44 76 4 70Z', 'M4 70Q44 76 82 72C86 80 82 88 74 88') +
    coralMark('M77 60H99M77 57v6M99 57v6'),
  // Lower jaw and incisors in front of the upper ones.
  classIII:
    molars + side(76, 17, -6, { s: 1.1 }) + side(94, 78, -18, { lower: true, hl: true, s: 0.95 }) +
    gum('M4 2H84C94 4 96 14 88 20Q46 16 4 21Z', 'M4 21Q46 16 88 20C96 14 94 4 84 2') +
    gum('M4 88H104C114 88 118 78 110 72Q56 78 4 70Z', 'M4 70Q56 78 110 72C118 78 114 88 104 88') +
    coralMark('M72 82H98M93 78.5l5 3.5-5 3.5'),
};

const problems = [
  { title: t('ortodoncia.prob.t1'), desc: t('ortodoncia.prob.d1'), art: bites.crowding },
  { title: t('ortodoncia.prob.t2'), desc: t('ortodoncia.prob.d2'), art: bites.openBite },
  { title: t('ortodoncia.prob.t3'), desc: t('ortodoncia.prob.d3'), art: bites.crossbite },
  { title: t('ortodoncia.prob.t4'), desc: t('ortodoncia.prob.d4'), art: bites.diastema },
  { title: t('ortodoncia.prob.t5'), desc: t('ortodoncia.prob.d5'), art: bites.classII },
  { title: t('ortodoncia.prob.t6'), desc: t('ortodoncia.prob.d6'), art: bites.classIII },
];

const options = [
  {
    key: 'aligner',
    title: t('ortodoncia.options.invisalign.title'),
    desc: t('ortodoncia.options.invisalign.desc'),
    advantage: splitLabel(t('ortodoncia.options.invisalign.advantage')),
  },
  {
    key: 'brackets',
    title: t('ortodoncia.options.brackets.title'),
    desc: t('ortodoncia.options.brackets.desc'),
    advantage: splitLabel(t('ortodoncia.options.brackets.advantage')),
  },
];
const finishes = [
  { label: copy.finishes[0], from: '#E7EDF2', to: '#8D9DAB' },
  { label: copy.finishes[1], from: '#FFFFFF', to: '#E9E2D6' },
  { label: copy.finishes[2], from: '#F4D58D', to: '#B98A2E' },
];

const tips = [
  { href: pathFor('odontopediatria', lang), label: t('nav.treatments.odontopediatria'), text: copy.kids, icon: 'odontopediatria' as const },
  { href: pathFor('estetica', lang), label: t('nav.treatments.estetica'), text: copy.finish, icon: 'estetica' as const },
  { href: pathFor('pricing', lang), label: t('nav.pricing'), text: copy.budget, icon: null },
];

// Cephalometric landmarks for the diagnosis drawing.
const landmarks = [
  { x: 146, y: 182, label: 'S', dx: -16, dy: -8 },
  { x: 256, y: 156, label: 'N', dx: 4, dy: -12 },
  { x: 276, y: 268, label: 'A', dx: -16, dy: 4 },
  { x: 272, y: 332, label: 'B', dx: -16, dy: 4 },
  { x: 286, y: 362, label: 'Pog', dx: -30, dy: 12 },
  { x: 266, y: 392, label: 'Me', dx: 10, dy: 14 },
  { x: 160, y: 336, label: 'Go', dx: -26, dy: 4 },
];

const faqs = [1, 2, 3, 4, 5].map((n) => ({
  question: t(`ortodoncia.faq.q${n}` as any),
  answer: t(`ortodoncia.faq.a${n}` as any),
}));

const url = absoluteUrl(pathFor('ortodoncia', lang));
const pageSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  '@id': `${url}#webpage`,
  url,
  name: t('ortodoncia.meta.title'),
  description: t('ortodoncia.meta.description'),
  inLanguage: HTML_LANG[lang],
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: {
    '@type': 'MedicalProcedure',
    name: t('nav.treatments.ortodoncia'),
    procedureType: 'https://schema.org/NoninvasiveProcedure',
    bodyLocation: 'Mouth',
  },
  provider: { '@id': `${SITE_URL}/#dentist` },
  lastReviewed: '2026-11-11',
});
---

<Layout title={t('ortodoncia.meta.title')} description={t('ortodoncia.meta.description')} lang={lang} schema={pageSchema}>
  <Navigation />

  <main id="main">
    <PageHero
      badge={withoutEmoji(t('ortodoncia.hero.badge'))}
      title={t('nav.treatments.ortodoncia')}
      accent={t('hero.in.vera')}
      subtitle={t('ortodoncia.hero.subtitle')}
      breadcrumbs={[{ label: t('nav.treatments.ortodoncia') }]}
      illustration="ortodoncia"
      illustrationTitle={t('nav.treatments.ortodoncia')}
      highlights={['Invisalign®', t('ortodoncia.study.tech.title'), capitalize(t('ortodoncia.philosophy.p2.strong'))]}
    />

    <!-- Philosophy: diagnosis first, digital planning -->
    <section class="section-y relative overflow-hidden bg-white">
      <div class="container-k">
        <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-6">
            <SectionHeading eyebrow={t('ortodoncia.philosophy.badge')} title={t('ortodoncia.philosophy.title')} />

            <div class="mt-10 space-y-7">
              {philosophy.map((p, i) => (
                <div class="flex flex-col gap-4 sm:flex-row sm:gap-5" data-reveal style={`--d:${0.08 + i * 0.08}s`}>
                  <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-aqua-pale text-accent">
                    {p.icon === 'diagnosis' ? (
                      <svg width="30" height="30" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 7c-4.4 0-8 3.4-8 8.6 0 5 2.6 7.9 3.6 13.4.9 5 1.5 11 5 11 3.2 0 3.3-5.6 4.6-9.6.6-1.9 1.6-2.9 2.8-2.9s2.2 1 2.8 2.9c1.3 4 1.4 9.6 4.6 9.6 3.5 0 4.1-6 5-11 1-5.5 3.6-8.4 3.6-13.4C40 10.4 36.4 7 32 7c-3.4 0-5 1.8-8 1.8S19.4 7 16 7Z" transform="translate(-2 -1) scale(.82)" vector-effect="non-scaling-stroke" /><circle cx="33" cy="32" r="7" stroke="#F2617A" /><path d="m38 37 6 6" stroke="#F2617A" /></svg>
                    ) : (
                      <svg width="30" height="30" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M24 5 40 14v20L24 43 8 34V14Z" /><path d="m8 14 16 9 16-9M24 23v20" /><path d="M3 26h42" stroke="#F2617A" stroke-dasharray="2.5 3.5" /></svg>
                    )}
                  </span>
                  <p class="text-lg leading-relaxed text-slate-600">
                    {p.before}<strong class="font-semibold text-ocean-900">{p.strong}</strong>{p.after}
                  </p>
                </div>
              ))}
            </div>

            <figure class="mt-10 flex flex-col gap-5 rounded-[1.75rem] border border-accent/15 bg-aqua-pale/40 p-6 sm:flex-row sm:items-center md:p-7" data-reveal style="--d:.2s">
              <img src={orthodontist.image} alt={`${orthodontist.name}, ${t(orthodontist.role)}`} width="80" height="80" class="h-20 w-20 shrink-0 rounded-2xl object-cover ring-4 ring-white" loading="lazy" decoding="async" />
              <figcaption>
                <p class="text-[15px] leading-relaxed text-slate-700">{t('ortodoncia.philosophy.warning')}</p>
                <p class="mt-3 text-sm">
                  <span class="font-semibold text-ocean-900">{orthodontist.name}</span>
                  <span class="text-slate-500"> · {t(orthodontist.role)}</span>
                </p>
                <a href={pathFor('team', lang)} class="prose-link mt-2 inline-block text-sm">{t('team.cta')}</a>
              </figcaption>
            </figure>
          </div>

          <!-- Digital simulation -->
          <div class="lg:col-span-6" data-reveal="right">
            <figure class="relative overflow-hidden rounded-[2rem] bg-sand p-6 ring-1 ring-ocean-900/5 md:p-8">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="eyebrow">{copy.simulation}</p>
                  <p class="font-display mt-2 text-2xl text-ocean-900 md:text-3xl">
                    {t('ortodoncia.hero.title')} <span class="italic text-coral">{t('ortodoncia.hero.title.italic')}</span>
                  </p>
                </div>
                <span class="font-display shrink-0 rounded-full bg-white px-3.5 py-1.5 text-sm italic text-accent shadow-[var(--shadow-soft)]">3D</span>
              </div>

              <div class="mt-6 rounded-[1.5rem] bg-white ring-1 ring-ocean-900/5" aria-hidden="true">
                <svg viewBox="0 0 520 268" class="block h-auto w-full" fill="none">
                  <defs>
                    <pattern id="orto-canvas" width="26" height="26" patternUnits="userSpaceOnUse"><path d="M26 0H0V26" stroke="#0B7C86" stroke-opacity=".07" /></pattern>
                    <linearGradient id="orto-enamel" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFFFFF" /><stop offset="1" stop-color="#E4F5F6" /></linearGradient>
                    <linearGradient id="orto-gum" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFE4E8" stop-opacity=".2" /><stop offset=".55" stop-color="#FFC9D2" /><stop offset="1" stop-color="#FFB3C0" /></linearGradient>
                  </defs>
                  <rect width="520" height="268" fill="url(#orto-canvas)" />
                  <path d="M260 12V222" stroke="#0B7C86" stroke-opacity=".25" stroke-dasharray="3 6" />
                  <g transform="translate(260 96) scale(1.42)">
                    {arch.map((a) => (
                      <path d={a.d} transform={`translate(${a.x} ${a.y}) scale(${a.s})`} fill="url(#orto-enamel)" stroke="#0B7C86" stroke-width="1.6" vector-effect="non-scaling-stroke" />
                    ))}
                    <path d={GUM} fill="url(#orto-gum)" />
                    <path d={GUM_EDGE} stroke="#F2617A" stroke-opacity=".6" stroke-width="1.1" pathLength="1" class="draw-me" />
                    {arch.map((a, i) => (
                      <path d={a.d} transform={`translate(${crooked[i].x} ${crooked[i].y}) rotate(${crooked[i].r}) scale(${a.s})`} stroke="#0A1F33" stroke-opacity=".38" stroke-width="1.3" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />
                    ))}
                    <path d="M-130 56Q0 80 130 56" stroke="#F2617A" stroke-width="1.5" stroke-linecap="round" pathLength="1" class="draw-me" style="--dd:.6s" />
                    <path d="M-128-6V14M-132 9.5l4 4.5 4-4.5" stroke="#F2617A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" pathLength="1" class="draw-me" style="--dd:1s" />
                  </g>
                  <g transform="translate(60 244)">
                    <path d="M0 0H400" stroke="#0A1F33" stroke-opacity=".1" stroke-width="2" />
                    <path d="M0 0H400" stroke="#0B7C86" stroke-width="2.4" stroke-linecap="round" pathLength="1" class="draw-me" style="--dd:.4s" />
                    <circle r="7" fill="#0B7C86" />
                    <circle cx="200" r="7" fill="#fff" stroke="#0B7C86" stroke-width="2" />
                    <circle cx="400" r="7" fill="#fff" stroke="#F2617A" stroke-width="2" />
                    <circle cx="400" r="2.6" fill="#F2617A" />
                  </g>
                </svg>
              </div>

              <ol class="mt-4 grid grid-cols-3 text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">
                {copy.phases.map((phase, i) => (
                  <li class:list={[i === 0 ? 'text-left' : i === 1 ? 'text-center' : 'text-right', i === 2 && 'text-coral-deep']}>{phase}</li>
                ))}
              </ol>

              <figcaption class="mt-5 flex flex-wrap gap-x-6 gap-y-2 border-t border-ocean-900/[0.07] pt-5 text-sm text-slate-600">
                <span class="inline-flex items-center gap-2"><svg width="26" height="10" aria-hidden="true"><path d="M1 5h24" stroke="#0A1F33" stroke-opacity=".5" stroke-width="1.6" stroke-dasharray="4 3" /></svg>{copy.before}</span>
                <span class="inline-flex items-center gap-2"><svg width="26" height="10" aria-hidden="true"><path d="M1 5h24" stroke="#0B7C86" stroke-width="2" /></svg>{copy.after}</span>
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- Common problems -->
    <section class="section-y relative overflow-hidden bg-sand">
      <CoralBranch seed={52} color="teal" class="pointer-events-none absolute -left-12 top-16 h-[260px] w-auto opacity-[0.09]" />
      <div class="container-k relative">
        <SectionHeading eyebrow={t('ortodoncia.problems.badge')} title={t('ortodoncia.problems.title')} align="center">
          <p class="font-display mx-auto mt-6 max-w-2xl text-2xl italic leading-snug text-coral-deep md:text-[1.75rem]">{unquote(t('ortodoncia.problems.quote'))}</p>
        </SectionHeading>

        <ul class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {problems.map((p, i) => (
            <li class="surface-card group flex flex-col p-6 md:p-7" data-reveal style={`--d:${(i % 3) * 0.08}s`}>
              <div class="relative flex h-40 items-center justify-center overflow-hidden rounded-[1.25rem] bg-[linear-gradient(160deg,#EAF8F9_0%,#FFFFFF_100%)] ring-1 ring-accent/10">
                <span class="font-display absolute left-4 top-3 text-sm italic text-coral">{String(i + 1).padStart(2, '0')}</span>
                <svg viewBox="0 0 120 90" class="h-32 w-auto text-accent transition-transform duration-700 group-hover:scale-105" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.art} />
              </div>
              <h3 class="mt-6 font-sans text-xl font-semibold tracking-tight">{p.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-slate-600">{p.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Orthodontic study (dark) -->
    <section class="relative isolate overflow-hidden bg-ocean text-white">
      <Waves fill="#FBF8F4" flip class="absolute inset-x-0 top-[-1px] z-10" />
      <Waves fill="#ffffff" class="absolute inset-x-0 bottom-[-1px] z-10" />
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <Bubbles count={10} seed={47} />
        <svg class="absolute inset-0 h-full w-full opacity-[0.07]"><defs><pattern id="orto-grid" width="64" height="64" patternUnits="userSpaceOnUse"><path d="M64 0H0V64" fill="none" stroke="#8FE3EA" stroke-width=".6" /></pattern></defs><rect width="100%" height="100%" fill="url(#orto-grid)" /></svg>
        <CoralBranch seed={144} color="duo" class="absolute -left-14 bottom-8 h-[190px] w-auto opacity-20" />
      </div>

      <div class="container-k pb-36 pt-32 md:pb-44 md:pt-40">
        <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-6">
            <SectionHeading eyebrow={t('ortodoncia.study.badge')} title={t('ortodoncia.study.title')} tone="dark" />

            <ul class="mt-10 space-y-4" data-reveal style="--d:.1s">
              <li class="flex gap-5 rounded-2xl border border-white/10 bg-white/[0.04] p-5">
                <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white text-accent">
                  <svg width="30" height="30" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 14V8a3 3 0 0 1 3-3h6M34 5h6a3 3 0 0 1 3 3v6M43 34v6a3 3 0 0 1-3 3h-6M14 43H8a3 3 0 0 1-3-3v-6" /><path d="M19 13c-2.6 0-4.7 2-4.7 5 0 3 1.5 4.6 2.1 7.8.5 2.9.9 6.4 2.9 6.4 1.9 0 1.9-3.3 2.7-5.6.3-1.1.9-1.7 1.6-1.7s1.3.6 1.6 1.7c.8 2.3.8 5.6 2.7 5.6 2 0 2.4-3.5 2.9-6.4.6-3.2 2.1-4.8 2.1-7.8 0-3-2.1-5-4.7-5-2 0-2.9 1-4.6 1S21 13 19 13Z" /><path d="M8 24h32" stroke="#F2617A" /></svg>
                </span>
                <div>
                  <h3 class="font-sans text-lg font-semibold tracking-tight text-white">{t('ortodoncia.study.tech.title')}</h3>
                  <p class="mt-1 text-white/70">{t('ortodoncia.study.tech.desc')}</p>
                </div>
              </li>
              <li class="flex gap-5 rounded-2xl border border-white/10 bg-white/[0.04] p-5">
                <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white text-accent">
                  <svg width="30" height="30" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 4c7 2 11 8 11 15l5 7.5-3.4 1.5.9 3.6-2.2 1 .4 3.6c0 2.6-2.4 3.6-5.6 3.1l-3.6-.6V44" /><circle cx="15" cy="22" r="3.4" stroke="#F2617A" /><path d="M15 25.4c0 5 1.6 8.4 5.5 10.2" stroke-opacity=".5" /><path d="M6 10v28" stroke-dasharray="2 4" stroke-opacity=".45" /></svg>
                </span>
                <div>
                  <h3 class="font-sans text-lg font-semibold tracking-tight text-white">{t('ortodoncia.study.harmony.title')}</h3>
                  <p class="mt-1 text-white/70">{t('ortodoncia.study.harmony.desc')}</p>
                </div>
              </li>
            </ul>

            <div class="mt-10" data-reveal style="--d:.15s">
              <a href="#appointment" class="btn btn-coral shine-effect">
                {t('ortodoncia.study.cta')}
                <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
            </div>
          </div>

          <div class="lg:col-span-6" data-reveal="right">
            <div class="rounded-[2rem] border border-white/10 bg-white/[0.05] p-6 backdrop-blur-xl md:p-9">
              <div class="relative overflow-hidden rounded-[1.5rem] bg-ocean-950/40 ring-1 ring-white/10" aria-hidden="true">
                <svg viewBox="0 0 400 430" class="mx-auto block h-auto w-full max-w-[420px]" fill="none" stroke-linecap="round" stroke-linejoin="round">
                  <defs>
                    <pattern id="orto-ceph-grid" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" stroke="#8FE3EA" stroke-opacity=".08" /></pattern>
                    <linearGradient id="orto-scan" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2CC5D2" stop-opacity="0" /><stop offset="1" stop-color="#2CC5D2" stop-opacity=".22" /></linearGradient>
                  </defs>
                  <rect width="400" height="430" fill="url(#orto-ceph-grid)" />
                  <rect y="236" width="400" height="34" fill="url(#orto-scan)" />
                  <path d="M0 270H400" stroke="#2CC5D2" stroke-opacity=".6" />
                  <!-- skeletal tracing -->
                  <g stroke="#FFFFFF" stroke-opacity=".32" stroke-width="1.3" stroke-dasharray="3 4">
                    <path d="M70 176C78 112 128 60 200 44C234 37 254 60 258 100C260 122 256 140 256 156" />
                    <path d="M256 156 282 196" />
                    <path d="M196 262 292 252C282 258 276 262 276 268C276 276 280 282 284 290" />
                    <path d="M150 214C146 250 148 300 160 336C186 362 226 384 266 392C280 388 288 376 286 362C284 350 272 342 272 332C272 322 276 314 282 306" />
                    <path d="M136 176C136 192 156 192 156 176" />
                  </g>
                  <g stroke="#FFFFFF" stroke-opacity=".55" stroke-width="1.4" fill="#0E2B45">
                    <rect x="204" y="264" width="30" height="21" rx="7" />
                    <rect x="204" y="289" width="30" height="20" rx="7" />
                    <path d="M274 262 292 304 284 304Z" fill="#D5F6F8" fill-opacity=".85" />
                    <path d="M268 336 288 300 280 298Z" fill="#D5F6F8" fill-opacity=".6" />
                  </g>
                  <!-- soft-tissue profile + cephalometric planes (drawn on reveal) -->
                  <path d="M236 22C254 52 270 92 274 130C275 142 270 152 270 160C284 186 312 214 330 232C333 238 328 244 318 246L298 254C302 264 308 272 306 282C304 290 296 293 294 297C300 301 304 307 302 315C300 325 288 331 286 339C292 353 302 365 300 379C296 397 280 405 262 407C242 409 222 407 206 414" stroke="#FF9AAA" stroke-width="2" pathLength="1" class="draw-me" />
                  <g stroke="#8FE3EA" stroke-width="1.4">
                    <path d="M146 182 256 156" pathLength="1" class="draw-me" style="--dd:.5s" />
                    <path d="M256 156 276 268" pathLength="1" class="draw-me" style="--dd:.7s" />
                    <path d="M256 156 272 332" pathLength="1" class="draw-me" style="--dd:.85s" />
                    <path d="M160 336 266 392" pathLength="1" class="draw-me" style="--dd:1s" />
                  </g>
                  <path d="M150 297 320 283" stroke="#F2617A" stroke-width="1.4" pathLength="1" class="draw-me" style="--dd:1.2s" />
                  <path d="M261.8 181.3A26 26 0 0 1 230.7 162" stroke="#F2617A" stroke-width="1.8" pathLength="1" class="draw-me" style="--dd:1.4s" />
                  {landmarks.map((l) => (
                    <g>
                      <circle cx={l.x} cy={l.y} r="4" fill="#0A1F33" stroke="#8FE3EA" stroke-width="1.6" />
                      <text x={l.x + l.dx} y={l.y + l.dy} fill="#8FE3EA" font-family="Inter, system-ui, sans-serif" font-size="11" font-weight="600" letter-spacing=".04em">{l.label}</text>
                    </g>
                  ))}
                  <g stroke="#8FE3EA" stroke-opacity=".7" stroke-width="1.6">
                    <path d="M14 34V14h20M366 14h20v20M386 396v20h-20M34 416H14v-20" />
                  </g>
                </svg>
              </div>

              <figure class="mt-8">
                <svg class="h-6 w-8 text-coral" viewBox="0 0 100 80" fill="currentColor" aria-hidden="true"><path d="M0 80V48C0 20 14 4 40 0l4 10C28 16 22 26 22 40h18v40Zm56 0V48C56 20 70 4 96 0l4 10C84 16 78 26 78 40h18v40Z" /></svg>
                <blockquote class="font-display mt-4 text-lg italic leading-relaxed text-white/85 md:text-xl">{unquote(t('ortodoncia.study.quote'))}</blockquote>
                <figcaption class="mt-4 text-[11px] font-semibold uppercase tracking-[0.2em] text-aqua-soft">{t('ortodoncia.study.team')}</figcaption>
              </figure>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Types of orthodontics -->
    <section class="section-y relative overflow-hidden bg-white">
      <div class="container-k">
        <SectionHeading eyebrow={t('ortodoncia.options.badge')} title={t('ortodoncia.options.title')} description={t('ortodoncia.options.subtitle')} split />

        <div class="mt-14 grid gap-6 md:grid-cols-2">
          {options.map((o, i) => (
            <article class="surface-card glow-border group flex flex-col overflow-hidden !rounded-[2rem]" data-reveal style={`--d:${i * 0.1}s`}>
              <div class:list={['relative px-6 pt-8 md:px-10', o.key === 'aligner' ? 'bg-[linear-gradient(160deg,#D5F6F8_0%,#F3FCFC_55%,#FFFFFF_100%)]' : 'bg-[linear-gradient(160deg,#FFE4E8_0%,#FBF8F4_55%,#FFFFFF_100%)]']} aria-hidden="true">
                <span class="font-display absolute left-6 top-5 text-sm italic text-coral md:left-10">{String(i + 1).padStart(2, '0')}</span>
                <svg viewBox="0 0 360 200" class="mx-auto block h-auto w-full max-w-[400px] transition-transform duration-700 group-hover:-translate-y-1" fill="none" stroke-linecap="round" stroke-linejoin="round">
                  <defs>
                    <linearGradient id={`orto-opt-enamel-${o.key}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFFFFF" /><stop offset="1" stop-color="#EDF5F6" /></linearGradient>
                    <linearGradient id={`orto-opt-gum-${o.key}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFD3DA" stop-opacity=".3" /><stop offset=".6" stop-color="#F9B6C2" /><stop offset="1" stop-color="#F49AAA" /></linearGradient>
                    <linearGradient id={`orto-metal-${o.key}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F2F5F8" /><stop offset="1" stop-color="#8D9DAB" /></linearGradient>
                  </defs>
                  <ellipse cx="180" cy="186" rx="130" ry="7" fill="#0A1F33" fill-opacity=".06" />
                  <g transform="translate(180 72)">
                    {arch.map((a) => (
                      <path d={a.d} transform={`translate(${a.x} ${a.y}) scale(${a.s})`} fill={`url(#orto-opt-enamel-${o.key})`} stroke="#0A1F33" stroke-opacity=".22" stroke-width="1.4" vector-effect="non-scaling-stroke" />
                    ))}
                    <path d={GUM} fill={`url(#orto-opt-gum-${o.key})`} />
                    <path d={GUM_EDGE} stroke="#F2617A" stroke-opacity=".6" stroke-width="1.4" />
                    {o.key === 'aligner' ? (
                      <>
                        {arch.map((a) => (
                          <path d={a.d} transform={`translate(${a.x} ${a.y + 3}) scale(${a.s * 1.07})`} fill="#2CC5D2" fill-opacity=".16" stroke="#0B7C86" stroke-opacity=".7" stroke-width="1.5" vector-effect="non-scaling-stroke" />
                        ))}
                        <path d={GUM_EDGE} transform="translate(0 4)" stroke="#0B7C86" stroke-opacity=".6" stroke-width="1.3" stroke-dasharray="3 3" />
                        <path d="M0 104V86M-6 92l6-6 6 6" stroke="#F2617A" stroke-width="2.2" />
                        <path d="M118 -24l2.4 6.6 6.6 2.4-6.6 2.4-2.4 6.6-2.4-6.6-6.6-2.4 6.6-2.4Z" fill="#2CC5D2" class="animate-twinkle" />
                        <path d="M-128 82l1.6 4.4 4.4 1.6-4.4 1.6-1.6 4.4-1.6-4.4-4.4-1.6 4.4-1.6Z" fill="#F2617A" class="animate-twinkle" style="animation-delay:-1.4s" />
                      </>
                    ) : (
                      <>
                        <path d="M-126 31Q0 43 126 31" stroke="#0A1F33" stroke-opacity=".25" stroke-width="3.4" transform="translate(0 1.2)" />
                        <path d="M-126 31Q0 43 126 31" stroke="#5E7183" stroke-width="2.2" />
                        {brackets.map((b, j) => (
                          <g transform={`translate(${b.x} ${b.y})`}>
                            <rect x="-9" y="-8" width="18" height="16" rx="3.5" fill={`url(#orto-metal-${o.key})`} stroke="#0A1F33" stroke-opacity=".35" />
                            <path d="M-9 0h18" stroke="#0A1F33" stroke-opacity=".4" />
                            <path d="M-3.5-8v16M3.5-8v16" stroke="#0A1F33" stroke-opacity=".18" />
                            {(j === 2 || j === 3) && <rect x="-11.5" y="-10.5" width="23" height="21" rx="6" stroke="#F2617A" stroke-width="2" />}
                          </g>
                        ))}
                      </>
                    )}
                  </g>
                </svg>
              </div>

              <div class="flex flex-1 flex-col p-7 md:p-10">
                <h3 class="text-2xl text-ocean-900 md:text-[1.75rem]">{o.title}</h3>
                <p class="mt-3 text-[15px] leading-relaxed text-slate-600 md:text-base">{o.desc}</p>
                {o.key === 'brackets' && (
                  <ul class="mt-5 flex flex-wrap gap-2">
                    {finishes.map((f) => (
                      <li class="inline-flex items-center gap-2 rounded-full border border-ocean-900/10 bg-white px-3 py-1.5 text-xs font-medium text-slate-600">
                        <span class="h-3.5 w-3.5 rounded-[4px] ring-1 ring-ocean-900/15" style={`background:linear-gradient(135deg,${f.from},${f.to})`} aria-hidden="true"></span>
                        {f.label}
                      </li>
                    ))}
                  </ul>
                )}
                <div class="mt-auto pt-7">
                  <p class="flex gap-3 rounded-2xl bg-sand p-5 text-[15px] leading-relaxed text-slate-700">
                    <svg class="mt-0.5 shrink-0 text-accent" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="m7.8 12.3 2.8 2.8 5.6-5.8" stroke="#F2617A" /></svg>
                    <span>{o.advantage.label && <strong class="font-semibold text-ocean-900">{o.advantage.label}: </strong>}{o.advantage.text}</span>
                  </p>
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- Contextual internal links -->
        <div class="mt-14" data-reveal>
          <p class="eyebrow">{copy.goodToKnow}</p>
          <div class="mt-6 grid gap-4 md:grid-cols-3">
            {tips.map((tip, i) => (
              <a href={tip.href} class="group flex items-start gap-4 rounded-[1.5rem] border border-ocean-900/[0.07] bg-sand/70 p-6 transition-all duration-500 hover:-translate-y-1 hover:border-accent/25 hover:bg-white hover:shadow-[var(--shadow-soft)]" data-reveal style={`--d:${i * 0.08}s`}>
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white text-accent ring-1 ring-accent/10">
                  {tip.icon ? (
                    <TreatmentIcon name={tip.icon} size={28} strokeWidth={1.8} />
                  ) : (
                    <svg width="28" height="28" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="24" cy="24" r="18" /><path d="M30.5 16.6a9.5 9.5 0 1 0 0 14.8" /><path d="M13 21.5h12M13 26.5h12" stroke="#F2617A" /></svg>
                  )}
                </span>
                <span>
                  <span class="block text-[15px] leading-relaxed text-slate-600">{tip.text}</span>
                  <span class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-accent">
                    {tip.label}
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                  </span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <div class="bg-white pb-10 md:pb-14">
      <CtaBand />
    </div>

    <FaqSection eyebrow={t('ortodoncia.faq.badge')} title={t('ortodoncia.faq.title')} faqs={faqs} />

    <RelatedTreatments current="ortodoncia" />

    <Contact />
  </main>

  <FooterInfo />
</Layout>
