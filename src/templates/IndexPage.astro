---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import MainSections from '../components/MainSections.astro';
import Treatments from '../components/Treatments.astro';
import Process from '../components/Process.astro';
import Team from '../components/Team.astro';
import Reviews from '../components/Reviews.astro';
import AreasServed from '../components/AreasServed.astro';
import Contact from '../components/Contact.astro';
import FooterInfo from '../components/FooterInfo.astro';
import { useTranslations } from '../i18n/utils';
import { pathFor, absoluteUrl, HTML_LANG, SITE_URL, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const url = absoluteUrl(pathFor('home', lang));

const pageSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${url}#webpage`,
  url,
  name: t('home.meta.title'),
  description: t('home.meta.description'),
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#dentist` },
  primaryImageOfPage: absoluteUrl('/og/clinica-dental-koral-vera.jpg'),
  inLanguage: HTML_LANG[lang],
});
---

<Layout title={t('home.meta.title')} description={t('home.meta.description')} lang={lang} schema={pageSchema}>
  <Navigation />
  <main id="main">
    <MainSections />
    <Treatments />
    <Process />
    <Team />
    <Reviews />
    <AreasServed />
    <Contact />
  </main>
  <FooterInfo />
</Layout>
