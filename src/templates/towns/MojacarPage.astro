const U = { min: pueblo.min, km: num(pueblo.km) };
const diff = pueblo.min - playa.min;

/** In-body link with descriptive anchor text. */
const a = (key: RouteKey, text: string) => `<a class="prose-link" href="${pathFor(key, lang)}">${text}</a>`;

/** Road codes never wrap at the hyphen. */
const nb = (road: string) => road.replace('-', '‑');

/** "la AL-6113, la A-1203 y la A-352" in the page language. */
const roadList = (roads: string[]) => {
  const each = { es: 'la ', en: '', de: '', nl: '', fr: 'l’' }[lang];
  const and = { es: ' y ', en: ' and ', de: ' und ', nl: ' en ', fr: ' et ' }[lang];
  const items = roads.map((r) => `${each}${nb(r)}`);
  return items.length > 1 ? `${items.slice(0, -1).join(', ')}${and}${items[items.length - 1]}` : items[0];
};
const U_ROADS = roadList(pueblo.roads);
const P_FIRST = nb(playa.roads[0]);
const P_REST = roadList(playa.roads.slice(1));

