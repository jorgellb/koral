      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div class="absolute -right-40 -top-40 h-[640px] w-[640px] rounded-full bg-[radial-gradient(circle,rgba(255,206,140,0.45)_0%,transparent_62%)]"></div>
        <div class="absolute -bottom-24 -left-32 h-[420px] w-[420px] rounded-full bg-[radial-gradient(circle,rgba(44,197,210,0.14)_0%,transparent_65%)]"></div>
      </div>

      <div class="container-k relative">
        <div class="grid items-end gap-6 lg:grid-cols-12 lg:gap-10">
          <div class="pb-4 lg:col-span-6 lg:pb-28">
            <div data-reveal><Breadcrumbs items={[{ label: t('areas.nav'), href: pathFor('areas', lang) }, { label: town.name }]} tone="light" class="mb-8" /></div>
            <p class="eyebrow mb-6 !text-[#1D4E89]" data-reveal style="--d:.05s">{copy.eyebrow}</p>
            <h1 class="text-[2.5rem] leading-[1.03] text-ocean-900 sm:text-6xl lg:text-[4.1rem] xl:text-[4.6rem]" data-reveal style="--d:.1s">
              {copy.h1}
              <span class="mt-1 block font-display text-[0.62em] font-normal italic leading-[1.1] text-[#1D4E89]">{copy.h1Accent}</span>
            </h1>
            <p class="mt-7 max-w-xl text-lg leading-relaxed text-slate-600 md:text-[1.2rem]" data-reveal style="--d:.2s">{copy.lead}</p>
            <ul class="mt-7 flex flex-wrap gap-2.5" data-reveal style="--d:.26s">
              {[...copy.chips, t('trust.7')].map((c) => (
                <li class="inline-flex items-center gap-2 rounded-full border border-[#1D4E89]/15 bg-white/70 px-4 py-2 text-sm font-medium text-ocean-900 backdrop-blur">
                  <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3.2" fill="#F5A46B" /><path d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1" stroke="#F5A46B" stroke-width="1.3" stroke-linecap="round" /></svg>
                  {c}
                </li>
              ))}
            </ul>
            <div class="mt-9 flex flex-col gap-3 sm:flex-row" data-reveal style="--d:.32s">
              <a href="#appointment" class="btn btn-coral shine-effect">
                {t('nav.appointment')}
                <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
              <a href="tel:+34950395319" class="btn btn-outline tabular">+34 950 39 53 19</a>
            </div>
          </div>
          <div class="relative -mx-5 sm:mx-0 lg:col-span-6">
            <MojacarVillage title={copy.imgTitle} seaLabel={t('areas.sea')} class="moj-hero-art" />
          </div>
        </div>
      </div>
    </section>

    <!-- Greeting band -->
    <div class="moj-band relative overflow-hidden bg-[#1D4E89] py-5 text-white" role="region" aria-label={copy.greetLabel}>
      <svg width="0" height="0" class="absolute" aria-hidden="true">
        <symbol id="moj-indalo" viewBox="0 0 20 24"><path d={indaloGlyph} fill="none" stroke="#FFC27A" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /><circle cx={indaloHead.cx} cy={indaloHead.cy} r={indaloHead.r} fill="#FFC27A" /></symbol>
      </svg>
      <div class="moj-marquee flex w-max">
        {[0, 1].map((copyIdx) => (
          <ul class="flex shrink-0 items-center" aria-hidden={copyIdx === 1 ? 'true' : undefined}>
            {[...GREETINGS, ...GREETINGS].map((g) => (
              <li class="moj-greet" lang={g.code}>
                <span class="font-display text-2xl italic md:text-3xl">{g.hello}</span>
                <span class="moj-code">{g.code}</span>
                <svg width="18" height="22" aria-hidden="true"><use href="#moj-indalo" /></svg>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>

    <!-- Intro: languages -->
    <section class="section-y relative overflow-hidden bg-white">
      <div class="container-k">
        <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-7">
            <p class="eyebrow mb-5" data-reveal>{copy.intro.eyebrow}</p>
            <h2 class="text-[2.2rem] leading-[1.06] sm:text-5xl lg:text-[3.3rem]" data-reveal>{copy.intro.title}</h2>
            <div class="mt-8 space-y-5 text-lg leading-relaxed text-slate-600" data-reveal style="--d:.1s">
              {copy.intro.paras.map((p) => <p set:html={p} />)}
            </div>
          </div>
          <ul class="grid gap-3 self-center lg:col-span-5">
            {greetings.map((g, i) => (
              <li
                lang={g.code}
                class:list={['moj-tile flex items-center gap-5 rounded-[1.4rem] border bg-white px-5 py-4', g.code === lang ? 'border-[#1D4E89]/40 shadow-[var(--shadow-card)]' : 'border-ocean-900/[0.07]']}
                data-reveal="right"
                style={`--d:${i * 0.07}s`}
              >
                <svg width="34" height="44" viewBox="0 0 34 44" aria-hidden="true" class="shrink-0">
                  <path d="M3 43V17a14 14 0 0 1 28 0v26Z" fill={g.code === lang ? '#1D4E89' : '#E8EFF6'} />
                  <path d="M17 6v37M3 26h28" stroke={g.code === lang ? '#FFFFFF' : '#1D4E89'} stroke-opacity=".35" />
                </svg>
                <span class="min-w-0 flex-1">
                  <span class="block font-display text-2xl leading-none text-ocean-900">{g.hello}</span>
                  <span class="mt-1.5 block text-[15px] text-slate-600">{g.line}</span>
                </span>
                {g.code === lang ? (
                  <span class="rounded-full bg-coral-pale px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-coral-deep" lang={lang}>{copy.intro.yours}</span>
                ) : (
                  <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-slate-400">{g.code}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Two routes -->
    <section class="section-y relative overflow-hidden bg-[#FBF6EE]">
      <div class="container-k">
        <div class="max-w-3xl" data-reveal>
          <p class="eyebrow mb-5">{copy.routes.eyebrow}</p>
          <h2 class="text-[2.2rem] leading-[1.06] sm:text-5xl lg:text-[3.3rem]">{copy.routes.title}</h2>
          <p class="mt-6 text-lg leading-relaxed text-slate-600">{copy.routes.desc}</p>
        </div>

        <div class="mt-14 grid gap-6 lg:grid-cols-12 lg:items-start">
          <div class="overflow-hidden rounded-[2rem] bg-white p-2 shadow-[var(--shadow-card)] ring-1 ring-ocean-900/5 lg:sticky lg:top-28 lg:col-span-7" data-reveal="scale">
            <div class="overflow-hidden rounded-[1.6rem]"><TownRouteMap town="mojacar" tone="light" seaLabel={t('areas.sea')} /></div>
          </div>
          <div class="grid gap-5 lg:col-span-5">
            {routeCards.map((c, i) => (
              <article class:list={['relative rounded-[1.75rem] border bg-white p-7', c.fastest ? 'border-[#1D4E89]/25 shadow-[var(--shadow-card)]' : 'border-ocean-900/[0.07]']} data-reveal style={`--d:${i * 0.1}s`}>
                <div class="flex items-start justify-between gap-4">
                  <h3 class="font-sans text-lg font-semibold tracking-tight text-ocean-900">{c.name}</h3>
                  {c.fastest && <span class="shrink-0 rounded-full bg-[#1D4E89] px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.12em] text-white">{copy.routes.fastest}</span>}
                </div>
                <p class="mt-4 flex items-baseline gap-3">
                  <span class="font-display text-6xl leading-none text-[#1D4E89] tabular" data-count={String(c.route.min)}>{c.route.min}</span>
                  <span class="text-lg font-semibold text-ocean-900">min</span>
                  <span class="text-slate-400">·</span>
                  <span class="text-lg text-slate-600 tabular">{num(c.route.km)} km</span>
                </p>
                <ol class="mt-5 flex flex-wrap items-center gap-1.5" aria-label={c.route.roads.join(', ')}>
                  {c.route.roads.map((r, j) => (
                    <li class="flex items-center gap-1.5">
                      <span class="rounded-md border border-[#1D4E89]/20 bg-[#EEF3F9] px-2 py-1 text-[12px] font-bold tracking-wide text-[#1D4E89] tabular">{r}</span>
                      {j < c.route.roads.length - 1 && <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" class="text-coral"><path d="M4 2.5 7.5 6 4 9.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>}
                    </li>
                  ))}
                </ol>
                <p class="mt-5 text-[15px] leading-relaxed text-slate-600">{c.text}</p>
                <a href={mapsUrl(c.route.from)} target="_blank" rel="noopener" class="link-u mt-4 inline-block text-sm font-semibold text-accent">{copy.routes.maps} ↗</a>
              </article>
            ))}
            <p class="px-2 text-[13px] text-slate-500" data-reveal>{copy.routes.note}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Cosmetic dentistry -->
    <section class="section-y relative overflow-hidden bg-white">
      <svg class="pointer-events-none absolute -right-24 -top-24 hidden h-[420px] w-[420px] opacity-60 md:block" viewBox="0 0 420 420" fill="none" aria-hidden="true">
        {[90, 130, 170, 210].map((r, i) => <circle cx="300" cy="120" r={r} stroke="#FFC27A" stroke-opacity={0.5 - i * 0.1} stroke-dasharray={i % 2 ? '2 8' : undefined} />)}
        <circle cx="300" cy="120" r="46" fill="#FFE3A8" fill-opacity=".5" />
      </svg>
      <div class="container-k relative">
        <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5">
            <p class="eyebrow mb-5" data-reveal>{copy.smile.eyebrow}</p>
            <h2 class="text-[2.2rem] leading-[1.06] sm:text-5xl lg:text-[3.3rem]" data-reveal>{copy.smile.title}</h2>
            <p class="mt-6 text-lg leading-relaxed text-slate-600" data-reveal>{copy.smile.desc}</p>
            <figure class="mt-10 flex items-center gap-5 rounded-[1.75rem] bg-[#FBF6EE] p-5" data-reveal style="--d:.1s">
              <Picture src="/equipo/Ana-padilla.jpg" alt={copy.smile.photoAlt} width={600} height={600} class="h-24 w-24 shrink-0 rounded-full object-cover ring-4 ring-white" />
              <figcaption class="text-[15px] leading-relaxed text-slate-600" set:html={copy.smile.doctor} />
            </figure>
          </div>
          <ul class="grid gap-5 sm:grid-cols-2 lg:col-span-7">
            {copy.smile.cards.map(([key, title, text, link], i) => (
              <li class="surface-card group flex flex-col p-7" data-reveal style={`--d:${i * 0.08}s`}>
                <span class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl bg-[#FFF2DE] text-[#1D4E89]"><TreatmentIcon name={key} size={26} strokeWidth={1.6} /></span>
                <h3 class="font-sans text-xl font-semibold tracking-tight text-ocean-900">{title}</h3>
                <p class="mt-2 flex-1 text-[15px] leading-relaxed text-slate-600">{text}</p>
                <a href={pathFor(key, lang)} class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-accent">
                  <span class="link-u">{link}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Implants for residents (deep blue) -->
    <section class="moj-dark relative isolate overflow-hidden bg-[linear-gradient(160deg,#1D4E89_0%,#153A68_100%)] text-white">
      <svg class="pointer-events-none absolute -bottom-10 right-[-60px] -z-10 h-[360px] w-auto opacity-[0.08] md:h-[460px]" viewBox="0 0 20 24" fill="none" stroke="#fff" stroke-width=".35" stroke-linecap="round" aria-hidden="true"><path d={indaloGlyph} /><circle cx={indaloHead.cx} cy={indaloHead.cy} r={indaloHead.r} /></svg>
      <div class="container-k section-y">
        <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-6">
            <p class="eyebrow eyebrow-light mb-5" data-reveal>{copy.implants.eyebrow}</p>
            <h2 class="text-[2.2rem] leading-[1.06] text-white sm:text-5xl lg:text-[3.3rem]" data-reveal>{copy.implants.title}</h2>
            <div class="mt-8 space-y-5 text-lg leading-relaxed text-white/80" data-reveal style="--d:.1s">
              {copy.implants.paras.map((p) => <p set:html={p} />)}
            </div>
          </div>
          <ol class="grid gap-4 self-center lg:col-span-6">
            {copy.implants.steps.map(([title, text], i) => (
              <li class="flex gap-5 rounded-[1.5rem] border border-white/12 bg-white/[0.06] p-5 backdrop-blur-sm" data-reveal="right" style={`--d:${i * 0.08}s`}>
                <svg width="46" height="46" viewBox="0 0 46 46" class="shrink-0" aria-hidden="true">
                  <path d="M23 4 41 13v20L23 42 5 33V13Z" fill="#fff" fill-opacity=".1" />
                  <path d="M5 13 23 22 41 13 23 4Z" fill="#fff" />
                  <path d="M23 22v20L41 33V13Z" fill="#fff" fill-opacity=".35" />
                  <text x="15" y="35" font-family="Fraunces, Georgia, serif" font-size="15" font-style="italic" fill="#fff">{i + 1}</text>
                </svg>
                <div>
                  <h3 class="font-sans text-lg font-semibold tracking-tight text-white">{title}</h3>
                  <p class="mt-1 text-[15px] leading-relaxed text-white/70">{text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Best clinic near Mojácar: concrete reasons + hours -->
    <section class="section-y relative overflow-hidden bg-white">
      <div class="container-k">
        <div class="max-w-3xl" data-reveal>
          <p class="eyebrow mb-5">{copy.best.eyebrow}</p>
          <h2 class="text-[2.2rem] leading-[1.06] sm:text-5xl lg:text-[3.3rem]">{copy.best.title}</h2>
          <p class="mt-6 text-lg leading-relaxed text-slate-600">{copy.best.desc}</p>
        </div>
        <div class="mt-14 grid gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-7">
          <ul class="grid content-start gap-x-10 gap-y-9 sm:grid-cols-2">
            {copy.best.reasons.map(([title, text], i) => (
              <li class="relative pl-12" data-reveal style={`--d:${(i % 2) * 0.08}s`}>
                <svg width="30" height="32" viewBox="0 0 20 24" fill="none" stroke="#1D4E89" stroke-width="1.3" stroke-linecap="round" class="absolute left-0 top-0.5" aria-hidden="true"><path d={indaloGlyph} /><circle cx={indaloHead.cx} cy={indaloHead.cy} r={indaloHead.r} fill="#F2617A" stroke="none" /></svg>
                <h3 class="font-sans text-lg font-semibold tracking-tight text-ocean-900">{title}</h3>
                <p class="mt-1.5 text-[15px] leading-relaxed text-slate-600" set:html={text} />
              </li>
            ))}
          </ul>
          <div class="mt-12 flex flex-col gap-3 border-t border-ocean-900/[0.07] pt-10 sm:flex-row sm:items-center" data-reveal>
            <a href="#appointment" class="btn btn-coral shine-effect">
              {t('nav.appointment')}
              <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <a href="https://wa.me/34634683639" target="_blank" rel="noopener" class="btn btn-outline">WhatsApp · +34 634 68 36 39</a>
          </div>
          </div>
          <div class="rounded-[2rem] border border-ocean-900/[0.07] bg-[#FBF6EE] p-7 md:p-8 lg:col-span-5" data-reveal="scale">
            <h3 class="text-3xl text-ocean-900">{copy.best.hoursTitle}</h3>
            <svg viewBox="0 0 340 212" class="mt-5 w-full" role="img" aria-labelledby="moj-hours-t">
              <title id="moj-hours-t">{copy.best.hoursSvg}</title>
              <path d={`M${SC.x - 24} ${SC.y}a24 24 0 0 1 48 0Z`} fill="#FFC27A" />
              <g fill="none" stroke-linecap="round" stroke-width="10">
                {radii.map((r) => <path d={arc(r, 8, 20)} stroke="#0A1F33" stroke-opacity=".06" />)}
              </g>
              <g class="draw" fill="none" stroke-linecap="round" stroke-width="10">
                {radii.map((r, i) => <path d={arc(r, HOURS[i][0], HOURS[i][1])} stroke={i === 0 ? '#F2617A' : '#1D4E89'} pathLength="1" style={`--dd:${0.2 + i * 0.12}s`} />)}
              </g>
              <path d={`M${SC.x - radii[0] - 14} ${SC.y + 1}H${SC.x + radii[0] + 14}`} stroke="#0A1F33" stroke-opacity=".15" />
              <g font-family="Inter, system-ui, sans-serif" font-size="11" font-weight="600" fill="#64748B" text-anchor="middle">
                <text x={SC.x - radii[0]} y={SC.y + 20}>8:00</text>
                <text x={SC.x} y={SC.y - radii[0] - 14}>14:00</text>
                <text x={SC.x + radii[0]} y={SC.y + 20}>20:00</text>
              </g>
            </svg>
            <dl class="mt-6 divide-y divide-ocean-900/[0.07] text-[15px]">
              {copy.best.days.map((d, i) => (
                <div class="flex items-center justify-between py-2.5">
                  <dt class="flex items-center gap-2.5 font-medium text-ocean-900"><span class:list={['h-2.5 w-2.5 rounded-full', i === 0 ? 'bg-coral' : 'bg-[#1D4E89]']}></span>{d}</dt>
                  <dd class="tabular text-slate-600">{hhmm(HOURS[i][0])} – {hhmm(HOURS[i][1])}</dd>
                </div>
              ))}
            </dl>
            <p class="mt-6 text-[14px] leading-relaxed text-slate-600" set:html={copy.best.hoursNote} />
          </div>
        </div>
      </div>
    </section>

    <FaqSection eyebrow="FAQ" title={copy.faqTitle} faqs={copy.faqs.map(([question, answer]) => ({ question, answer }))} />

    <TownNearby current="mojacar" />

    <Contact />
  </main>
  <FooterInfo />
</Layout>

<style is:global>
  /* Light hero: the transparent header switches to dark text on this page only */
  body:has(.moj-hero) .site-header[data-solid='false']:not([data-menu='true']) { color: var(--color-ocean-900); }
  body:has(.moj-hero) .site-header[data-solid='false']:not([data-menu='true']) .logo-img { filter: none; }

  .moj-hero { background: linear-gradient(180deg, #fffaf2 0%, #fbf3e6 55%, #f6ead9 100%); }
  .moj-hero-art {
    margin-bottom: -1px;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 9%, #000 91%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 9%, #000 91%, transparent 100%);
  }

  .moj-greet { display: flex; align-items: center; gap: 0.75rem; padding-inline: 1.5rem; }
  .moj-greet svg { margin-left: 1.5rem; }
  .moj-code { font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255, 255, 255, 0.55); }
  .moj-marquee { animation: moj-marquee 30s linear infinite; }
  .moj-band:hover .moj-marquee { animation-play-state: paused; }
  @keyframes moj-marquee { to { transform: translateX(-50%); } }

  .moj-tile { transition: transform 0.5s var(--ease-out-expo), box-shadow 0.5s var(--ease-out-expo); }
  .moj-tile:hover { transform: translateX(-4px); }

  .moj-dark .prose-link { color: #fff; text-decoration-color: rgba(255, 194, 122, 0.7); }
  .moj-dark .prose-link:hover { text-decoration-color: #ffc27a; }

  @media (prefers-reduced-motion: reduce) {
    .moj-marquee { animation: none; }
  }
</style>
