const arcPt = (r: number, h: number) => {
  const th = Math.PI * (1 - (h - 8) / 12);
  return `${(SC.x + r * Math.cos(th)).toFixed(1)} ${(SC.y - r * Math.sin(th)).toFixed(1)}`;
};
const arc = (r: number, h0: number, h1: number) => `M${arcPt(r, h0)}A${r} ${r} 0 0 1 ${arcPt(r, h1)}`;
