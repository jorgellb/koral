const title = copy.metaTitle;
const description = copy.metaDesc;
const serviceName = fill(t('areas.dentist.in'), { town: town.name });
const schema = townSchema({ town: 'turre', lang, title, description, serviceName });

const teamPhotos = ['/equipo/Ana-padilla.jpg', '/equipo/ana-soler.jpg', '/equipo/angeles-parrar.jpg'];

// Decorative contour rings for section backgrounds (organic, never crossing)
const heroRings = contourRings(180, 260, 9, 40, 34, 1.7);
const ctaRings = contourRings(980, 120, 8, 30, 30, 4.2);
const legendRings = contourRings(100, 100, 5, 20, 16, 1.9);
// Waypoint trail (desktop): gently climbing and descending line through 4 stops
const trailD = 'M0 64C12 62 18 60 24 60C130 60 226 34 332 34C438 34 534 70 640 70C746 70 842 40 948 40C1040 40 1120 56 1200 62';
---

<Layout title={title} description={description} lang={lang} schema={schema}>
  <Navigation />

  <main id="main">
    <!-- Hero: topographic sheet -->
    <section class="tur-hero relative isolate overflow-hidden pb-20 pt-32 text-white md:pb-28 md:pt-40 lg:pt-44">
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <svg class="absolute -left-40 top-10 h-[620px] w-[900px] opacity-[0.09]" viewBox="0 0 400 520" fill="none">
          {heroRings.map((d, i) => <path d={d} stroke={i % 4 === 0 ? '#C9D8B6' : '#8FA98A'} stroke-width={i % 4 === 0 ? 1.4 : 0.8} />)}
        </svg>
        <div class="absolute -right-40 -top-40 h-[620px] w-[620px] rounded-full bg-[radial-gradient(circle,rgba(143,169,138,0.18)_0%,transparent_65%)]"></div>
        <div class="absolute -bottom-40 left-1/4 h-[480px] w-[480px] rounded-full bg-[radial-gradient(circle,rgba(44,197,210,0.12)_0%,transparent_65%)]"></div>
      </div>

      <div class="container-k relative">
        <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-14">
          <div class="lg:col-span-6">
            <div data-reveal><Breadcrumbs items={[{ label: t('areas.nav'), href: pathFor('areas', lang) }, { label: town.name }]} class="mb-8" /></div>

            <p class="tur-kicker mb-7 inline-flex items-center gap-3 rounded-full border border-[#B5C9A8]/30 bg-white/[0.04] py-2 pl-2 pr-4 text-[11px] font-semibold uppercase tracking-[0.2em] text-[#C9D8B6]" data-reveal style="--d:.05s">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 18c3-1 4-5 9-5s6 4 9 5" /><path d="M6 14.5c2-1 3-4.5 6-4.5s4 3.5 6 4.5" /><path d="M9 11c1-1 1.6-3 3-3s2 2 3 3" /></svg>
              {copy.kicker}
            </p>

            <h1 class="text-[2.55rem] leading-[1.03] text-white sm:text-6xl lg:text-[4.1rem] xl:text-[4.6rem]" data-reveal style="--d:.1s">
              {copy.h1}
              <span class="accent-italic mt-2 block text-[0.62em] leading-[1.1] text-[#C9D8B6]">{copy.h1Accent}</span>
            </h1>

            <p class="mt-7 max-w-xl text-lg leading-relaxed text-white/75 md:text-xl [&_strong]:font-semibold [&_strong]:text-white" data-reveal style="--d:.2s" set:html={copy.lead} />

            <ul class="mt-8 flex flex-wrap gap-2.5" data-reveal style="--d:.26s">
              {copy.chips.map((c, i) => (
                <li class:list={['inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm', i === 0 ? 'tabular border-[#C9D8B6]/40 bg-[#C9D8B6]/10 font-semibold text-white' : 'border-white/12 bg-white/[0.05] text-white/85']}>
                  <span class:list={['h-1.5 w-1.5 rounded-full', i === 0 ? 'bg-coral' : 'bg-[#B5C9A8]']}></span>
                  {c}
                </li>
              ))}
            </ul>

            <div class="mt-10 flex flex-col gap-3 sm:flex-row" data-reveal style="--d:.32s">
              <a href="#appointment" class="btn btn-coral shine-effect">
                {t('nav.appointment')}
                <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
              <a href="tel:+34950395319" class="btn btn-ghost-light tabular">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" /></svg>
                +34 950 39 53 19
              </a>
            </div>
          </div>

          <div class="lg:col-span-6" data-reveal="scale" style="--d:.2s">
            <div class="tur-sheet relative mx-auto max-w-[540px] overflow-hidden rounded-[1.75rem] ring-1 ring-[#B5C9A8]/25 shadow-[var(--shadow-premium)]">
              <TurreTopo title={copy.mapTitle} sierraLabel={copy.sierra} seaLabel={t('areas.sea')} clinicNote={copy.clinicNote} lang={lang} />
            </div>
          </div>
        </div>
      </div>
      <svg class="absolute inset-x-0 bottom-[-1px] h-10 w-full md:h-14" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 60V34c160-22 300-30 460-14s300 30 470 8 320-30 510-6V60Z" fill="#ffffff" />
        <path d="M0 30c160-22 300-30 460-14s300 30 470 8 320-30 510-6" fill="none" stroke="#B5C9A8" stroke-opacity=".5" />
      </svg>
    </section>

    <!-- Route: sierra → sea → clinic -->
    <section class="section-y relative overflow-hidden bg-white">
      <div class="container-k">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5" data-reveal>
            <p class="eyebrow tur-eyebrow mb-5">{copy.routeEyebrow}</p>
            <h2 class="text-[2.2rem] leading-[1.07] sm:text-5xl lg:text-[3.2rem]">{copy.routeTitle}</h2>
          </div>
          <div class="space-y-5 text-[17px] leading-relaxed text-slate-600 lg:col-span-7 lg:pt-10" data-reveal style="--d:.08s">
            <p class="text-lg text-ocean-900" set:html={copy.routeIntro} />
            <p set:html={copy.routeP1} />
            <p set:html={copy.routeP2} />
          </div>
        </div>

        <figure class="tur-profile-card relative mt-14 rounded-[2rem] border border-[#4F6B3A]/12 bg-[#F6F8F2] p-4 md:mt-16 md:p-8" data-reveal>
          <div class="tur-scroll -mx-1 overflow-x-auto px-1 pb-2">
            <TurreProfile title={copy.profileTitle} labels={copy.profile} lang={lang} class="min-w-[720px] md:min-w-0" />
          </div>
          <figcaption class="mt-3 flex flex-col gap-1 border-t border-[#4F6B3A]/12 pt-4 text-[13px] text-slate-500 sm:flex-row sm:items-center sm:justify-between">
            <span>{copy.profileNote}</span>
            <span class="tur-hint font-semibold text-[#4F6B3A] md:hidden" aria-hidden="true">{copy.scrollHint} →</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- One plan, few trips -->
    <section class="tur-plan section-y relative overflow-hidden">
      <div class="container-k relative">
        <div class="max-w-3xl" data-reveal>
          <p class="eyebrow tur-eyebrow mb-5">{copy.planEyebrow}</p>
          <h2 class="text-[2.2rem] leading-[1.07] sm:text-5xl lg:text-[3.2rem]">{copy.planTitle}</h2>
          <p class="mt-6 text-lg leading-relaxed text-slate-600">{copy.planDesc}</p>
        </div>

        <div class="relative mt-16">
