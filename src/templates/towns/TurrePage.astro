    hoursTitle: 'Des horaires pour descendre de la sierra',
    hours: [['Lundi', '10 h – 20 h'], ['Mardi', '8 h – 16 h'], ['Mercredi', '10 h – 18 h'], ['Jeudi', '8 h – 16 h'], ['Vendredi', '8 h – 16 h']],
    trtEyebrow: 'Légende des traitements',
    trtTitle: 'Implants, réhabilitation et gencives pour les patients de Turre',
