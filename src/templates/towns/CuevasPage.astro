      ['Avez-vous un cabinet à Cuevas del Almanzora ?', `Non. La Clínica Dental Koral se trouve à Vera (Av. de Baria, 4), à environ ${min} minutes de Cuevas del Almanzora par l’${join(roads, 'et l’')}. Nous préférons être clairs : il n’y a pas d’antenne à Cuevas, mais le trajet est court et nous sommes ouverts le matin comme l’après-midi.`],
      ['Quel est le meilleur dentiste près de Cuevas del Almanzora pour les enfants ?', `Celui qui explique tout et met votre enfant en confiance. Chez Koral, les enfants sont suivis par la Dre Ana Soler, qui assure la ${to('odontopediatria', 'pédodontie')} et l’orthodontie : une seule personne accompagne leur croissance. La première visite est gratuite, vous pourrez juger par vous-même.`],
      ['Peut-on sauver une dent très douloureuse au lieu de l’arracher ?', `Souvent, oui. Si le problème se situe dans la pulpe, un traitement de canal au microscope avec la Dre Ángeles Parra peut conserver la dent naturelle. Tout dépend du diagnostic, confirmé par imagerie 3D si nécessaire. Plus d’informations sur la page ${to('endodoncia', 'endodontie')}.`],
      ['Combien coûte la première visite si je viens de Cuevas ?', `Rien : la première visite est gratuite. Nous examinons votre bouche, vous expliquons les options et vous remettons un devis détaillé. La plupart des traitements peuvent être réglés avec un financement à 0 % – voir ${to('pricing', 'tarifs et financement')}.`],
      ['Parlez-vous français ?', 'Oui. Nous recevons en espagnol, anglais, allemand, néerlandais et français, pour que vous puissiez décrire vos symptômes et comprendre votre traitement dans votre langue.'],
      ['Quels sont vos horaires pour les patients de Cuevas del Almanzora ?', `Lundi 10h00–20h00, mardi 8h00–16h00, mercredi 10h00–18h00, jeudi et vendredi 8h00–16h00. Prenez rendez-vous au +34 950 39 53 19, par WhatsApp au +34 634 68 36 39 ou via la ${to('contact', 'page de contact')}.`],
    ],
  },
} as const)[lang];

const title = copy.metaTitle;
const description = copy.metaDesc;
const schema = townSchema({ town: 'cuevas', lang, title, description, serviceName: fill(t('areas.dentist.in'), { town: town.name }) });
const crumbs = [{ label: t('areas.nav'), href: pathFor('areas', lang) }, { label: town.name }];
const fmtH = (h: number) => (lang === 'fr' ? `${h}h00` : `${h}:00`);

/* ---------- Hero landscape (viewBox 1440 × 600) ---------- */
const hill =
  'M500 600C590 560 680 486 760 424C840 362 900 312 960 272C1020 232 1062 206 1110 197L1340 191C1382 193 1412 204 1440 214L1440 600Z';
// Dipping strata inside the hill: each line also closes downwards so the bands stack.
const strataLines = Array.from({ length: 11 }, (_, i) => {
  const y = 214 + i * 36;
  return `M430 ${y + 34}C640 ${y + 8} 860 ${y + 44} 1080 ${y + 14}S1380 ${y - 18} 1500 ${y - 10}`;
});
const bandFills = ['#5B3E2F', '#4A3227', '#6E4834', '#3F2B23', '#7B5139', '#4D3429', '#60412F', '#3B2821', '#6A4535', '#47302A', '#563A2C'];
const strataStrokes = ['#D9A66B', '#E6D8C6', '#C0714F', '#2CC5D2', '#E6D8C6', '#D9A66B', '#F2617A', '#E6D8C6', '#C0714F', '#D9A66B', '#E6D8C6'];
// Cave houses: [x, y, lit window]
const houses: [number, number, boolean][] = [
  [700, 498, false], [782, 492, true], [866, 500, false], [952, 494, false], [1040, 500, true], [1130, 494, false], [1222, 500, false], [1318, 494, true],
  [846, 416, false], [930, 410, true], [1014, 418, false], [1104, 410, false], [1198, 418, true], [1296, 412, false],
  [968, 332, false], [1050, 326, false], [1142, 334, true], [1236, 328, false], [1338, 334, false],
  [1060, 250, true], [1370, 256, false],
];
const merlons = (x0: number, x1: number, y: number, step = 14, w = 8, h = 9) =>
  Array.from({ length: Math.floor((x1 - x0) / step) + 1 }, (_, i) => `M${x0 + i * step} ${y}h${w}v-${h}h-${w}Z`).join('');
const stars: [number, number, number][] = [[1000, 40, 1.4], [1060, 120, 1], [1180, 34, 1.2], [1290, 70, 1.6], [1400, 40, 1], [1390, 140, 1.2], [930, 150, 1], [1120, 70, 0.9]];

/* ---------- Strata → tooth morph (viewBox 800 × 520) ---------- */
type Pt = [number, number];
const r1 = (n: number) => Math.round(n * 10) / 10;
/** Closed Catmull-Rom spline: always N cubic segments, so shapes with N points can morph. */
const spline = (pts: Pt[]) => {
  const n = pts.length;
  let d = `M${r1(pts[0][0])} ${r1(pts[0][1])}`;
  for (let i = 0; i < n; i++) {
    const p0 = pts[(i - 1 + n) % n], p1 = pts[i], p2 = pts[(i + 1) % n], p3 = pts[(i + 2) % n];
    d += `C${r1(p1[0] + (p2[0] - p0[0]) / 6)} ${r1(p1[1] + (p2[1] - p0[1]) / 6)} ${r1(p2[0] - (p3[0] - p1[0]) / 6)} ${r1(p2[1] - (p3[1] - p1[1]) / 6)} ${r1(p2[0])} ${r1(p2[1])}`;
  }
  return `${d}Z`;
};
const band = (top: number, bottom: number, phase: number): Pt[] => {
  const xs = Array.from({ length: 12 }, (_, i) => -90 + i * (980 / 11));
  const wave = (x: number, a: number) => a * Math.sin(x / 120 + phase);
  return [...xs.map((x) => [x, top + wave(x, 9)] as Pt), ...xs.slice().reverse().map((x) => [x, bottom + wave(x + 60, 11)] as Pt)];
};
const toothOuter: Pt[] = [[285, 120], [300, 78], [335, 58], [370, 72], [400, 88], [430, 72], [465, 58], [500, 78], [515, 120], [520, 180], [505, 250], [495, 330], [485, 420], [465, 470], [445, 440], [432, 360], [400, 300], [368, 360], [355, 440], [335, 470], [315, 420], [305, 330], [295, 250], [280, 180]];
const toothDentin: Pt[] = [[303, 128], [316, 96], [340, 82], [370, 94], [400, 108], [430, 94], [460, 82], [484, 96], [497, 128], [500, 180], [500, 252], [491, 330], [481, 418], [464, 462], [448, 436], [436, 358], [400, 306], [364, 358], [352, 436], [336, 462], [319, 418], [309, 330], [300, 252], [300, 180]];
const toothPulp: Pt[] = [[346, 178], [350, 146], [362, 140], [376, 160], [400, 168], [424, 160], [438, 140], [450, 146], [454, 178], [457, 215], [452, 256], [461, 330], [463, 408], [459, 446], [453, 408], [448, 336], [400, 266], [352, 336], [347, 408], [341, 446], [337, 408], [339, 330], [348, 256], [343, 215]];
const morphLayers = [
  { strata: spline(band(64, 150, 0)), tooth: spline(toothOuter), fill: '#F6EFE6' },
  { strata: spline(band(160, 286, 1.3)), tooth: spline(toothDentin), fill: '#E0B27A' },
  { strata: spline(band(296, 444, 2.4)), tooth: spline(toothPulp), fill: '#F2617A' },
];
const strataLabelY = [112, 228, 376];
// Leader lines: [point on the layer, index of the layer name]
const toothLabels: { from: Pt; layer: number }[] = [
  { from: [508, 104], layer: 0 },
  { from: [442, 206], layer: 2 },
  { from: [482, 330], layer: 1 },
];

/* ---------- Descent levels ---------- */
const levelStyle = [
  { bg: '#F3ECE3', fg: '#0A1F33', icon: 'tooth' as const },
  { bg: '#EADBC4', fg: '#0A1F33', icon: 'odontopediatria' as const },
  { bg: '#DDB27C', fg: '#0A1F33', icon: 'ortodoncia' as const },
  { bg: '#F2617A', fg: '#0A1F33', icon: 'endodoncia' as const },
  { bg: '#7A4B39', fg: '#FFFFFF', icon: 'implantes' as const },
];
const doctorPhotos = ['/equipo/ana-soler.jpg', '/equipo/angeles-parrar.jpg', '/equipo/Ana-padilla.jpg'];
const doctorRoles = [t('role.ortho'), t('role.endo'), t('role.director')];
const mapsUrl = 'https://www.google.com/maps/dir/?api=1&origin=Cuevas+del+Almanzora,+Almer%C3%ADa&destination=Clinica+Dental+Koral+Vera+Almeria';
---

<Layout title={title} description={description} lang={lang} schema={schema}>
  <Navigation />
  <main id="main" class="cue-page">
    <!-- 1 · Hero: castle, cave houses and strata at dusk -->
    <section class="cue-hero relative isolate overflow-hidden text-white">
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div class="absolute -left-40 top-10 h-[520px] w-[520px] rounded-full bg-[radial-gradient(circle,rgba(44,197,210,0.14)_0%,transparent_65%)]"></div>
        <div class="absolute bottom-0 right-0 h-[600px] w-[760px] bg-[radial-gradient(50%_50%_at_60%_70%,rgba(217,166,107,0.22)_0%,transparent_70%)]"></div>
      </div>

      <div class="container-k relative z-10 pt-32 md:pt-44">
        <Breadcrumbs items={crumbs} />
        <div class="mt-8 max-w-[38rem]">
          <p class="eyebrow eyebrow-light" data-reveal>{copy.hero.eyebrow}</p>
          <h1 class="mt-5 text-[2.45rem] leading-[1.03] text-white sm:text-[3.4rem] lg:text-[4.1rem]" data-reveal style="--d:.06s">
            {copy.hero.h1}
            <span class="accent-italic block text-[#F3C9A0]">{copy.hero.accent}</span>
          </h1>
          <p class="mt-6 max-w-[34rem] text-[17px] leading-relaxed text-white/75 md:text-lg" data-reveal style="--d:.12s">{copy.hero.lead}</p>
          <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--d:.18s">
            <a href="#appointment" class="btn btn-coral">
              {t('nav.appointment')}
              <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <a href="tel:+34950395319" class="btn btn-ghost-light tabular">+34 950 39 53 19</a>
          </div>
          <ul class="mt-8 flex flex-wrap gap-2 text-[13px] font-medium text-white/80" data-reveal style="--d:.24s">
            <li class="rounded-full bg-white/[0.07] px-3.5 py-1.5 ring-1 ring-white/10 tabular">{fill(t('areas.drive'), { min, km })}</li>
            <li class="rounded-full bg-white/[0.07] px-3.5 py-1.5 ring-1 ring-white/10">{roads.join(' → ')}</li>
            <li class="rounded-full bg-white/[0.07] px-3.5 py-1.5 ring-1 ring-white/10">{t('trust.7')}</li>
          </ul>
          <p class="mt-5 text-[13px] text-white/50" data-reveal style="--d:.28s">{copy.hero.note}</p>
        </div>
      </div>

      <div class="cue-land relative mt-6 aspect-[390/330] sm:aspect-[1440/600] lg:-mt-[17vw]" data-reveal="fade">
        <svg viewBox="0 0 1440 600" preserveAspectRatio="xMaxYMax slice" class="absolute inset-0 h-full w-full" role="img" aria-labelledby="cue-hero-t">
          <title id="cue-hero-t">{copy.hero.svgTitle}</title>
          <defs>
            <linearGradient id="cue-stone" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#F3E6D3" />
              <stop offset="1" stop-color="#C9A47A" />
            </linearGradient>
            <linearGradient id="cue-ridge" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#8FE3EA" stop-opacity=".12" />
              <stop offset="1" stop-color="#8FE3EA" stop-opacity="0" />
            </linearGradient>
            <clipPath id="cue-hill-clip"><path d={hill} /></clipPath>
            <mask id="cue-moon">
              <rect width="1440" height="600" fill="#000" />
              <circle cx="1004" cy="92" r="22" fill="#fff" />
              <circle cx="1014" cy="84" r="19" fill="#000" />
            </mask>
            <radialGradient id="cue-moon-glow">
              <stop offset="0" stop-color="#F3E6D3" stop-opacity=".35" />
              <stop offset="1" stop-color="#F3E6D3" stop-opacity="0" />
            </radialGradient>
          </defs>

          <!-- Sky -->
          <g class="cue-stars" fill="#F3E6D3">
            {stars.map(([x, y, r]) => <circle cx={x} cy={y} r={r} />)}
          </g>
          <circle cx="1000" cy="92" r="70" fill="url(#cue-moon-glow)" />
          <rect width="1440" height="600" fill="#F3E6D3" mask="url(#cue-moon)" />

          <!-- Far ridge of the Sierra Almagrera -->
          <path d="M560 600C700 470 820 430 940 380C1060 330 1150 300 1240 290C1320 282 1390 286 1440 296L1440 600Z" fill="url(#cue-ridge)" />

          <!-- Hill with dipping strata -->
          <path d={hill} fill="#3A2820" />
          <g clip-path="url(#cue-hill-clip)">
            {strataLines.map((d, i) => <path d={`${d}L1500 700L430 700Z`} fill={bandFills[i]} />)}
            <g class="draw">
              {strataLines.map((d, i) => (
                <path d={d} fill="none" stroke={strataStrokes[i]} stroke-opacity={strataStrokes[i] === '#2CC5D2' || strataStrokes[i] === '#F2617A' ? 0.55 : 0.32} stroke-width={i % 3 === 0 ? 1.6 : 1} pathLength="1" style={`--dd:${0.2 + i * 0.12}s`} />
              ))}
            </g>
          </g>

          <!-- Cave houses: whitewashed fronts, arched doors, chimneys on the slope -->
          <g class="cue-houses">
            {houses.map(([x, y, lit], i) => (
              <g class="cue-house" style={`--hd:${0.5 + (i % 8) * 0.08}s`}>
                <rect x={x + 9} y={y - 27} width="7" height="17" rx="1.5" fill="#F6EFE6" />
                <rect x={x + 7} y={y - 30} width="11" height="4" rx="1" fill="#F6EFE6" />
                <rect x={x} y={y} width="46" height="31" rx="3" fill="#F6EFE6" fill-opacity=".93" />
                <path d={`M${x + 15} ${y + 31}v-13a7 7 0 0 1 14 0v13Z`} fill="#2A1D18" />
                <rect x={i % 2 ? x + 5 : x + 34} y={y + 9} width="7" height="8" rx="1" fill={lit ? '#F2B25C' : '#2A1D18'} />
              </g>
            ))}
          </g>

          <!-- Castillo del Marqués de los Vélez (silhouette) -->
          <g class="cue-castle">
            <path d="M1118 197V150H1330V197Z" fill="url(#cue-stone)" />
            <path d={merlons(1150, 1324, 150)} fill="url(#cue-stone)" />
            <path d="M1104 197V128H1146V197Z" fill="#E7D3B6" />
            <path d={merlons(1104, 1140, 128, 12, 7, 8)} fill="#E7D3B6" />
            <path d="M1186 197V88H1258V197Z" fill="url(#cue-stone)" />
            <path d={merlons(1186, 1252, 88, 12, 7, 10)} fill="url(#cue-stone)" />
            <path d="M1186 197V88H1206V197Z" fill="#000" fill-opacity=".12" />
            <rect x="1218" y="108" width="5" height="16" rx="2" fill="#2A1D18" />
            <rect x="1236" y="134" width="5" height="16" rx="2" fill="#2A1D18" />
            <rect x="1122" y="146" width="4" height="13" rx="2" fill="#2A1D18" />
            <path d="M1286 197v-22a10 10 0 0 1 20 0v22Z" fill="#2A1D18" />
          </g>

          <!-- Valley floor and the Almanzora river -->
          <path d="M0 548C240 532 470 566 720 548S1200 530 1440 552L1440 600L0 600Z" fill="#FBF8F4" />
          <path d="M0 574C300 562 520 584 760 572S1200 560 1440 576" fill="none" stroke="#2CC5D2" stroke-width="2.4" stroke-linecap="round" class="draw-me" pathLength="1" style="--dd:1s" />
          <text x="1410" y="596" text-anchor="end" font-family="Fraunces, Georgia, serif" font-style="italic" font-size="15" fill="#0B7C86">{copy.hero.river}</text>
        </svg>
      </div>
    </section>

    <!-- 2 · Intro: the town in layers + core sample of the route -->
    <section class="section-y relative overflow-hidden bg-sand !pt-12 md:!pt-16">
      <div class="container-k">
        <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-7">
            <p class="eyebrow" data-reveal>{copy.intro.eyebrow}</p>
            <h2 class="mt-5 text-[2.1rem] leading-tight md:text-[2.8rem]" data-reveal style="--d:.05s">{copy.intro.h2}</h2>
            <div class="mt-8 space-y-5 text-[17px] leading-relaxed text-slate-700">
              {copy.intro.paras.map((p, i) => <p data-reveal style={`--d:${0.08 + i * 0.05}s`} set:html={p} />)}
            </div>
          </div>
          <div class="lg:col-span-5">
            <figure class="cue-core mx-auto max-w-[23rem] lg:sticky lg:top-32" data-reveal="right">
              <figcaption class="mb-4 text-center text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">{copy.intro.coreTitle}</figcaption>
              <dl class="cue-core-body">
                {copy.intro.facts.map(([value, label], i) => (
                  <div class={`cue-core-band cue-core-${i}`}>
                    <dt class="order-2 text-[12px] font-semibold uppercase tracking-[0.18em] opacity-75">{label}</dt>
                    <dd class="font-display order-1 text-[1.9rem] leading-none tabular">{value}</dd>
                  </div>
                ))}
              </dl>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 · Strata → tooth morph -->
    <section class="cue-deep relative isolate overflow-hidden text-white">
      <svg class="pointer-events-none absolute inset-x-0 top-0 h-16 w-full md:h-24" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 0H1440V40C1180 70 900 22 640 48S200 72 0 44Z" fill="#FBF8F4" />
        <path d="M0 44C200 72 420 52 640 48S1180 70 1440 40V58C1180 86 900 40 640 66S200 90 0 62Z" fill="#E6D8C6" />
        <path d="M0 62C200 90 420 70 640 66S1180 86 1440 58V72C1180 98 900 56 640 80S200 100 0 76Z" fill="#B98A5C" />
        <path d="M0 76C200 100 420 82 640 80S1180 98 1440 72V82C1180 104 900 66 640 92S200 106 0 88Z" fill="#5B3E2F" />
      </svg>
      <div class="container-k relative pb-24 pt-32 md:pb-32 md:pt-40">
        <div class="mx-auto max-w-3xl text-center">
          <p class="eyebrow eyebrow-light" data-reveal>{copy.morph.eyebrow}</p>
          <h2 class="mt-5 text-[2.1rem] leading-tight text-white md:text-[2.9rem]" data-reveal style="--d:.05s">{copy.morph.h2}</h2>
          <p class="mt-6 text-[17px] leading-relaxed text-white/70" data-reveal style="--d:.1s">{copy.morph.lead}</p>
        </div>

        <figure class="cue-morph relative mx-auto mt-12 max-w-[860px]" data-cue-morph data-reveal="fade">
          <svg viewBox="0 0 800 520" class="block h-auto w-full rounded-[1.75rem]" role="img" aria-labelledby="cue-morph-t">
            <title id="cue-morph-t">{copy.morph.svgTitle}</title>
            <g class="cue-rock" stroke="#E6D8C6" stroke-opacity=".14" fill="none">
              {[30, 156, 291, 452, 500].map((y, i) => <path d={`M-20 ${y}C200 ${y - 14} 420 ${y + 16} 820 ${y - 6}`} stroke-dasharray={i % 2 ? '3 9' : undefined} />)}
              {Array.from({ length: 26 }, (_, i) => <circle cx={(i * 131) % 800} cy={40 + ((i * 197) % 440)} r={1 + (i % 3) * 0.6} fill="#E6D8C6" fill-opacity=".2" stroke="none" />)}
            </g>
            {morphLayers.map((l) => (
              <path d={l.strata} data-strata={l.strata} data-tooth={l.tooth} fill={l.fill}>
                <animate attributeName="d" dur="2.4s" begin="indefinite" fill="freeze" calcMode="spline" keyTimes="0;1" keySplines="0.65 0 0.25 1" values={`${l.strata};${l.tooth}`} />
              </path>
            ))}
            <g class="cue-strata-labels" font-family="Inter, system-ui, sans-serif" font-size="13" font-weight="600" letter-spacing="2">
              {copy.morph.strata.map((s, i) => (
                <text x="34" y={strataLabelY[i]} fill={i === 2 ? '#0A1F33' : '#0A1F33'} fill-opacity=".7">{s.toUpperCase()}</text>
              ))}
            </g>
            <g class="cue-tooth-labels" font-family="Fraunces, Georgia, serif" font-size="24" font-style="italic">
              {toothLabels.map((l) => (
                <g>
                  <path d={`M${l.from[0]} ${l.from[1]}H602`} stroke="#8FE3EA" stroke-opacity=".6" stroke-dasharray="2 5" />
                  <circle cx={l.from[0]} cy={l.from[1]} r="4" fill="#0A1F33" stroke="#8FE3EA" stroke-width="2" />
                  <text x="614" y={l.from[1] + 8} fill="#FFFFFF">{copy.morph.layers[l.layer][0]}</text>
                </g>
              ))}
            </g>
          </svg>
          <button type="button" class="cue-toggle btn btn-ghost-light mx-auto mt-6 flex !py-2.5 text-sm" data-cue-toggle aria-pressed="false" hidden>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.5-6.3L21 8M21 3v5h-5M21 12a9 9 0 0 1-15.5 6.3L3 16M3 21v-5h5" /></svg>
            <span class="cue-to-tooth">{copy.morph.toTooth}</span>
            <span class="cue-to-strata">{copy.morph.toStrata}</span>
          </button>
        </figure>

        <ul class="mt-14 grid gap-5 md:grid-cols-3">
          {copy.morph.layers.map(([name, text], i) => (
            <li class="rounded-[1.5rem] border border-white/10 bg-white/[0.04] p-7" data-reveal style={`--d:${i * 0.08}s`}>
              <span class="mb-5 block h-2 w-14 rounded-full" style={`background:${morphLayers[i].fill}`} aria-hidden="true"></span>
              <h3 class="text-2xl text-white">{name}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-white/65">{text}</p>
            </li>
          ))}
        </ul>
      </div>
      <svg class="pointer-events-none absolute inset-x-0 bottom-0 h-14 w-full md:h-20" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 60C260 30 520 84 820 56S1260 30 1440 52V100H0Z" fill="#FFFFFF" />
      </svg>
    </section>

    <!-- 4 · Descent: levels of care, surface to bone -->
    <section class="cue-descent section-y relative bg-white">
      <div class="container-k">
