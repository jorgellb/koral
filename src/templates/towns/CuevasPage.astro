<script>
  // Descent: the marker on the stratigraphic column follows the level being read.
  document.querySelectorAll<HTMLElement>('.cue-column').forEach((col) => {
    const section = col.closest('.cue-descent');
    if (!section) return;
    const levels = [...section.querySelectorAll<HTMLElement>('.cue-level')];
    const bands = [...col.querySelectorAll<HTMLElement>('.cue-column-bands span')];
    let queued = false;
    const update = () => {
      queued = false;
      const line = window.innerHeight * 0.45;
      let active = 0;
      levels.forEach((l, i) => {
        if (l.getBoundingClientRect().top < line) active = i;
      });
      const band = bands[active];
      if (!band) return;
      col.style.setProperty('--marker', `${band.offsetTop + band.offsetHeight / 2}px`);
      bands.forEach((b, i) => b.toggleAttribute('data-active', i === active));
    };
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    }, { passive: true });
    update();
  });

  // Strata → tooth morph (SMIL), started when the figure scrolls into view.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-cue-morph]').forEach((fig) => {
    const paths = [...fig.querySelectorAll<SVGPathElement>('path[data-strata]')];
    const button = fig.querySelector<HTMLButtonElement>('[data-cue-toggle]');
    let tooth = false;
    const show = (toTooth: boolean, animate: boolean) => {
      const wasTooth = tooth;
      tooth = toTooth;
      fig.classList.toggle('is-tooth', toTooth);
      button?.setAttribute('aria-pressed', String(toTooth));
      paths.forEach((p) => {
        const from = wasTooth ? p.dataset.tooth! : p.dataset.strata!;
        const target = toTooth ? p.dataset.tooth! : p.dataset.strata!;
        const anim = p.querySelector<SVGAnimateElement>('animate');
        if (!animate || !anim || typeof anim.beginElement !== 'function') {
          anim?.remove();
          p.setAttribute('d', target);
          return;
        }
        anim.setAttribute('values', `${from};${target}`);
        anim.beginElement();
      });
    };
    if (button) {
      button.hidden = false;
      button.addEventListener('click', () => show(!tooth, !reduce));
    }
    if (reduce || !('IntersectionObserver' in window)) {
      show(true, false);
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        window.setTimeout(() => !tooth && show(true, true), 450);
      },
      { threshold: 0.45 },
    );
    io.observe(fig);
  });
</script>

