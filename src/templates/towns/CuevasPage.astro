  /* Descent: stratigraphic column with a marker that follows the scroll */
  .cue-column { position: relative; padding-left: 1.75rem; }
  .cue-column-bands { display: flex; width: 100%; flex-direction: column; overflow: hidden; border-radius: 1.25rem; box-shadow: var(--shadow-soft); }
