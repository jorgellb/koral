              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <FaqSection eyebrow={copy.faqEyebrow} title={copy.faqTitle} faqs={faqs} />

    <TownNearby current="antas" />

    <Contact />
  </main>
  <FooterInfo />
</Layout>

