          </div>
          <p class="mt-9 text-[11px] font-semibold uppercase tracking-[0.2em] text-white/45" data-reveal>{copy.roadsLabel}</p>
          <ol class="mt-3 flex flex-wrap items-center gap-2" data-reveal style="--d:.15s">
