/** Turns [[routeKey|anchor]] into an internal link. */
const linkify = (s: string, cls = 'prose-link') =>
  s.replace(/\[\[(\w+)\|([^\]]+)\]\]/g, (_, k: string, txt: string) => `<a href="${pathFor(k as RouteKey, lang)}" class="${cls}">${txt}</a>`);

// Small line icons for the six "pieces" (40×40)
const ICONS = [
  'M20 4a16 16 0 1 0 0 32 16 16 0 1 0 0-32M4 20h32M15 13c0 4 2 6 2 10 0 3 1 6 2 6s1-3 1-4 0 4 1 4 2-3 2-6c0-4 2-6 2-10 0-3-2-4-5-4s-5 1-5 4',
  'M12 35h18M21 35v-6M15 29h13M18 29l6-17M20 7l7 3.5-3 6-7-3.5zM27 22a7 7 0 0 1-4 11',
  'M15 6h10l-1 6h-8zM16 12l1 17 3 5 3-5 1-17M15.5 17h9M16 22h8M16.5 27h7',
  'M14 9a4 4 0 1 0 0 8 4 4 0 1 0 0-8M27 14a3 3 0 1 0 0 6 3 3 0 1 0 0-6M6 34c0-5 3-9 8-9s8 4 8 9M21 34c0-4 3-7 6-7s6 3 6 7',
  'M20 5a15 15 0 1 0 0 30 15 15 0 1 0 0-30M14 26l12-12M15.5 14a1.5 1.5 0 1 0 0 3 1.5 1.5 0 1 0 0-3M24.5 23a1.5 1.5 0 1 0 0 3 1.5 1.5 0 1 0 0-3',
  'M5 8h21v13H14l-6 5v-5H5zM30 14h5v13h-3v4l-5-4h-9v-3',
