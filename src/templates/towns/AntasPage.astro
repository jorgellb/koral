const doctors = TEAM.filter((m) => m.doctor);
const faqs = copy.faqs.map(([q, a]) => ({ question: q, answer: linkify(a) }));
const title = copy.metaTitle;
const schema = townSchema({ town: 'antas', lang, title, description: copy.metaDesc, serviceName: copy.service });
---

<Layout title={title} description={copy.metaDesc} lang={lang} schema={schema}>
  <Navigation />
  <main id="main">
    <!-- Hero: dark gallery, spotlight on the exhibit -->
    <section class="ant-hero relative isolate overflow-hidden pb-24 pt-36 text-white md:pb-32 md:pt-44">
      <div class="ant-beam pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="container-k">
        <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-10">
          <div class="lg:col-span-6">
            <div data-reveal><Breadcrumbs items={[{ label: t('areas.nav'), href: pathFor('areas', lang) }, { label: town.name }]} class="mb-8" /></div>
            <p class="ant-kicker mb-6" data-reveal style="--d:.05s">{copy.heroEyebrow}</p>
            <h1 class="text-[2.7rem] leading-[1.02] text-white sm:text-6xl lg:text-[4.5rem]" data-reveal style="--d:.1s">
              {copy.h1}
              <span class="ant-accent block">{copy.accent}</span>
            </h1>
            <p class="mt-7 max-w-xl text-lg leading-relaxed text-white/70 md:text-xl" data-reveal style="--d:.2s">{copy.lead}</p>
            <dl class="mt-9 grid max-w-md grid-cols-3 border-y border-white/10" data-reveal style="--d:.25s">
              {copy.stats.map(([v, l], i) => (
                <div class:list={['py-4', i > 0 && 'border-l border-white/10 pl-5']}>
                  <dt class="sr-only">{l}</dt>
                  <dd class="font-display text-3xl tabular text-white">{v}</dd>
                  <dd class="mt-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-white/50">{l}</dd>
                </div>
              ))}
            </dl>
            <div class="mt-10 flex flex-col gap-3 sm:flex-row" data-reveal style="--d:.3s">
              <a href="#appointment" class="btn btn-coral shine-effect">
                {t('nav.appointment')}
                <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
              <a href="tel:+34950395319" class="btn btn-ghost-light tabular">+34 950 39 53 19</a>
            </div>
          </div>

          <div class="relative lg:col-span-6" data-reveal="fade" style="--d:.15s">
            <div class="ant-case relative mx-auto max-w-[480px]">
              <AntasVessel title={copy.vesselTitle} class="relative px-8 pt-10" />
              <div class="ant-plinth" aria-hidden="true"></div>
            </div>
            <div class="ant-label relative z-10 -mt-10 ml-auto mr-2 max-w-[290px] sm:mr-8 lg:-mt-16" data-reveal style="--d:.6s">
              <p class="ant-label-no">{copy.label.piece}</p>
              <p class="mt-1 font-display text-lg leading-snug text-ocean-900">{copy.label.name}</p>
              <p class="mt-1 text-[12px] font-semibold uppercase tracking-[0.14em] text-[#9C4E2C]">{copy.label.period}</p>
              <p class="mt-3 border-t border-ocean-900/10 pt-3 text-[13px] leading-relaxed text-slate-600">{copy.label.note}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Wall text -->
    <section class="ant-wall section-y relative">
      <div class="container-k grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="ant-kicker ant-kicker-dark mb-5" data-reveal>{copy.introEyebrow}</p>
          <h2 class="text-[2.2rem] leading-[1.08] sm:text-5xl" data-reveal style="--d:.05s">{copy.introTitle}</h2>
        </div>
        <div class="ant-walltext space-y-6 text-lg leading-relaxed text-slate-700 lg:col-span-7 lg:col-start-6 lg:columns-1" data-reveal style="--d:.1s">
          {copy.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <!-- The collection -->
    <section class="section-y relative bg-white">
      <div class="container-k">
        <SectionHeading eyebrow={copy.colEyebrow} title={copy.colTitle} description={copy.colDesc} split />
        <ol class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {copy.pieces.map(([name, tech, body], i) => (
            <li class="ant-piece" data-reveal style={`--d:${(i % 3) * 0.08}s`}>
              <div class="flex items-start justify-between gap-4">
                <p class="ant-piece-no">{copy.pieceWord} {String(i + 1).padStart(2, '0')}</p>
                <svg width="40" height="40" viewBox="0 0 40 40" class="ant-piece-icon" aria-hidden="true"><path d={ICONS[i]} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </div>
              <h3 class="mt-6 text-2xl leading-tight">{name}</h3>
              <p class="mt-2 text-[12px] font-semibold uppercase tracking-[0.14em] text-[#9C4E2C]">{tech}</p>
              <p class="mt-4 text-[15px] leading-relaxed text-slate-600" set:html={linkify(body)} />
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Timeline -->
    <section class="section-y relative overflow-hidden bg-sand">
      <div class="container-k">
        <SectionHeading eyebrow={copy.tlEyebrow} title={copy.tlTitle} align="center" />
        <div class="relative mt-16">
          <svg class="ant-tl-line pointer-events-none absolute left-0 top-[11px] hidden h-[2px] w-full lg:block" viewBox="0 0 1000 2" preserveAspectRatio="none" aria-hidden="true">
            <defs><linearGradient id="ant-tl-g" x1="0" x2="1"><stop offset="0" stop-color="#C77A55" /><stop offset="1" stop-color="#0B7C86" /></linearGradient></defs>
            <g class="draw"><path d="M0 1H1000" stroke="url(#ant-tl-g)" stroke-width="2" pathLength="1" /></g>
          </svg>
          <ol class="ant-tl grid gap-10 lg:grid-cols-5 lg:gap-6">
            {copy.tl.map(([when, what, body], i) => (
              <li class="relative pl-10 lg:pl-0" data-reveal style={`--d:${i * 0.12}s`}>
                <span class:list={['ant-tl-dot', i === 0 && 'ant-tl-dot-clay']} aria-hidden="true"></span>
                <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-slate-500 lg:mt-9">{when}</p>
                <h3 class="mt-2 text-2xl">{what}</h3>
                <p class="mt-3 text-[15px] leading-relaxed text-slate-600">{body}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- The route -->
    <section class="ant-route section-y relative isolate overflow-hidden text-white">
      <div class="container-k grid items-center gap-14 lg:grid-cols-12">
