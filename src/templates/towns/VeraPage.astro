/** Turns [[routeKey|anchor]] into an internal link. */
const linkify = (s: string, cls = 'prose-link') =>
  s.replace(/\[\[(\w+)\|([^\]]+)\]\]/g, (_, k: string, txt: string) => `<a href="${pathFor(k as RouteKey, lang)}" class="${cls}">${txt}</a>`);

const doctors = TEAM.filter((m) => m.doctor);
const SPECIALIST: Partial<Record<TreatmentKey, string>> = {
  implantes: 'Dra. Ana Padilla',
  cirugia: 'Dra. Ana Padilla',
  estetica: 'Dra. Ana Padilla',
  ortodoncia: 'Dra. Ana Soler',
  odontopediatria: 'Dra. Ana Soler',
  endodoncia: 'Dra. Ángeles Parra',
};

const faqs = copy.faqs.map(([q, a]) => ({ question: q, answer: linkify(a) }));
const title = copy.metaTitle;
const schema = townSchema({ town: 'vera', lang, title, description: copy.metaDesc, serviceName: copy.service });
---

<Layout title={title} description={copy.metaDesc} lang={lang} schema={schema}>
  <Navigation />
  <main id="main">
    <!-- Hero: civic, with an enamel street plaque -->
    <section class="ver-hero relative isolate overflow-hidden bg-ocean-900 pb-48 pt-36 text-white md:pb-60 md:pt-44">
      <div class="ver-hero-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="container-k">
        <div class="grid items-center gap-14 lg:grid-cols-12">
          <div class="lg:col-span-8">
            <div data-reveal><Breadcrumbs items={[{ label: t('areas.nav'), href: pathFor('areas', lang) }, { label: town.name }]} class="mb-8" /></div>
            <p class="eyebrow eyebrow-light mb-6" data-reveal style="--d:.05s">{copy.eyebrow}</p>
            <h1 class="text-[2.6rem] leading-[1.02] text-white sm:text-6xl lg:text-[4.6rem]" data-reveal style="--d:.1s">
              {copy.h1}
              <span class="accent-italic block text-coral-soft">{copy.accent}</span>
            </h1>
            <p class="ver-lead mt-7 max-w-2xl text-lg leading-relaxed text-white/75 md:text-xl" data-reveal style="--d:.2s" set:html={linkify(copy.lead, 'ver-link-light')} />
            <div class="mt-10 flex flex-col gap-3 sm:flex-row" data-reveal style="--d:.3s">
              <a href="#appointment" class="btn btn-coral shine-effect">
                {t('nav.appointment')}
                <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
              <a href="tel:+34950395319" class="btn btn-ghost-light tabular">+34 950 39 53 19</a>
            </div>
          </div>

          <div class="lg:col-span-4" data-reveal="scale" style="--d:.25s">
            <div class="ver-sign mx-auto max-w-[320px]">
              <p class="ver-sign-top">{copy.signTop}</p>
              <p class="ver-sign-num"><span>{rc.min}</span><span class="ver-sign-unit">{copy.signUnit}</span></p>
              <p class="ver-sign-sub tabular">{kmC} km · {roadsC}</p>
              <p class="ver-sign-foot">{copy.signFoot}</p>
            </div>
            <div class="ver-sign ver-sign-sm mx-auto mt-4 max-w-[320px]">
              <p class="flex items-baseline justify-between gap-3">
                <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-accent">Vera Playa</span>
                <span class="font-display text-2xl tabular text-ocean-900">{rp.min} {copy.signUnit} <span class="text-sm text-slate-500">· {kmP} km</span></span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Plate: the Plaza Mayor drawing, overlapping the hero -->
    <section class="relative z-10 bg-sand pb-16 md:pb-24" style="content-visibility:visible">
      <div class="container-k">
        <figure class="ver-plate relative -mt-36 md:-mt-44" data-reveal>
          <div class="flex items-center justify-between gap-4 border-b border-ocean-900/10 px-5 py-3 md:px-8">
            <p class="eyebrow !tracking-[0.2em]">{copy.plateEyebrow}</p>
            <p class="hidden text-[11px] font-semibold uppercase tracking-[0.2em] text-slate-500 sm:block">Vera · 37.24° N · 1.85° W</p>
          </div>
          <div class="px-3 pb-2 pt-6 md:px-8 md:pt-10">
            <VeraPlaza title={copy.plateTitle} plaza={copy.plaza} church={copy.church} clinic="Av. de Baria, 4" route={`${kmC} km · ${rc.min} min`} />
          </div>
          <figcaption class="grid gap-px border-t border-ocean-900/10 bg-ocean-900/10 sm:grid-cols-3">
            {copy.caption.map((c, i) => (
              <span class="flex items-center gap-3 bg-[#FDFBF8] px-5 py-4 text-[13px] leading-snug text-slate-600 md:px-8">
                <span class:list={['font-display text-lg italic', i === 2 ? 'text-coral-deep' : 'text-accent']}>{String.fromCharCode(65 + i)}</span>
                {c}
              </span>
            ))}
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- Two arrivals -->
    <section class="section-y relative bg-sand !pt-4">
      <div class="container-k">
        <SectionHeading eyebrow={copy.arrEyebrow} title={copy.arrTitle} />
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-600" data-reveal set:html={linkify(copy.arrIntro)} />

        <div class="mt-14 grid gap-6 lg:grid-cols-2">
          <article class="ver-card flex flex-col" data-reveal>
            <div class="flex flex-wrap items-end justify-between gap-4 p-7 pb-0 md:p-9 md:pb-0">
              <div>
                <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-accent">{copy.c1Label}</p>
                <h3 class="mt-2 text-2xl md:text-3xl">{copy.c1Title}</h3>
              </div>
              <p class="ver-big tabular" aria-hidden="true">{rc.min}<span>min</span></p>
            </div>
            <div class="px-3 md:px-6"><VeraIsoMap title={copy.isoTitle} from={copy.isoFrom} to={copy.isoTo} /></div>
            <p class="px-7 pb-8 text-[15px] leading-relaxed text-slate-600 md:px-9">{copy.c1Body}</p>
            <dl class="mt-auto grid grid-cols-3 border-t border-ocean-900/[0.07] bg-sand/60 text-center">
              {[[kmC, 'km'], [String(rc.min), 'min'], [rc.roads[0], copy.isoRoad]].map(([v, l], i) => (
                <div class:list={['px-3 py-5', i > 0 && 'border-l border-ocean-900/[0.07]']}>
                  <dt class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">{l}</dt>
                  <dd class="mt-1 font-display text-2xl tabular text-ocean-900">{v}</dd>
                </div>
              ))}
            </dl>
          </article>

          <article class="ver-card" data-reveal style="--d:.1s">
            <div class="flex flex-wrap items-end justify-between gap-4 p-7 pb-0 md:p-9 md:pb-0">
              <div>
                <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-coral-deep">{copy.c2Label}</p>
                <h3 class="mt-2 text-2xl md:text-3xl">{copy.c2Title}</h3>
              </div>
              <p class="ver-big ver-big-coral tabular" aria-hidden="true">{rp.min}<span>min</span></p>
            </div>
            <div class="m-5 overflow-hidden rounded-[1.25rem] ring-1 ring-ocean-900/[0.07] md:m-7">
              <TownRouteMap town="vera" tone="light" seaLabel={t('areas.sea')} />
            </div>
            <p class="px-7 pb-8 text-[15px] leading-relaxed text-slate-600 md:px-9 md:pb-9">{copy.c2Body}</p>
          </article>
        </div>
        <p class="mt-6 text-[13px] text-slate-500" data-reveal>{copy.mapNote}</p>
      </div>
    </section>

    <!-- Neighbourhood clinic -->
    <section class="section-y relative bg-white">
      <div class="container-k grid gap-14 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-7">
          <SectionHeading eyebrow={copy.nbEyebrow} title={copy.nbTitle} />
          <div class="mt-8 space-y-5 text-lg leading-relaxed text-slate-600" data-reveal style="--d:.1s">
            {copy.nb.map((p) => <p set:html={linkify(p)} />)}
          </div>
        </div>
        <aside class="lg:col-span-5" data-reveal="right">
          <div class="lg:sticky lg:top-32">
            <div class="ver-tile" aria-hidden="true">
              <span class="ver-tile-street">{copy.tile}</span>
              <span class="ver-tile-num">4</span>
              <span class="ver-tile-town">Vera</span>
            </div>
            <div class="mt-6 rounded-[1.75rem] border border-ocean-900/[0.08] bg-sand p-7">
              <h3 class="font-sans text-[13px] font-semibold uppercase tracking-[0.2em] text-accent">{copy.hoursTitle}</h3>
              <dl class="mt-4 divide-y divide-dashed divide-ocean-900/15">
                {copy.hours.map(([d, h]) => (
                  <div class="flex items-baseline justify-between gap-4 py-2.5 text-[15px]">
                    <dt class="text-slate-600">{d}</dt>
                    <dd class="tabular font-semibold text-ocean-900">{h}</dd>
                  </div>
                ))}
              </dl>
              <p class="mt-5 text-sm text-slate-600">Av. de Baria, 4 (local) · 04620 Vera · <a href="tel:+34950395319" class="prose-link tabular">+34 950 39 53 19</a></p>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- Team: arched portraits -->
    <section class="section-y relative overflow-hidden bg-sand">
      <div class="container-k">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <SectionHeading eyebrow={copy.teamEyebrow} title={copy.teamTitle} description={copy.teamDesc} />
          <a href={pathFor('team', lang)} class="btn btn-outline shrink-0 self-start lg:self-end" data-reveal>{copy.teamCta} →</a>
        </div>
        <ul class="ver-arches mt-14 grid grid-cols-2 gap-x-5 gap-y-10 md:grid-cols-4 md:gap-x-7">
          {doctors.map((m, i) => (
            <li data-reveal style={`--d:${i * 0.08}s`}>
              <div class="ver-arch">
                <Picture src={m.image} alt={`${m.name}, ${t(m.role)} – ${copy.photoAlt}`} width={600} height={600} class="aspect-[3/4] h-full w-full object-cover" />
              </div>
              <h3 class="mt-5 font-sans text-lg font-semibold tracking-tight">{m.name}</h3>
              <p class="mt-1 text-[12px] font-medium uppercase leading-snug tracking-[0.12em] text-accent">{t(m.role)}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

