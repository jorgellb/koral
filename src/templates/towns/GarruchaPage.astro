  { name: 'Ana Padilla', img: '/equipo/Ana-padilla.jpg', role: copy.crew[0] },
  { name: 'Ana Soler', img: '/equipo/ana-soler.jpg', role: copy.crew[1] },
  { name: 'Ángeles Parra', img: '/equipo/angeles-parrar.jpg', role: copy.crew[2] },
];
const HOURS: [number, number][] = [[10, 20], [8, 16], [10, 18], [8, 16], [8, 16]];
const DAY0 = 8;
const SPAN = 12;
const hh = (h: number) => `${h}:00`;
const mapsUrl = 'https://www.google.com/maps/dir/?api=1&origin=Garrucha%2C+Almer%C3%ADa&destination=Cl%C3%ADnica+Dental+Koral%2C+Av.+de+Baria+4%2C+Vera&travelmode=driving';

// Countdown track: one tick per minute, legs proportional to their minutes
const TW = 1000;
const TX0 = 40;
const TX1 = 960;
const pxPerMin = (TX1 - TX0) / MIN;
let acc = 0;
const segs = legs.map((leg) => {
  const s = { x0: TX0 + acc * pxPerMin, x1: TX0 + (acc + leg.min) * pxPerMin, leg };
  acc += leg.min;
  return s;
});
const segColors = ['#8FE3EA', '#2CC5D2', '#F2617A', '#FF9AAA'];
---

<Layout title={title} description={description} lang={lang} schema={schema}>
  <Navigation />
  <main id="main" class="gar-page">
    <!-- ============ Hero: the chart ============ -->
    <section class="gar-hero relative isolate overflow-hidden bg-ocean-900 pb-20 pt-32 text-white md:pt-40 lg:pb-28">
      <div class="gar-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
      <svg class="pointer-events-none absolute -left-40 bottom-[-180px] -z-10 h-[620px] w-[620px] opacity-[0.07]" viewBox="0 0 600 600" fill="none" aria-hidden="true">
        {[90, 150, 210, 270].map((r, i) => <circle cx="300" cy="300" r={r} stroke="#E6D8C6" stroke-dasharray={i % 2 ? '3 9' : undefined} />)}
        <path d="M300 20v560M20 300h560M102 102l396 396M498 102 102 498" stroke="#E6D8C6" stroke-opacity=".6" />
      </svg>

      <div class="container-k relative">
        <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
          <div class="lg:col-span-6">
            <div data-reveal><Breadcrumbs items={[{ label: t('areas.nav'), href: pathFor('areas', lang) }, { label: town.name }]} class="mb-8" /></div>
            <p class="eyebrow eyebrow-light mb-6" data-reveal style="--d:.05s">{copy.eyebrow}</p>
            <h1 class="text-[2.55rem] leading-[1.02] text-white sm:text-6xl lg:text-[4.1rem] xl:text-[4.6rem]" data-reveal style="--d:.1s">
              {copy.h1}
              <span class="accent-italic block text-coral-soft">{copy.h1Accent}</span>
            </h1>
            <p class="mt-7 max-w-xl text-lg leading-relaxed text-white/75 md:text-xl [&_strong]:font-semibold [&_strong]:text-white" data-reveal style="--d:.18s" set:html={copy.lead} />

            <dl class="gar-log mt-9 grid max-w-xl grid-cols-3 overflow-hidden rounded-2xl border border-[#E6D8C6]/20" data-reveal style="--d:.26s">
              {[[KM, copy.stats[0]], [String(MIN), copy.stats[1]], [String(route.roads.length), copy.stats[2]]].map(([v, l]) => (
                <div class="border-[#E6D8C6]/20 px-4 py-4 [&:not(:first-child)]:border-l sm:px-5">
                  <dt class="mt-1 text-[11px] font-semibold uppercase leading-snug tracking-[0.14em] text-[#E6D8C6]/65">{l}</dt>
                  <dd class="font-display tabular text-3xl text-white sm:text-4xl">{v}</dd>
                </div>
              ))}
            </dl>

            <div class="mt-9 flex flex-col gap-3 sm:flex-row" data-reveal style="--d:.34s">
              <a href="#appointment" class="btn btn-coral shine-effect">
                {t('nav.appointment')}
                <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
              <a href="tel:+34950395319" class="btn btn-ghost-light">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" /></svg>
                {copy.call} · +34 950 39 53 19
              </a>
            </div>
            <p class="mt-7 text-[12px] tabular tracking-[0.12em] text-[#E6D8C6]/55" data-reveal style="--d:.4s">{coords}</p>
          </div>

          <figure class="relative lg:col-span-6" data-reveal="scale" style="--d:.2s">
            <div class="gar-chart-frame relative mx-auto max-w-[540px] rounded-[1.75rem] bg-[#0E2B45] p-2.5 shadow-[var(--shadow-premium)] ring-1 ring-[#E6D8C6]/15">
              <div class="overflow-hidden rounded-[1.3rem]">
                <GarruchaChart title={copy.chartTitle} seaLabel={copy.sea} clinicSub={copy.clinicSub} />
              </div>
            </div>
            <figcaption class="mx-auto mt-4 max-w-[540px] text-center font-display text-[15px] italic text-[#E6D8C6]/70">{copy.chartCaption}</figcaption>
          </figure>
        </div>
      </div>
      <div class="gar-neat absolute inset-x-0 bottom-0 h-2" aria-hidden="true"></div>
    </section>

    <!-- ============ Logbook + port ============ -->
    <section class="gar-paper section-y relative overflow-hidden">
      <div class="container-k relative">
        <div class="grid gap-14 lg:grid-cols-12 lg:items-center lg:gap-16">
          <div class="lg:col-span-6">
            <div data-reveal>
              <p class="eyebrow mb-5">{copy.logEyebrow}</p>
              <h2 class="text-[2.2rem] leading-[1.06] sm:text-5xl lg:text-[3.2rem]">{copy.logTitle}</h2>
            </div>
            <div class="mt-8 space-y-5 text-[17px] leading-relaxed text-slate-700">
              {copy.logP.map((p, i) => <p data-reveal style={`--d:${0.05 + i * 0.06}s`} set:html={p} />)}
            </div>
          </div>
          <figure class="lg:col-span-6" data-reveal="right">
            <div class="relative overflow-hidden rounded-[2rem] bg-[#FBF8F4] p-3 shadow-[var(--shadow-card)] ring-1 ring-ocean-900/[0.07]">
              <div class="gar-port-frame overflow-hidden rounded-[1.5rem] border border-dashed border-ocean-900/15">
                <GarruchaPort title={copy.portTitle} stamp={copy.stamp} />
              </div>
            </div>
            <figcaption class="mt-4 font-display text-[15px] italic text-slate-500">{copy.portCaption}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ============ The 10-minute trip ============ -->
    <section class="gar-trip relative isolate overflow-hidden bg-ocean-900 text-white">
      <div class="gar-neat absolute inset-x-0 top-0 h-2" aria-hidden="true"></div>
      <div class="gar-grid pointer-events-none absolute inset-0 -z-10 opacity-70" aria-hidden="true"></div>
      <div class="container-k section-y relative">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-8" data-reveal>
            <p class="eyebrow eyebrow-light mb-5">{copy.tripEyebrow}</p>
            <h2 class="text-[2.2rem] leading-[1.06] text-white sm:text-5xl lg:text-[3.4rem]">{copy.tripTitle}</h2>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/70">{copy.tripDesc}</p>
          </div>
          <div class="flex items-end gap-4 lg:col-span-4 lg:justify-end" data-reveal style="--d:.1s">
            <span class="font-display tabular text-[7.5rem] leading-[0.8] text-[#E6D8C6] md:text-[9.5rem]" data-count={MIN}>{MIN}</span>
            <span class="pb-2 text-[12px] font-semibold uppercase tracking-[0.18em] text-aqua-soft">{copy.countLabel}</span>
          </div>
        </div>

        <!-- Countdown track (md+) -->
        <div class="mt-16 hidden md:block" data-reveal>
          <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.2em] text-[#E6D8C6]/50">{copy.countdown}</p>
          <svg viewBox={`0 0 ${TW} 110`} class="gar-track h-auto w-full" aria-hidden="true">
            <g font-family="Inter, system-ui, sans-serif" font-size="13" fill="#E6D8C6" fill-opacity=".6" text-anchor="middle">
              {Array.from({ length: MIN + 1 }, (_, i) => (
                <g>
                  <line x1={TX0 + i * pxPerMin} x2={TX0 + i * pxPerMin} y1="30" y2={i % 5 === 0 ? 50 : 44} stroke="#E6D8C6" stroke-opacity=".45" />
                  <text x={TX0 + i * pxPerMin} y="20" class="tabular">{MIN - i}</text>
                </g>
              ))}
            </g>
            <line x1={TX0} x2={TX1} y1="76" y2="76" stroke="#E6D8C6" stroke-opacity=".12" stroke-width="8" stroke-linecap="round" />
            <g class="draw">
              {segs.map((s, i) => (
                <line x1={s.x0 + 6} x2={s.x1 - 6} y1="76" y2="76" stroke={segColors[i]} stroke-width="5" stroke-linecap="round" pathLength="1" style={`--dd:${0.2 + i * 0.35}s`} />
              ))}
            </g>
            {segs.map((s, i) => (
              <g>
                <rect x={s.x0 - 7} y="69" width="14" height="14" transform={`rotate(45 ${s.x0} 76)`} fill="#0A1F33" stroke="#E6D8C6" stroke-width="1.5" />
                {i > 0 && <text x={s.x0} y="104" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-size="12" font-weight="600" letter-spacing="1" fill="#8FE3EA">WP{i}</text>}
              </g>
            ))}
            <circle cx={TX1} cy="76" r="9" fill="#F2617A" stroke="#fff" stroke-width="2" />
          </svg>
        </div>

        <ol class="gar-legs mt-10 grid gap-4 md:mt-8 md:grid-cols-4">
          {legs.map((leg, i) => (
            <li class="gar-leg relative rounded-[1.5rem] border border-[#E6D8C6]/15 bg-white/[0.04] p-6 backdrop-blur-sm" data-reveal style={`--d:${i * 0.08}s`}>
              <div class="flex items-center justify-between gap-3">
                <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-aqua-soft">{i === 0 ? copy.start : `WP${i}`}</span>
                <span class="tabular rounded-full bg-[#E6D8C6]/10 px-3 py-1 text-[12px] font-semibold text-[#E6D8C6]">≈ {leg.min} min · {num(leg.km)} km</span>
              </div>
              <h3 class="mt-5 font-sans text-xl font-semibold tracking-tight text-white">{copy.legs[i][0]}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-white/65">{copy.legs[i][1]}</p>
              <span class="mt-5 block h-1 rounded-full" style={`background:${segColors[i]};width:${Math.max(18, leg.share * 100 * 2.2)}%`} aria-hidden="true"></span>
            </li>
          ))}
        </ol>

        <div class="mt-10 flex flex-col gap-5 border-t border-[#E6D8C6]/15 pt-8 sm:flex-row sm:items-center sm:justify-between" data-reveal>
          <p class="max-w-2xl text-[13px] text-white/50">{copy.legNote}</p>
          <a href={mapsUrl} target="_blank" rel="noopener" class="btn btn-ghost-light shrink-0">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
            {copy.maps}
          </a>
        </div>
      </div>
      <div class="gar-neat absolute inset-x-0 bottom-0 h-2" aria-hidden="true"></div>
    </section>

    <!-- ============ Practical care ============ -->
    <section class="section-y relative overflow-hidden bg-sand">
      <div class="container-k relative">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end" data-reveal>
          <div class="lg:col-span-7">
            <p class="eyebrow mb-5">{copy.careEyebrow}</p>
            <h2 class="text-[2.2rem] leading-[1.06] sm:text-5xl lg:text-[3.3rem]">{copy.careTitle}</h2>
          </div>
          <p class="text-lg leading-relaxed text-slate-600 lg:col-span-5 lg:pb-2">{copy.careDesc}</p>
        </div>

        <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {care.map((c, i) => (
            <li class="gar-card group relative flex flex-col rounded-[1.75rem] border border-ocean-900/[0.07] bg-white p-7 shadow-[var(--shadow-soft)] transition-all duration-500 hover:-translate-y-1 hover:shadow-[var(--shadow-elevated)]" data-reveal style={`--d:${(i % 3) * 0.07}s`}>
              <div class="flex items-start justify-between">
                <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-aqua-pale/70 text-accent ring-1 ring-accent/10"><TreatmentIcon name={c.key} size={34} /></span>
                <span class="font-display text-lg italic text-coral">N° {String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="mt-6 font-sans text-xl font-semibold tracking-tight text-ocean-900">{c.name}</h3>
              <p class="mt-2 flex-1 text-[15px] leading-relaxed text-slate-600">{c.desc}</p>
              <a href={c.href} class="mt-5 inline-flex items-center gap-2 border-t border-dashed border-ocean-900/15 pt-4 text-sm font-semibold text-accent">
                {c.link}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-12 grid gap-8 rounded-[2rem] border border-ocean-900/[0.07] bg-white p-7 shadow-[var(--shadow-soft)] md:p-9 lg:grid-cols-12 lg:items-center" data-reveal>
          <div class="lg:col-span-5">
            <h3 class="text-3xl text-ocean-900">{copy.crewTitle}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-slate-600" set:html={copy.crewDesc} />
          </div>
          <ul class="grid gap-5 sm:grid-cols-3 lg:col-span-7">
            {crew.map((m) => (
              <li class="flex items-center gap-4 sm:flex-col sm:items-start">
                <Picture src={m.img} alt={`${copy.dr} ${m.name} – ${m.role}`} width={600} height={600} class="h-20 w-20 shrink-0 rounded-full object-cover ring-4 ring-sand" />
                <div>
                  <p class="font-semibold text-ocean-900">{copy.dr} {m.name}</p>
                  <p class="mt-0.5 text-[13px] leading-snug text-slate-500">{m.role}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ Best clinic? + tide table ============ -->
    <section class="section-y relative overflow-hidden bg-white">
      <div class="container-k relative">
        <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-6">
            <div data-reveal>
              <p class="eyebrow mb-5">{copy.bestEyebrow}</p>
              <h2 class="text-[2.2rem] leading-[1.06] sm:text-5xl lg:text-[3.2rem]">{copy.bestTitle}</h2>
              <p class="mt-6 text-lg leading-relaxed text-slate-600">{copy.bestP}</p>
            </div>
            <ol class="mt-10 divide-y divide-ocean-900/[0.08] border-y border-ocean-900/[0.08]">
              {copy.reasons.map(([name, desc], i) => (
                <li class="flex gap-5 py-5" data-reveal style={`--d:${i * 0.05}s`}>
                  <span class="gar-bearing mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-accent/25 text-[11px] font-semibold tabular text-accent">{String(i * 72).padStart(3, '0')}°</span>
                  <div>
                    <h3 class="font-sans text-lg font-semibold tracking-tight text-ocean-900">{name}</h3>
                    <p class="mt-1 text-[15px] leading-relaxed text-slate-600" set:html={desc} />
                  </div>
                </li>
              ))}
            </ol>
          </div>

          <div class="lg:col-span-6">
            <div class="gar-tide relative isolate overflow-hidden rounded-[2rem] bg-ocean-900 p-7 text-white shadow-[var(--shadow-premium)] md:p-9" data-reveal="right">
              <svg class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-28 w-full opacity-25" viewBox="0 0 600 100" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0 60C75 20 150 20 225 60S375 100 450 60 525 20 600 40" fill="none" stroke="#8FE3EA" />
                <path d="M0 76C75 40 150 40 225 76S375 108 450 76 525 44 600 60" fill="none" stroke="#8FE3EA" stroke-opacity=".5" stroke-dasharray="3 6" />
              </svg>
              <p class="eyebrow eyebrow-light mb-4">{copy.hoursEyebrow}</p>
              <h3 class="text-3xl text-white md:text-[2.1rem]">{copy.hoursTitle}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-white/70">{copy.hoursDesc}</p>

              <div class="mt-8">
                <div class="ml-[6.5rem] flex justify-between text-[10px] tabular tracking-wider text-[#E6D8C6]/50 sm:ml-[7.5rem]" aria-hidden="true">
                  {[8, 11, 14, 17, 20].map((h) => <span>{h}h</span>)}
                </div>
                <ul class="mt-2 space-y-2.5">
                  {HOURS.map(([o, c], i) => (
                    <li class="grid grid-cols-[6rem_1fr] items-center gap-2 sm:grid-cols-[7rem_1fr]">
                      <span class="text-[14px] font-semibold text-white">{copy.days[i]}</span>
                      <span class="relative h-9 rounded-full bg-white/[0.06] ring-1 ring-white/5">
                        <span class="gar-tide-bar absolute inset-y-1 flex items-center justify-center rounded-full bg-gradient-to-r from-aqua to-accent text-[12px] font-semibold tabular text-white" style={`left:${((o - DAY0) / SPAN) * 100}%;--w:${((c - o) / SPAN) * 100}%;--i:${i}`}>{hh(o)}–{hh(c)}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-8 rounded-[1.25rem] border border-coral/30 bg-coral/10 p-5">
                <p class="font-display text-xl text-white">{copy.quickTitle}</p>
                <p class="gar-dark-links mt-1.5 text-[15px] leading-relaxed text-white/75" set:html={copy.quickDesc} />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <FaqSection eyebrow="FAQ · Garrucha" title={copy.faqTitle} faqs={copy.faqs.map(([question, answer]) => ({ question, answer }))} />

    <TownNearby current="garrucha" />

    <Contact />
  </main>
  <FooterInfo />
</Layout>

<style is:global>
  .gar-hero .gar-grid,
  .gar-trip .gar-grid {
    background-image:
      linear-gradient(rgba(230, 216, 198, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(230, 216, 198, 0.06) 1px, transparent 1px),
      linear-gradient(rgba(230, 216, 198, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(230, 216, 198, 0.025) 1px, transparent 1px),
      radial-gradient(60% 55% at 85% 20%, rgba(44, 197, 210, 0.14), transparent 70%),
      radial-gradient(50% 50% at 5% 95%, rgba(242, 97, 122, 0.1), transparent 70%);
    background-size: 120px 120px, 120px 120px, 24px 24px, 24px 24px, auto, auto;
  }
  .gar-neat {
    background: repeating-linear-gradient(90deg, #e6d8c6 0 60px, #0a1f33 60px 120px);
    opacity: 0.55;
  }
  .gar-paper {
    background-color: #fbf8f4;
    background-image:
      linear-gradient(rgba(10, 31, 51, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(10, 31, 51, 0.035) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  .gar-log { display: grid; }
  .gar-log > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
  .gar-dark-links a { color: #8fe3ea; font-weight: 600; text-decoration: underline; text-decoration-color: rgba(143, 227, 234, 0.4); text-underline-offset: 3px; }
  .gar-dark-links a:hover { color: #fff; text-decoration-color: currentColor; }

  .gar-chart, .gar-port { display: block; width: 100%; height: auto; }
  .gar-chart .gar-rose-ring { transform-box: fill-box; transform-origin: center; animation: gar-spin 80s linear infinite; }
  .gar-chart .gar-wp { opacity: 0; transition: opacity 0.8s ease var(--d, 1s); }
  .visible .gar-chart .gar-wp { opacity: 1; }
  .gar-chart .gar-pulse { transform-box: fill-box; transform-origin: center; animation: pulse-ring 2.6s cubic-bezier(0.2, 0.6, 0.4, 1) infinite; }

  .gar-port .gar-boat { transform-box: fill-box; transform-origin: 50% 100%; animation: gar-bob 5.5s ease-in-out infinite; animation-delay: var(--bd, 0s); }
  .gar-port .gar-wave { animation: gar-drift 14s linear infinite; }
  .gar-port .gar-wave-2 { animation-duration: 20s; animation-direction: reverse; }
  .gar-port .gar-wave-3 { animation-duration: 26s; }
  .gar-port .gar-light { animation: twinkle 3s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .gar-port .gar-sunring { transform-box: fill-box; transform-origin: center; animation: gar-spin 60s linear infinite; }
  .gar-port .gar-gulls { animation: float 9s ease-in-out infinite; }

  @media (max-width: 767px) {
    .gar-legs { position: relative; padding-left: 1.6rem; }
    .gar-legs::before { content: ""; position: absolute; left: .42rem; top: 1.8rem; bottom: 1.8rem; border-left: 1.5px dashed rgba(230, 216, 198, 0.35); }
