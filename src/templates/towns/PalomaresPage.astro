        <p class="eyebrow eyebrow-center mt-9" data-reveal>{copy.hero.eyebrow}</p>
        <h1 class="mx-auto mt-5 max-w-4xl text-[2.45rem] leading-[1.04] sm:text-[3.4rem] lg:text-[4.3rem]" data-reveal style="--d:.06s">
          {copy.hero.h1}
          <span class="accent-italic block text-coral-deep">{copy.hero.accent}</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-[17px] leading-relaxed text-slate-700 md:text-lg" data-reveal style="--d:.12s">{copy.hero.lead}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3" data-reveal style="--d:.18s">
