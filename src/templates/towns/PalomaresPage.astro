          </a>
          <a href="https://wa.me/34634683639" target="_blank" rel="noopener" class="btn btn-outline">WhatsApp · +34 634 68 36 39</a>
        </div>
        <ul class="mt-7 flex flex-wrap justify-center gap-2 text-[13px] font-medium text-ocean-900/80" data-reveal style="--d:.24s">
          <li class="rounded-full bg-white/70 px-3.5 py-1.5 ring-1 ring-ocean-900/[0.08] tabular">{fill(t('areas.drive'), { min, km })}</li>
          <li class="rounded-full bg-white/70 px-3.5 py-1.5 ring-1 ring-ocean-900/[0.08]">{roads.join(' → ')}</li>
          <li class="rounded-full bg-white/70 px-3.5 py-1.5 ring-1 ring-ocean-900/[0.08]">{t('trust.7')}</li>
        </ul>
        <p class="mt-4 text-[13px] text-slate-500" data-reveal style="--d:.28s">{copy.hero.note}</p>
      </div>

      <div class="pal-horizon relative mt-8 aspect-[390/290] sm:aspect-[1440/460]" data-reveal="fade">
        <svg viewBox="0 0 1440 460" preserveAspectRatio="xMidYMax slice" class="absolute inset-0 h-full w-full" role="img" aria-labelledby="pal-hero-t">
          <title id="pal-hero-t">{copy.hero.svgTitle}</title>
          <defs>
            <radialGradient id="pal-sun-glow">
              <stop offset="0" stop-color="#FF9AAA" stop-opacity=".55" />
              <stop offset=".45" stop-color="#FFC9B8" stop-opacity=".25" />
              <stop offset="1" stop-color="#FFE4E8" stop-opacity="0" />
            </radialGradient>
            <linearGradient id="pal-sun" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#FFB59F" />
              <stop offset="1" stop-color="#F2617A" />
            </linearGradient>
            <linearGradient id="pal-sea" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#9FE4EA" />
              <stop offset="1" stop-color="#D5F6F8" />
            </linearGradient>
            <linearGradient id="pal-field" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#EFE2CF" />
              <stop offset="1" stop-color="#FBF8F4" />
