const title = copy.metaTitle;
const description = copy.metaDesc;
const schema = townSchema({ town: 'palomares', lang, title, description, serviceName: fill(t('areas.dentist.in'), { town: town.name }) });
const crumbs = [{ label: t('areas.nav'), href: pathFor('areas', lang) }, { label: town.name }];
const mapsUrl = 'https://www.google.com/maps/dir/?api=1&origin=Palomares,+Cuevas+del+Almanzora&destination=Clinica+Dental+Koral+Vera+Almeria';
const ticks = [8, 10, 12, 14, 16, 18, 20];

/* ---------- Horizon (viewBox 1440 × 460) ---------- */
const r1 = (n: number) => Math.round(n * 10) / 10;
const VP: [number, number] = [640, 238];
const FIELD_TOP = 302;
const furrow = (xb: number) => {
  const k = (FIELD_TOP - VP[1]) / (470 - VP[1]);
  return `M${xb} 470L${r1(VP[0] + (xb - VP[0]) * k)} ${FIELD_TOP}`;
};
const furrows = Array.from({ length: 30 }, (_, i) => furrow(-860 + i * 110));
const crops = Array.from({ length: 29 }, (_, i) => furrow(-805 + i * 110));
const waves = [252, 262, 274, 288];
const careIcons = ['periodoncia', 'implantes', 'rehabilitacion', 'tooth'] as const;
---

<Layout title={title} description={description} lang={lang} schema={schema}>
  <Navigation />
  <main id="main" class="pal-page">
    <!-- 1 · Hero: dawn horizon -->
