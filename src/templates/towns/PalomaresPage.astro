<script>
  // Week chart: "when suits you" filters + today's row (Madrid time).
  document.querySelectorAll<HTMLElement>('[data-pal-chart]').forEach((chart) => {
    const grid = chart.querySelector<HTMLElement>('.pal-grid')!;
    const rows = [...chart.querySelectorAll<HTMLElement>('.pal-row[data-day]')];
    const out = chart.querySelector<HTMLElement>('.pal-fit')!;
    const buttons = [...chart.querySelectorAll<HTMLButtonElement>('.pal-win-btn')];
    const pos = (h: number) => `${((h - 8) / 12) * 100}%`;
    const lang = document.documentElement.lang || 'es';
    const list = (items: string[]) => {
      try {
        return new Intl.ListFormat(lang, { type: 'conjunction' }).format(items);
      } catch {
        return items.join(', ');
      }
    };

    const select = (btn: HTMLButtonElement | null) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      if (!btn) {
        chart.removeAttribute('data-window');
        rows.forEach((r) => r.removeAttribute('data-match'));
        out.textContent = '';
        return;
      }
      const from = Number(btn.dataset.from);
      const to = Number(btn.dataset.to);
      chart.setAttribute('data-window', '');
      grid.style.setProperty('--ws', pos(from));
      grid.style.setProperty('--we', pos(to));
      const fits: string[] = [];
      rows.forEach((r) => {
        const ok = Math.min(to, Number(r.dataset.close)) - Math.max(from, Number(r.dataset.open)) > 0;
        r.dataset.match = String(ok);
        if (ok) fits.push(r.dataset.name!.toLowerCase());
      });
      out.textContent = fits.length ? chart.dataset.fit!.replace('{days}', list(fits)) : chart.dataset.none!;
    };
    buttons.forEach((b) => b.addEventListener('click', () => select(b.getAttribute('aria-pressed') === 'true' ? null : b)));

    // Highlight today (the clinic is in Spain, so use Madrid time).
    try {
      const parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Madrid', weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date());
      const get = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
      const day = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'].indexOf(get('weekday')) + 1;
      const row = rows.find((r) => Number(r.dataset.day) === day);
      if (row) {
        row.dataset.today = '';
        const now = Number(get('hour')) + Number(get('minute')) / 60;
        const day$ = row.querySelector('.pal-day');
        const tag = document.createElement('span');
        tag.className = 'pal-today';
        tag.textContent = chart.dataset.todayLabel || '';
        day$?.appendChild(tag);
        if (now >= 8 && now <= 20) {
          const line = document.createElement('span');
          line.className = 'pal-now';
          line.style.left = pos(now);
          line.setAttribute('aria-hidden', 'true');
          row.querySelector('.pal-track')?.appendChild(line);
        }
      }
    } catch {
      /* no Intl time zone support: skip the "today" hint */
    }
  });
</script>

