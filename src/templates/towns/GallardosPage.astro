  .gal-stops-dot { position: absolute; left: 0; top: 0.1rem; width: 28px; height: 28px; border-radius: 999px; background: #fff; border: 6px solid var(--c); }

  @media (prefers-reduced-motion: reduce) {
    .gal-seg::after, .gal-line-track::before { transform: none !important; transition: none !important; }
  }
</style>
