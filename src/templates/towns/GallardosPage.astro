  }

  /* Treatment line cards */
  .gal-line-card { position: relative; display: flex; flex-direction: column; border-radius: 1.5rem; background: #fff; box-shadow: 0 0 0 1px rgba(10, 31, 51, 0.08), var(--shadow-soft); padding: 1.75rem; transition: opacity 1s var(--ease-out-expo) var(--d, 0s), transform 0.6s var(--ease-out-expo), box-shadow 0.6s var(--ease-out-expo); }
  .gal-line-card:hover { transform: translateY(-4px); box-shadow: 0 0 0 2px var(--c), var(--shadow-elevated); }
  .gal-line-track { position: relative; display: flex; justify-content: space-between; height: 14px; align-items: center; }
  .gal-line-track::before { content: ''; position: absolute; inset: 50% 0 auto; height: 6px; margin-top: -3px; border-radius: 3px; background: var(--c); transform: scaleX(0); transform-origin: left; transition: transform 1s var(--ease-out-expo) calc(var(--d, 0s) + 0.3s); }
  .gal-line-card.visible .gal-line-track::before { transform: none; }
  .gal-line-track span { position: relative; width: 14px; height: 14px; border-radius: 999px; background: #fff; border: 3px solid var(--c); }
  .gal-line-badge { align-self: flex-start; margin-top: 1.4rem; display: inline-flex; height: 2.4rem; min-width: 2.4rem; align-items: center; justify-content: center; border-radius: 999px; background: var(--c); padding: 0 0.6rem; font-weight: 800; font-size: 0.9rem; color: #fff; }
  .gal-line-link a { text-decoration: none; }

  .gal-rule { height: 10px; border-radius: 6px; background: linear-gradient(90deg, #f2617a 0 25%, #0b7c86 25% 50%, #2cc5d2 50% 75%, #143b5c 75% 100%); }

  /* Facts as stops on a vertical line */
  .gal-stops { position: relative; list-style: none; padding: 0; }
  .gal-stops::before { content: ''; position: absolute; left: 11px; top: 10px; bottom: 10px; width: 6px; border-radius: 3px; background: linear-gradient(180deg, #f2617a, #0b7c86, #2cc5d2, #143b5c); }
  .gal-stops li { position: relative; padding: 0 0 2rem 3.25rem; }
