              <div class="flex flex-col gap-2.5 p-6 sm:flex-row lg:flex-col xl:flex-row">
                <a href="tel:+34950395319" class="btn btn-dark !px-5 !py-3 text-sm tabular">+34 950 39 53 19</a>
                <a href="https://wa.me/34634683639" target="_blank" rel="noopener" class="btn btn-teal !px-5 !py-3 text-sm">WhatsApp</a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <FaqSection eyebrow={copy.faqEyebrow} title={copy.faqTitle} faqs={copy.faqs.map(([question, answer]) => ({ question, answer }))} />

    <TownNearby current="gallardos" />

    <Contact />
  </main>
  <FooterInfo />
</Layout>

<style is:global>
