  .gal-stop-k { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 0.2rem; }
  .gal-seg { position: relative; height: 84px; padding-left: 72px; display: flex; align-items: center; }
  .gal-seg::before, .gal-seg::after { content: ''; position: absolute; left: 23px; width: 10px; top: -6px; bottom: -6px; border-radius: 5px; }
  .gal-seg::before { background: #e6ebef; }
  .gal-seg::after { background: var(--c); transform: scaleY(0); transform-origin: top; transition: transform 0.9s var(--ease-out-expo) calc(0.3s + var(--i) * 0.45s); }
  .gal-strip.visible .gal-seg::after { transform: none; }
