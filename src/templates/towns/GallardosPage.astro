        </ul>
      </div>
    </section>

    <!-- ============ Facts + timetable ============ -->
    <section class="section-y relative overflow-hidden bg-white pt-0 md:pt-0 lg:pt-0">
      <div class="container-k">
        <div class="gal-rule mb-20 md:mb-28" aria-hidden="true"></div>
        <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-7">
            <div data-reveal>
              <p class="eyebrow mb-5">{copy.whyEyebrow}</p>
