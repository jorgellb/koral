          </figure>
        </div>
      </div>
    </section>

    <!-- ============ The plan, as a ticket ============ -->
    <section class="section-y relative overflow-hidden bg-sand">
      <div class="container-k">
        <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
