    ],
    stepsLabel: 'So funktioniert es',
    steps: [
      { title: 'Kostenloser Ersttermin', desc: 'Wir beurteilen Ihren Fall und erklären Ihnen unverbindlich die Behandlungsmöglichkeiten.' },
      { title: 'Klarer Kostenvoranschlag', desc: 'Sie erhalten einen detaillierten Kostenvoranschlag für Ihre gesamte Behandlung.' },
      { title: 'Ihr Zahlungsplan', desc: 'Wir legen die Raten gemeinsam fest – direkt mit der Klinik, ohne Bank.' },
      { title: 'Behandlungsbeginn', desc: 'Sie beginnen so bald wie möglich und zahlen nach und nach.' },
    ],
    budgetEyebrow: 'Ein einziger Kostenvoranschlag',
    oneQuote: 'Ein Kostenvoranschlag',
    allInOne: 'Ihre gesamte Behandlung',
    qualityEyebrow: 'Qualität, die bleibt',
    chartLow: '„Low-Cost“-Lösungen',
    chartQuality: 'Qualitätsbehandlung',
    chartCost: 'Gesamtkosten',
    chartTime: 'Jahre',
    faqEyebrow: 'Häufige Fragen',
    faqTitle: 'Fragen zur Finanzierung',
    faqs: [
      { q: 'Muss ich einen Bankkredit aufnehmen?', a: 'Nein. Die Finanzierung erfolgt direkt mit der Klinik, ohne Banken oder Finanzinstitute. Unsere Patientenberaterin erstellt mit Ihnen einen passenden Zahlungsplan.' },
      { q: 'Fallen Zinsen an?', a: 'Bei den meisten Behandlungen bieten wir eine Finanzierung zu 0 % ohne Zinsen an. Die Bedingungen Ihres Plans bestätigen wir Ihnen vor Behandlungsbeginn im Kostenvoranschlag.' },
      { q: 'Welche Zahlungsarten akzeptieren Sie?', a: 'Sie können mit Karte, bar oder über einen direkten Finanzierungsplan mit der Klinik bezahlen.' },
      { q: 'Was kostet der erste Termin?', a: 'Nichts: Der Ersttermin ist kostenlos und unverbindlich. Wir beurteilen Ihren Fall, erklären Ihnen die Möglichkeiten und erstellen einen detaillierten Kostenvoranschlag. <a href="{contact}">Hier Termin anfragen</a>.' },
      { q: 'Und wenn meine Behandlung mehrere Spezialisten erfordert?', a: 'Jede Spezialistin stellt ihre Diagnose und plant ihren Teil – alles wird in einem einzigen Kostenvoranschlag für die gesamte Behandlung zusammengefasst.' },
    ],
    treatEyebrow: 'Behandlungen',
    treatTitle: 'Finanzieren Sie Ihre Behandlung',
    treatAccent: 'zinsfrei',
    treatDesc: 'Implantate, Kieferorthopädie, Ästhetik … Fordern Sie einen unverbindlichen Kostenvoranschlag an – wir schlagen Ihnen einen passenden Zahlungsplan vor.',
  },
  nl: {
    title: 'Tandheelkundige financiering',
    accent: 'renteloos in Vera',
    calendarCaption: 'U betaalt uw behandeling in gemakkelijke termijnen, rechtstreeks met de kliniek.',
    optionsEyebrow: 'Hoe betalen',
    optionsTitle: 'Betaalmogelijkheden',
    optionsAccent: 'op maat',
    optionsDesc: 'U kiest hoe u betaalt. We leggen elke optie rustig uit, zonder kleine lettertjes.',
    options: [
      { title: 'Directe 0% financiering', desc: 'Renteloos voor de meeste behandelingen, zonder banken of financiële instellingen.' },
      { title: 'Termijnen op maat', desc: 'We stemmen het betaalplan af op uw mogelijkheden, zodat u zo snel mogelijk kunt beginnen.' },
      { title: 'Pin, creditcard of contant', desc: 'Als u dat liever heeft, kunt u in de kliniek ook met kaart of contant betalen.' },
    ],
    stepsLabel: 'Zo werkt het',
    steps: [
      { title: 'Gratis eerste bezoek', desc: 'We beoordelen uw situatie en leggen vrijblijvend de behandelopties uit.' },
      { title: 'Een duidelijke offerte', desc: 'U ontvangt een gedetailleerde offerte voor uw volledige behandeling.' },
      { title: 'Uw betaalplan', desc: 'We spreken samen de termijnen af, rechtstreeks met de kliniek en zonder bank.' },
      { title: 'Start van uw behandeling', desc: 'U begint zo snel mogelijk en betaalt beetje bij beetje.' },
    ],
    budgetEyebrow: 'Eén offerte',
    oneQuote: 'Eén offerte',
    allInOne: 'Uw volledige behandeling',
    qualityEyebrow: 'Kwaliteit die blijft',
    chartLow: '‘Low-cost’-oplossingen',
    chartQuality: 'Kwaliteitsbehandeling',
    chartCost: 'Totale kosten',
    chartTime: 'Jaren',
    faqEyebrow: 'Veelgestelde vragen',
    faqTitle: 'Vragen over financiering',
    faqs: [
      { q: 'Moet ik een lening bij de bank afsluiten?', a: 'Nee. De financiering wordt rechtstreeks met de kliniek geregeld, zonder banken of financiële instellingen. Onze patiëntadviseur stelt samen met u een betaalplan op maat op.' },
      { q: 'Betaal ik rente?', a: 'Voor de meeste behandelingen bieden we 0% financiering, zonder rente. De voorwaarden van uw plan bevestigen we in de offerte, voordat u begint.' },
      { q: 'Welke betaalmethoden accepteren jullie?', a: 'U kunt betalen met kaart, contant of via een direct financieringsplan met de kliniek.' },
      { q: 'Wat kost het eerste bezoek?', a: 'Niets: het eerste bezoek is gratis en vrijblijvend. We beoordelen uw situatie, leggen de mogelijkheden uit en geven u een gedetailleerde offerte. <a href="{contact}">Maak hier een afspraak</a>.' },
      { q: 'En als mijn behandeling meerdere specialisten nodig heeft?', a: 'Elke specialist stelt een diagnose en plant haar deel; alles wordt opgenomen in één offerte voor de volledige behandeling.' },
    ],
    treatEyebrow: 'Behandelingen',
    treatTitle: 'Financier uw behandeling',
    treatAccent: 'zonder rente',
    treatDesc: 'Implantaten, orthodontie, esthetiek… Vraag een vrijblijvende offerte aan en wij stellen een betaalplan op maat voor.',
  },
  fr: {
    title: 'Financement dentaire',
    accent: 'sans intérêts à Vera',
    calendarCaption: 'Vous réglez votre traitement en plusieurs fois, directement avec la clinique.',
    optionsEyebrow: 'Comment payer',
    optionsTitle: 'Modes de paiement',
    optionsAccent: 'pensés pour vous',
    optionsDesc: 'Vous choisissez comment payer. Nous vous expliquons chaque option avec calme, sans petits caractères.',
    options: [
      { title: 'Financement direct à 0 %', desc: 'Sans intérêts pour la plupart des traitements, sans passer par une banque ni un organisme de crédit.' },
      { title: 'Mensualités sur mesure', desc: 'Nous adaptons le plan de paiement à vos possibilités pour que vous commenciez votre traitement au plus vite.' },
      { title: 'Carte ou espèces', desc: 'Si vous le préférez, vous pouvez aussi régler par carte ou en espèces à la clinique.' },
    ],
    stepsLabel: 'Comment ça marche',
    steps: [
      { title: 'Première visite gratuite', desc: 'Nous évaluons votre cas et vous expliquons les options de traitement, sans engagement.' },
      { title: 'Un devis clair', desc: 'Vous recevez un devis détaillé couvrant l’ensemble de votre traitement.' },
      { title: 'Votre plan de paiement', desc: 'Nous fixons ensemble les mensualités, directement avec la clinique et sans banque.' },
      { title: 'Début du traitement', desc: 'Vous commencez au plus vite et réglez petit à petit.' },
    ],
    budgetEyebrow: 'Un seul devis',
    oneQuote: 'Un devis unique',
    allInOne: 'Tout votre traitement',
    qualityEyebrow: 'Une qualité qui dure',
    chartLow: 'Solutions « low-cost »',
    chartQuality: 'Traitement de qualité',
    chartCost: 'Coût cumulé',
    chartTime: 'Années',
    faqEyebrow: 'Questions fréquentes',
    faqTitle: 'Vos questions sur le financement',
    faqs: [
      { q: 'Dois-je demander un prêt à ma banque ?', a: 'Non. Le financement se fait directement avec la clinique, sans banque ni organisme de crédit. Notre conseillère dentaire établit avec vous un plan de paiement sur mesure.' },
      { q: 'Le financement comporte-t-il des intérêts ?', a: 'Pour la plupart des traitements, nous proposons un financement à 0 %, sans intérêts. Nous vous confirmons les conditions de votre plan dans le devis, avant de commencer.' },
      { q: 'Quels moyens de paiement acceptez-vous ?', a: 'Vous pouvez payer par carte, en espèces ou grâce à un plan de financement direct avec la clinique.' },
      { q: 'Combien coûte la première visite ?', a: 'Rien : la première visite est gratuite et sans engagement. Nous évaluons votre cas, vous expliquons les options et vous remettons un devis détaillé. <a href="{contact}">Prenez rendez-vous ici</a>.' },
      { q: 'Et si mon traitement nécessite plusieurs spécialistes ?', a: 'Chaque spécialiste établit son diagnostic et planifie sa partie, et l’ensemble figure dans un devis unique couvrant tout le traitement.' },
    ],
    treatEyebrow: 'Traitements',
    treatTitle: 'Financez votre traitement',
    treatAccent: 'sans intérêts',
    treatDesc: 'Implants, orthodontie, esthétique… Demandez un devis sans engagement et nous vous proposerons un plan de paiement adapté.',
  },
} as const)[lang];

const keywords = t('financiacion.hero.keywords').split('|').map((k) => k.trim());
const faqs = copy.faqs.map((f) => ({ question: f.q, answer: f.a.replace('{contact}', contactHref) }));
const optionIcons = ['calendar', 'sliders', 'card'] as const;

// The specialists that usually share one multidisciplinary quote.
const specialists: TreatmentKey[] = ['implantes', 'periodoncia', 'ortodoncia'];

// Instalment calendar: 12 months, the first ones already paid.
const PAID = 7;
const months = Array.from({ length: 12 }, (_, i) => ({
  n: i + 1,
  x: 40 + (i % 4) * 72,
  y: 112 + Math.floor(i / 4) * 54,
  paid: i < PAID,
  current: i === PAID,
}));

// Cumulative cost over ten years (x: years, y: cost). Low-cost work needs redoing.
const chartX = (year: number) => 44 + year * 33.6;
const chartY = (cost: number) => 206 - cost * 1.7;
const steps = (points: [number, number][]) =>
  points.reduce((d, [year, cost], i) => d + (i === 0 ? `M${chartX(year)} ${chartY(0)}V${chartY(cost)}` : `H${chartX(year)}V${chartY(cost)}`), '') + `H${chartX(10)}`;
const lowCostPath = steps([[0, 30], [2.2, 52], [4.4, 74], [6.6, 96], [8.6, 112]]);
const qualityPath = `M${chartX(0)} ${chartY(0)}V${chartY(58)}C${chartX(3)} ${chartY(59)} ${chartX(7)} ${chartY(61)} ${chartX(10)} ${chartY(62)}`;

// Original strings: some are in capitals, one ends with an emoji and one misspells a name.
// Capitalised strings are shown in sentence case; German keeps its capitalised nouns.
const DE_CASE: Record<string, string> = {
  'EINE KOSTSPIELIGE ZAHNBEHANDLUNG IST KEINE TEURE BEHANDLUNG': 'Eine kostspielige Zahnbehandlung ist keine teure Behandlung',
};
const sentence = (s: string) =>
  s !== s.toUpperCase() ? s : DE_CASE[s] ?? s.toLowerCase().replace(/\p{L}/u, (c) => c.toUpperCase());
const planTitle = t('financiacion.hero.title').replace(/\s*\p{Extended_Pictographic}/gu, '');
const allyText = t('financiacion.ally.p1').replace(/Ell[ée]\s*–\s*Louise Warneres/, 'Ellé-Louise Warner');

const url = absoluteUrl(pathFor('pricing', lang));
const pageSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${url}#webpage`,
  url,
  name: t('financiacion.meta.title'),
  description: t('financiacion.meta.description'),
  inLanguage: HTML_LANG[lang],
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#dentist` },
  significantLink: TREATMENTS.map((tr) => absoluteUrl(pathFor(tr.key, lang))),
});
---

<Layout title={t('financiacion.meta.title')} description={t('financiacion.meta.description')} lang={lang} schema={pageSchema}>
  <Navigation />

  <main id="main">
    <PageHero
      badge={t('financiacion.hero.badge')}
      title={copy.title}
      accent={copy.accent}
      subtitle={t('appointment.desc.main')}
      breadcrumbs={[{ label: t('nav.pricing') }]}
      illustration="pricing"
      illustrationTitle={t('financiacion.image.alt')}
      highlights={[t('trust.5'), t('financiacion.quality.card3.title'), t('trust.7')]}
    />

    <!-- Your financial plan -->
    <section class="section-y relative overflow-hidden bg-white">
      <div class="container-k">
        <div class="grid items-center gap-16 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-6" data-reveal>
            <p class="eyebrow mb-6">{t('nav.pricing')}</p>
            <h2 class="text-[2.35rem] leading-[1.06] sm:text-5xl lg:text-[3.4rem]">{planTitle}</h2>
            <p class="mt-8 border-l-2 border-coral pl-6 text-lg leading-relaxed text-slate-700 md:text-xl">{t('financiacion.hero.p1')}</p>
            <ul class="mt-9 flex flex-wrap gap-2">
              {keywords.map((k) => (
                <li class="rounded-full border border-ocean-900/10 bg-sand px-3.5 py-1.5 text-[13px] text-slate-600">{k}</li>
              ))}
            </ul>
          </div>

          <!-- Instalment calendar -->
          <figure class="relative mx-auto w-full max-w-[520px] lg:col-span-6" data-reveal="right">
            <div class="absolute inset-[6%] rounded-full bg-[radial-gradient(circle,rgba(44,197,210,0.18)_0%,transparent_70%)] blur-2xl" aria-hidden="true"></div>
            <svg class="draw relative w-full" viewBox="0 0 380 304" fill="none" aria-hidden="true">
              <defs>
                <linearGradient id="cal-head" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#0B7C86" />
                  <stop offset="1" stop-color="#143B5C" />
                </linearGradient>
                <linearGradient id="cal-seal" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#FF9AAA" />
                  <stop offset="1" stop-color="#C9304A" />
                </linearGradient>
                <clipPath id="cal-card"><rect x="20" y="40" width="320" height="246" rx="26" /></clipPath>
              </defs>
              <rect x="26" y="50" width="320" height="246" rx="26" fill="#0A1F33" fill-opacity=".08" />
              <rect x="20" y="40" width="320" height="246" rx="26" fill="#fff" stroke="#0A1F33" stroke-opacity=".08" />
              <g clip-path="url(#cal-card)">
                <rect x="20" y="40" width="320" height="56" fill="url(#cal-head)" />
                <rect x="40" y="72" width="200" height="6" rx="3" fill="#fff" fill-opacity=".18" />
                <rect x="40" y="72" width={(200 * PAID) / 12} height="6" rx="3" fill="#8FE3EA" />
              </g>
              {[96, 180, 264].map((x) => (
                <g>
                  <rect x={x - 6} y="26" width="12" height="30" rx="6" fill="#143B5C" />
                  <circle cx={x} cy="51" r="2.5" fill="#fff" fill-opacity=".6" />
                </g>
              ))}
              {months.map(({ paid, current, ...m }) => (
                  <g>
                    <rect
                      x={m.x}
                      y={m.y}
                      width="62"
                      height="44"
                      rx="11"
                      fill={paid ? '#D5F6F8' : '#FBF8F4'}
                      stroke={current ? '#F2617A' : '#0A1F33'}
                      stroke-opacity={current ? 1 : 0.07}
                      stroke-width={current ? 1.6 : 1}
                    />
                    <text x={m.x + 10} y={m.y + 17} font-family="Inter, sans-serif" font-size="10" font-weight="600" fill={paid ? '#0B7C86' : '#94A3B8'}>{String(m.n).padStart(2, '0')}</text>
                    {paid && (
                      <path d={`M${m.x + 33} ${m.y + 27}l5 5 10-11`} stroke="#0B7C86" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" pathLength="1" style={`--dd:${0.4 + m.n * 0.12}s`} />
                    )}
                    {current && <circle cx={m.x + 46} cy={m.y + 26} r="5" fill="#F2617A" class="animate-pulse" />}
                    {!paid && !current && <circle cx={m.x + 46} cy={m.y + 26} r="5" stroke="#CBD5E1" stroke-dasharray="2 2" />}
                  </g>
              ))}
              <g class="animate-float">
                <circle cx="330" cy="62" r="44" fill="#0A1F33" fill-opacity=".12" transform="translate(4 6)" />
                <circle cx="330" cy="62" r="44" fill="url(#cal-seal)" />
                <circle cx="330" cy="62" r="36" stroke="#FFE4E8" stroke-opacity=".7" stroke-dasharray="2 3" />
                <text x="330" y="72" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-size="30" font-weight="600" fill="#fff">0%</text>
              </g>
            </svg>
            <figcaption class="mx-auto mt-4 max-w-sm text-center text-[15px] text-slate-600">
              <span class="mr-2 inline-block h-2 w-2 rounded-full bg-coral align-middle" aria-hidden="true"></span>{copy.calendarCaption}
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Payment options + how it works -->
    <section class="section-y relative overflow-hidden bg-sand">
      <CoralBranch seed={44} color="teal" class="pointer-events-none absolute -right-12 top-12 h-[300px] w-auto opacity-[0.08]" />
      <div class="container-k relative">
        <SectionHeading eyebrow={copy.optionsEyebrow} title={copy.optionsTitle} accent={copy.optionsAccent} description={copy.optionsDesc} split />

        <div class="mt-16 grid gap-5 md:grid-cols-3">
          {copy.options.map((o, i) => (
            <article class:list={['group relative overflow-hidden rounded-[2rem] p-8 md:p-9', i === 0 ? 'bg-ocean text-white shadow-[var(--shadow-premium)]' : 'surface-card']} data-reveal style={`--d:${i * 0.08}s`}>
              {i === 0 && <CoralBranch seed={8} depth={4} color="duo" class="pointer-events-none absolute right-5 top-5 h-24 w-auto opacity-40" />}
              <span class:list={['relative mb-8 flex h-16 w-16 items-center justify-center rounded-2xl', i === 0 ? 'bg-white/10 text-aqua ring-1 ring-white/15' : 'bg-aqua-pale text-accent']}>
                <svg width="34" height="34" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {optionIcons[i] === 'calendar' && (
                    <>
                      <rect x="6" y="9" width="36" height="33" rx="6" />
                      <path d="M6 18h36M15 5v8M33 5v8" />
                      <path d="M14 26h.01M21 26h.01M28 26h.01M14 33h.01M21 33h.01" stroke-width="3" />
                      <path d="m28.5 33.5 2.5 2.5 5-5.5" stroke="#F2617A" stroke-width="2.4" />
                    </>
                  )}
                  {optionIcons[i] === 'sliders' && (
                    <>
                      <path d="M12 6v36M24 6v36M36 6v36" stroke-opacity=".35" />
                      <rect x="7" y="25" width="10" height="7" rx="3.5" fill="currentColor" fill-opacity=".15" />
                      <rect x="19" y="12" width="10" height="7" rx="3.5" fill="#F2617A" stroke="#F2617A" fill-opacity=".25" />
                      <rect x="31" y="30" width="10" height="7" rx="3.5" fill="currentColor" fill-opacity=".15" />
                    </>
                  )}
                  {optionIcons[i] === 'card' && (
                    <>
                      <rect x="4" y="11" width="32" height="22" rx="4.5" />
                      <path d="M4 18h32" />
                      <rect x="9" y="23" width="7" height="5" rx="1.5" />
                      <circle cx="35" cy="34" r="9" fill="#FFE4E8" stroke="#F2617A" />
                      <path d="M37.6 31a3.6 3.6 0 1 0 0 6M31.5 33.2h4.2M31.5 35.4h4.2" stroke="#F2617A" stroke-width="1.6" />
                    </>
                  )}
                </svg>
              </span>
              <h3 class:list={['relative font-sans text-xl font-semibold tracking-tight', i === 0 ? 'text-white' : 'text-ocean-900']}>{o.title}</h3>
              <p class:list={['relative mt-3 text-[15px] leading-relaxed', i === 0 ? 'text-white/70' : 'text-slate-600']}>{o.desc}</p>
            </article>
          ))}
        </div>

        <div class="mt-24 border-t border-ocean-900/[0.08] pt-16">
          <p class="eyebrow mb-12" data-reveal>{copy.stepsLabel}</p>
          <ProcessSteps steps={copy.steps.map((s) => ({ title: s.title, desc: s.desc }))} />
        </div>
      </div>
    </section>

    <!-- Multidisciplinary quote + financial advisor -->
    <section class="relative isolate overflow-hidden bg-ocean text-white">
      <Waves fill="#FBF8F4" flip class="absolute inset-x-0 top-[-1px] z-10" />
      <Waves fill="#ffffff" class="absolute inset-x-0 bottom-[-1px] z-10" />
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <Bubbles count={12} seed={21} />
        <svg class="absolute inset-0 h-full w-full opacity-[0.06]"><defs><pattern id="fin-grid" width="64" height="64" patternUnits="userSpaceOnUse"><path d="M64 0H0V64" fill="none" stroke="#8FE3EA" stroke-width=".6" /></pattern></defs><rect width="100%" height="100%" fill="url(#fin-grid)" /></svg>
      </div>

      <div class="container-k pb-36 pt-32 md:pb-44 md:pt-40">
        <div class="grid gap-16 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-6">
            <SectionHeading eyebrow={copy.budgetEyebrow} title={t('financiacion.multidisciplinary.title')} description={t('financiacion.multidisciplinary.p1')} tone="dark" />

            <!-- Several specialists → one quote (stacked on phones, side by side from sm) -->
            <div class="relative mt-12 flex flex-col items-stretch sm:grid sm:grid-cols-[minmax(0,1fr)_4.5rem_minmax(0,0.9fr)] sm:items-center" data-reveal style="--d:.1s">
              <ul class="grid gap-2 sm:gap-3">
                {specialists.map((key) => (
                  <li>
                    <a href={pathFor(key, lang)} class="group flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.05] p-2.5 pr-3 transition-colors hover:border-aqua/50 hover:bg-white/10">
                      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white/10 text-aqua" style="--icon-accent:#FF9AAA"><TreatmentIcon name={key} size={22} /></span>
                      <span class="min-w-0 text-sm font-semibold leading-tight text-white/90 [overflow-wrap:anywhere]">{t(`nav.treatments.${key}` as any)}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <svg class="draw mx-auto my-1 h-12 w-6 sm:hidden" viewBox="0 0 24 48" fill="none" aria-hidden="true">
                <path d="M12 2v40" stroke="#2CC5D2" stroke-opacity=".75" stroke-width="1.4" stroke-dasharray="1" pathLength="1" />
                <path d="m6 36 6 7 6-7" stroke="#F2617A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" pathLength="1" style="--dd:.8s" />
              </svg>
              <svg class="draw hidden h-full w-full sm:block" viewBox="0 0 80 180" preserveAspectRatio="none" fill="none" aria-hidden="true">
                {[30, 90, 150].map((y, i) => (
                  <path d={`M0 ${y}C40 ${y} 40 90 80 90`} stroke={i === 1 ? '#F2617A' : '#2CC5D2'} stroke-opacity=".75" stroke-width="1.4" vector-effect="non-scaling-stroke" pathLength="1" style={`--dd:${0.3 + i * 0.15}s`} />
                ))}
              </svg>
              <div class="relative mx-auto w-full max-w-[18rem] rounded-2xl bg-white p-5 text-ocean-900 shadow-2xl sm:max-w-none">
                <span class="absolute -right-3 -top-3 flex h-11 w-11 items-center justify-center rounded-full bg-coral-deep text-[13px] font-bold text-white shadow-[var(--shadow-coral)]">0%</span>
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0B7C86" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2.5h12v19l-2-1.4-2 1.4-2-1.4-2 1.4-2-1.4-2 1.4Z" /><path d="M9 8h6M9 12h6M9 16h3" /></svg>
                <p class="font-display mt-3 text-lg leading-tight [overflow-wrap:anywhere]">{copy.oneQuote}</p>
                <p class="mt-1 text-[12px] leading-snug text-slate-500">{copy.allInOne}</p>
                <div class="mt-3 space-y-1.5" aria-hidden="true">
                  <span class="block h-1.5 w-full rounded-full bg-aqua-pale"></span>
                  <span class="block h-1.5 w-4/5 rounded-full bg-aqua-pale"></span>
                  <span class="block h-1.5 w-3/5 rounded-full bg-coral-pale"></span>
                </div>
              </div>
            </div>
          </div>

          <!-- Advisor -->
          <div class="lg:col-span-6" data-reveal="right">
            <div class="relative rounded-[2rem] border border-white/10 bg-white/[0.05] p-8 backdrop-blur-xl md:p-10">
              <div class="flex flex-col gap-6 sm:flex-row sm:items-end">
                <div class="relative w-40 shrink-0">
                  <span class="absolute inset-0 translate-x-2 translate-y-2 rounded-[1.5rem] bg-gradient-to-br from-aqua/50 to-coral/50" aria-hidden="true"></span>
                  <img
                    src="/precio-financiacion/precio-financiacion-dental-vera-almeria.jpg"
                    alt={`Ellé-Louise Warner – ${t('role.advisor')} · ${t('financiacion.image.alt')}`}
                    width="577"
                    height="456"
                    class="relative aspect-[4/5] w-full rounded-[1.5rem] object-cover object-[60%_center]"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div>
                  <p class="eyebrow eyebrow-light">{t('role.advisor')}</p>
                  <h3 class="mt-3 text-3xl text-white md:text-4xl">{t('financiacion.ally.title')}</h3>
                  <p class="mt-2 font-semibold text-white/85">Ellé-Louise Warner</p>
                </div>
              </div>
              <p class="mt-8 leading-relaxed text-white/70">{allyText}</p>
              <figure class="mt-8 border-t border-white/10 pt-8">
                <svg class="h-6 w-8 text-coral" viewBox="0 0 100 80" fill="currentColor" aria-hidden="true"><path d="M0 80V48C0 20 14 4 40 0l4 10C28 16 22 26 22 40h18v40Zm56 0V48C56 20 70 4 96 0l4 10C84 16 78 26 78 40h18v40Z" /></svg>
                <blockquote class="font-display mt-4 text-2xl italic leading-snug text-white md:text-[1.75rem]">{t('financiacion.quote')}</blockquote>
              </figure>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quality is an investment -->
    <section class="section-y relative overflow-hidden bg-white">
      <div class="container-k">
        <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-6" data-reveal>
            <p class="eyebrow mb-6">{copy.qualityEyebrow}</p>
            <h2 class="text-[2.35rem] leading-[1.06] sm:text-5xl lg:text-[3.4rem]">{sentence(t('financiacion.quality.title'))}</h2>
            <p class="mt-8 text-lg leading-relaxed text-slate-600">{t('financiacion.quality.p1')}</p>
            <p class="mt-5 text-lg leading-relaxed text-slate-600">{t('financiacion.quality.p2')}</p>
          </div>

          <figure class="rounded-[2rem] bg-sand p-6 ring-1 ring-ocean-900/5 md:p-9 lg:col-span-6" data-reveal="right">
            <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">{copy.chartCost} (€)</p>
            <svg class="draw mt-3 w-full" viewBox="0 0 400 230" fill="none" aria-hidden="true">
              {[0, 40, 80, 120].map((c) => (
                <path d={`M${chartX(0)} ${chartY(c)}H${chartX(10)}`} stroke="#0A1F33" stroke-opacity=".07" stroke-dasharray="3 4" />
              ))}
              <path d={`M${chartX(0)} ${chartY(0)}H${chartX(10)}`} stroke="#0A1F33" stroke-opacity=".25" />
              {[0, 2, 4, 6, 8, 10].map((y) => (
                <text x={chartX(y)} y="224" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#64748B">{y}</text>
