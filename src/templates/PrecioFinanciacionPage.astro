              <path d={`${qualityPath}V${chartY(0)}H${chartX(0)}Z`} fill="#2CC5D2" fill-opacity=".08" />
              <path d={lowCostPath} stroke="#F2617A" stroke-width="2.6" stroke-linejoin="round" stroke-dasharray="1" pathLength="1" style="--dd:.3s" />
              <path d={qualityPath} stroke="#0B7C86" stroke-width="3" stroke-linecap="round" pathLength="1" style="--dd:.5s" />
              {[2.2, 4.4, 6.6, 8.6].map((y, i) => (
                <circle cx={chartX(y)} cy={chartY([52, 74, 96, 112][i])} r="4" fill="#fff" stroke="#F2617A" stroke-width="2" />
              ))}
              <circle cx={chartX(10)} cy={chartY(62)} r="6" fill="#0B7C86" stroke="#fff" stroke-width="2.5" />
              <circle cx={chartX(10)} cy={chartY(112)} r="6" fill="#F2617A" stroke="#fff" stroke-width="2.5" />
            </svg>
            <figcaption class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-[14px] text-ocean-900">
              <span class="inline-flex items-center gap-2"><span class="h-[3px] w-6 rounded-full bg-accent"></span>{copy.chartQuality}</span>
              <span class="inline-flex items-center gap-2"><span class="h-[3px] w-6 rounded-full bg-coral"></span>{copy.chartLow}</span>
              <span class="ml-auto text-[12px] uppercase tracking-[0.14em] text-slate-500">{copy.chartTime} →</span>
            </figcaption>
          </figure>
        </div>

        <div class="mt-16 grid gap-5 md:grid-cols-3">
          {[
            { title: t('financiacion.quality.card1.title'), desc: t('financiacion.quality.card1.desc'), icon: 'lasting' },
            { title: t('financiacion.quality.card2.title'), desc: t('financiacion.quality.p3'), icon: 'health' },
            { title: t('financiacion.quality.card3.title'), desc: t('financiacion.quality.card3.desc'), icon: 'nobank' },
          ].map((card, i) => (
            <div class="surface-card group p-8" data-reveal style={`--d:${i * 0.08}s`}>
              <span class:list={['mb-6 flex h-14 w-14 items-center justify-center rounded-2xl transition-colors duration-500', i === 1 ? 'bg-coral-pale text-coral-deep group-hover:bg-coral-deep group-hover:text-white' : 'bg-aqua-pale text-accent group-hover:bg-accent group-hover:text-white']}>
                <svg width="30" height="30" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {card.icon === 'lasting' && (
                    <>
                      <path d="M24 24c-4.5-6-8-9-12-9a9 9 0 0 0 0 18c4 0 7.5-3 12-9Zm0 0c4.5 6 8 9 12 9a9 9 0 0 0 0-18c-4 0-7.5 3-12 9Z" />
                      <circle cx="12" cy="24" r="2.2" fill="currentColor" stroke="none" />
                    </>
                  )}
                  {card.icon === 'health' && (
                    <>
                      <path d="M24 41S6 30.5 6 18.5A9.5 9.5 0 0 1 24 13a9.5 9.5 0 0 1 18 5.5C42 30.5 24 41 24 41Z" />
                      <path d="M11 24h7l3-6 4 11 3-5h9" />
                    </>
                  )}
                  {card.icon === 'nobank' && (
                    <>
                      <path d="M6 18 24 8l18 10H6ZM10 22v12M18 22v12M30 22v12M38 22v12M5 38h38" stroke-opacity=".7" />
                      <path d="M8 42 40 10" stroke-width="2.6" />
                    </>
                  )}
                </svg>
              </span>
              <h3 class="font-sans text-xl font-semibold tracking-tight">{card.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-slate-600">{card.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <FaqSection eyebrow={copy.faqEyebrow} title={copy.faqTitle} faqs={faqs} />

    <!-- Treatments you can finance -->
    <section class="section-y relative overflow-hidden bg-white">
      <div class="container-k">
        <SectionHeading eyebrow={copy.treatEyebrow} title={copy.treatTitle} accent={copy.treatAccent} description={copy.treatDesc} split />
        <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {TREATMENTS.map((tr, i) => (
            <li data-reveal style={`--d:${(i % 3) * 0.06}s`}>
              <a href={pathFor(tr.key, lang)} class="group glow-border flex items-center gap-5 rounded-[1.5rem] border border-ocean-900/[0.07] bg-white p-5 shadow-[var(--shadow-soft)] transition-all duration-500 hover:-translate-y-1 hover:shadow-[var(--shadow-elevated)]">
                <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-aqua-pale text-accent transition-colors duration-500 group-hover:bg-accent group-hover:text-white" style="--icon-accent:#F2617A">
                  <TreatmentIcon name={tr.key} size={30} />
                </span>
                <span class="flex-1 text-lg font-semibold tracking-tight text-ocean-900">{t(tr.label as any)}</span>
                <svg class="shrink-0 text-accent transition-transform duration-300 group-hover:translate-x-1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Contact />
  </main>

  <FooterInfo />
</Layout>
