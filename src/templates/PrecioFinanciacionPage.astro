      { title: 'Instalments that suit you', desc: 'We adapt the payment plan to your budget so you can start your treatment as soon as possible.' },
      { title: 'Card or cash', desc: 'If you prefer, you can also pay by card or in cash at the clinic.' },
    ],
    stepsLabel: 'How it works',
    steps: [
      { title: 'Free first visit', desc: 'We assess your case and explain your treatment options, with no obligation.' },
      { title: 'A clear quote', desc: 'You receive a detailed quote covering your whole treatment.' },
      { title: 'Your payment plan', desc: 'We set your instalments together, directly with the clinic and without banks.' },
      { title: 'Start your treatment', desc: 'You start as soon as possible and pay little by little.' },
    ],
    budgetEyebrow: 'One single quote',
    oneQuote: 'One single quote',
    allInOne: 'Your whole treatment',
    qualityEyebrow: 'Quality that lasts',
    chartLow: '“Low-cost” solutions',
    chartQuality: 'Quality treatment',
    chartCost: 'Total cost',
    chartTime: 'Years',
    faqEyebrow: 'FAQ',
    faqTitle: 'Questions about financing',
    faqs: [
      { q: 'Do I need to take out a bank loan?', a: 'No. Financing is arranged directly with the clinic, without banks or finance companies. Our patient advisor will design a payment plan that suits you.' },
      { q: 'Is there any interest?', a: 'For most treatments we offer 0% financing, with no interest. We confirm the terms of your plan in your quote, before you start.' },
      { q: 'Which payment methods do you accept?', a: 'You can pay by card, in cash or through a direct financing plan with the clinic.' },
      { q: 'How much does the first visit cost?', a: 'Nothing: your first visit is free and without obligation. We assess your case, explain your options and give you a detailed quote. <a href="{contact}">Book your visit here</a>.' },
      { q: 'What if my treatment needs several specialists?', a: 'Each specialist makes their diagnosis and plans their part, and everything is set out in a single quote covering your complete treatment.' },
    ],
    treatEyebrow: 'Treatments',
    treatTitle: 'Finance your treatment',
    treatAccent: 'interest-free',
    treatDesc: 'Implants, orthodontics, cosmetic dentistry… Ask for a no-obligation quote and we will suggest a payment plan that suits you.',
  },
  de: {
    title: 'Zahnfinanzierung',
    accent: 'zinsfrei in Vera',
    calendarCaption: 'Sie zahlen Ihre Behandlung in bequemen Raten – direkt mit der Klinik.',
    optionsEyebrow: 'So zahlen Sie',
    optionsTitle: 'Zahlungsmöglichkeiten',
    optionsAccent: 'ganz nach Ihnen',
    optionsDesc: 'Sie entscheiden, wie Sie zahlen. Wir erklären jede Option in Ruhe – ohne Kleingedrucktes.',
    options: [
      { title: 'Direkte 0 % Finanzierung', desc: 'Zinsfrei bei den meisten Behandlungen, ohne Banken oder Finanzinstitute.' },
      { title: 'Raten nach Maß', desc: 'Wir passen den Zahlungsplan an Ihre Möglichkeiten an, damit Sie so bald wie möglich beginnen können.' },
