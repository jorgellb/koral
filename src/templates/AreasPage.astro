import FooterInfo from '../components/FooterInfo.astro';
import Contact from '../components/Contact.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import FaqSection from '../components/ui/FaqSection.astro';
import CoastMap from '../components/svg/CoastMap.astro';
import CoralBranch from '../components/svg/CoralBranch.astro';
import Bubbles from '../components/svg/Bubbles.astro';
import Waves from '../components/svg/Waves.astro';
import { useTranslations } from '../i18n/utils';
import { pathFor, absoluteUrl, HTML_LANG, SITE_URL, TOWN_KEYS, type Lang } from '../i18n/routes';
import { TOWNS, fill } from '../data/towns';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const copy = ({
