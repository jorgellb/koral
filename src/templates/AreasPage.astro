  },
  fr: {
    metaTitle: 'Dentiste dans le Levante Almeriense | Clinique Dentaire Koral',
    metaDesc: 'Clinique dentaire à Vera pour les patients de Garrucha, Mojácar, Cuevas, Turre, Antas, Los Gallardos et Palomares, à moins de 20 min. Nous parlons français.',
    highlight: '8 communes à moins de 20 min',
    townsEyebrow: 'Choisissez votre commune',
    townsTitle: 'Votre clinique dentaire, près de chez vous',
    townsDesc: 'Chaque page vous explique comment venir depuis votre commune, le temps de trajet et comment nous vous accompagnons dès la première visite.',
    chartEyebrow: 'Distances réelles',
    chartTitle: 'Minutes jusqu’à la clinique',
    chartDesc: 'Aucune commune de la région n’est à plus de 20 minutes en voiture de l’Av. de Baria, 4.',
    chartNote: 'Temps de trajet en voiture sans trafic, calculés avec les données d’OpenStreetMap.',
    whyEyebrow: 'Pourquoi venir jusqu’à Vera',
    whyTitle: 'Le court trajet en vaut la peine',
    why: [
      ['Première visite gratuite', 'Bilan complet et devis clair, sans engagement.'],
      ['Toutes les spécialités', 'Implants, orthodontie, endodontie, esthétique, soins pour enfants et plus, au même endroit.'],
