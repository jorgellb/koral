  nl: {
    metaTitle: 'Tandarts in de Levante Almeriense | Tandkliniek Koral',
    metaDesc: 'Tandkliniek in Vera voor patiënten uit Garrucha, Mojácar, Cuevas, Turre, Antas, Los Gallardos en Palomares, binnen 20 min. Wij spreken Nederlands.',
    highlight: '8 plaatsen binnen 20 min',
    townsEyebrow: 'Kies uw plaats',
    townsTitle: 'Uw tandkliniek, dicht bij huis',
    townsDesc: 'Elke pagina laat zien hoe u vanuit uw plaats bij ons komt, hoe lang het duurt en hoe we u vanaf het eerste bezoek begeleiden.',
    chartEyebrow: 'Echte afstanden',
    chartTitle: 'Minuten tot de kliniek',
    chartDesc: 'Geen enkele plaats in de regio ligt meer dan 20 minuten rijden van Av. de Baria, 4.',
    chartNote: 'Rijtijden zonder verkeer, berekend met gegevens van OpenStreetMap.',
    whyEyebrow: 'Waarom patiënten naar Vera komen',
    whyTitle: 'Het korte ritje waard',
    why: [
      ['Gratis eerste bezoek', 'Volledig onderzoek en een duidelijke, vrijblijvende offerte.'],
      ['Alle specialismen', 'Implantaten, orthodontie, wortelkanaalbehandeling, esthetiek, kindertandheelkunde en meer, onder één dak.'],
      ['Wij spreken 5 talen', 'Spaans, Engels, Duits, Nederlands en Frans.'],
      ['0% financiering', 'Betalingsplannen op maat voor de meeste behandelingen.'],
