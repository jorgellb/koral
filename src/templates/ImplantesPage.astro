---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import FooterInfo from '../components/FooterInfo.astro';
import Contact from '../components/Contact.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ProcessSteps from '../components/ui/ProcessSteps.astro';
import FaqSection from '../components/ui/FaqSection.astro';
import RelatedTreatments from '../components/ui/RelatedTreatments.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import CoralBranch from '../components/svg/CoralBranch.astro';
import Bubbles from '../components/svg/Bubbles.astro';
import Waves from '../components/svg/Waves.astro';
import { useTranslations, getLangFromUrl } from '../i18n/utils';
import { pathFor, absoluteUrl, HTML_LANG, SITE_URL } from '../i18n/routes';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = [1, 2, 3, 4, 5, 6, 7].map((n) => ({
  title: t(`implantes.steps.${n}.title` as any),
  desc: t(`implantes.steps.${n}.desc` as any),
}));

const faqs = [1, 2, 3, 4, 5].map((n) => ({
  question: t(`implantes.faq.q${n}.q` as any),
  answer: t(`implantes.faq.q${n}.a` as any),
}));

const conditions = [
  { title: t('implantes.regeneration.diag.title'), desc: t('implantes.regeneration.diag.desc'), icon: 'scan' },
  { title: t('implantes.regeneration.team.title'), desc: t('implantes.regeneration.team.desc'), icon: 'team' },
  { title: t('implantes.regeneration.space.title'), desc: t('implantes.regeneration.space.desc'), icon: 'room' },
];

// Section titles in ui.ts are sometimes written in capitals; show them in sentence case.
const sentence = (s: string) => (s === s.toUpperCase() ? s.charAt(0) + s.slice(1).toLowerCase() : s);

const url = absoluteUrl(pathFor('implantes', lang));
const pageSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  '@id': `${url}#webpage`,
  url,
  name: t('implantes.meta.title'),
  description: t('implantes.meta.description'),
  inLanguage: HTML_LANG[lang],
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: {
    '@type': 'MedicalProcedure',
    name: t('nav.treatments.implantes'),
    procedureType: 'https://schema.org/SurgicalProcedure',
    bodyLocation: 'Mouth',
  },
  provider: { '@id': `${SITE_URL}/#dentist` },
  lastReviewed: '2026-11-11',
});
---

<Layout title={t('implantes.meta.title')} description={t('implantes.meta.description')} lang={lang} schema={pageSchema}>
  <Navigation />

  <main id="main">
    <PageHero
      badge={t('implantes.hero.badge')}
      title={t('nav.treatments.implantes')}
      accent={t('hero.in.vera')}
      subtitle={t('implantes.hero.subtitle')}
      subtitleHtml
      breadcrumbs={[{ label: t('nav.treatments.implantes') }]}
      illustration="implantes"
      illustrationTitle={t('nav.treatments.implantes')}
      highlights={[t('implantes.hero.warranty'), t('implantes.hero.planning'), 'Straumann®']}
    />

    <!-- Experience & philosophy -->
    <section class="section-y relative overflow-clip bg-white">
      <div class="container-k">
        <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-5">
            <div class="lg:sticky lg:top-32">
              <SectionHeading eyebrow={t('implantes.excellence.badge')} title={t('implantes.excellence.title')} />

              <figure class="relative mt-10 rounded-[2rem] bg-sand p-8 md:p-10" data-reveal style="--d:.1s">
                <svg class="absolute -top-5 left-8 h-10 w-12 text-coral" viewBox="0 0 100 80" fill="currentColor" aria-hidden="true"><path d="M0 80V48C0 20 14 4 40 0l4 10C28 16 22 26 22 40h18v40Zm56 0V48C56 20 70 4 96 0l4 10C84 16 78 26 78 40h18v40Z" /></svg>
                <blockquote class="font-display text-xl italic leading-relaxed text-ocean-900 md:text-2xl">
                  {t('implantes.excellence.quote').replace(/^["“]|["”]$/g, '')}
                </blockquote>
                <figcaption class="mt-6 flex items-center gap-3 text-sm">
                  <img src="/equipo/Ana-padilla.jpg" alt="" width="48" height="48" class="h-12 w-12 rounded-full object-cover ring-2 ring-white" loading="lazy" decoding="async" />
                  <span>
                    <span class="block font-semibold text-ocean-900">Dra. Ana Padilla</span>
                    <span class="block text-slate-500">{t('role.director')}</span>
                  </span>
                </figcaption>
              </figure>

              <div class="mt-5 flex gap-4 rounded-[1.5rem] border border-accent/15 bg-aqua-pale/40 p-6" data-reveal style="--d:.15s">
                <svg class="mt-0.5 shrink-0 text-accent" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" /><path d="m9 12 2 2 4-4" /></svg>
                <p class="text-[15px] leading-relaxed text-slate-700">
                  <strong class="font-semibold text-ocean-900">{t('implantes.excellence.honesty.title')}</strong>
                  {' '}{t('implantes.excellence.honesty.desc')}
                </p>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7">
            <div data-reveal>
              <h2 class="text-3xl leading-tight md:text-[2.6rem]">{t('implantes.excellence.slow.title')}</h2>
              <p class="mt-6 text-lg leading-relaxed text-slate-600">{t('implantes.excellence.slow.desc')}</p>
            </div>

            <div class="mt-12 grid gap-5 sm:grid-cols-2">
              <div class="surface-card group p-8" data-reveal>
                <span class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-aqua-pale text-accent transition-colors duration-500 group-hover:bg-accent group-hover:text-white">
                  <svg width="28" height="28" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 8h10l-1.2 26L24 40l-3.8-6L19 8Z" /><path d="M17.5 14l13-2M17.8 20l12.4-2M18.2 26l11.6-2" stroke="#F2617A" /><circle cx="24" cy="24" r="21" stroke-opacity=".25" stroke-dasharray="3 5" /></svg>
                </span>
                <h3 class="font-sans text-xl font-semibold tracking-tight">{t('implantes.excellence.materials.title')}</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-slate-600">{t('implantes.excellence.materials.desc')}</p>
              </div>
              <div class="surface-card group p-8" data-reveal style="--d:.08s">
                <span class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-coral-pale text-coral-deep transition-colors duration-500 group-hover:bg-coral-deep group-hover:text-white">
                  <svg width="28" height="28" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 30c6-8 12-8 18 0s12 8 18 0" /><path d="M6 20c6-8 12-8 18 0s12 8 18 0" stroke-opacity=".4" /><path d="M24 6v6M24 36v6" /></svg>
                </span>
                <h3 class="font-sans text-xl font-semibold tracking-tight">{t('implantes.excellence.invasion.title')}</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-slate-600">{t('implantes.excellence.invasion.desc')}</p>
              </div>
            </div>

            <div class="mt-12 border-l-2 border-coral pl-6" data-reveal>
              <p class="text-lg leading-relaxed text-slate-700">{t('implantes.excellence.definition')}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Step by step -->
    <section class="section-y relative overflow-hidden bg-sand">
      <CoralBranch seed={130} color="teal" class="pointer-events-none absolute -right-10 top-10 h-[280px] w-auto opacity-[0.1]" />
      <div class="container-k relative">
        <SectionHeading eyebrow={t('implantes.steps.badge')} title={t('implantes.steps.title')} align="center" />
        <ProcessSteps steps={steps} class="mt-16" />
        <div class="mx-auto mt-16 flex max-w-3xl flex-col items-center gap-4 rounded-[2rem] bg-white p-8 text-center shadow-[var(--shadow-card)] ring-1 ring-ocean-900/5 sm:flex-row sm:text-left" data-reveal>
          <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-accent text-white">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
          </span>
          <div>
            <p class="font-display text-2xl text-ocean-900">{t('implantes.steps.final.title')}</p>
            <p class="mt-1 text-slate-600">{t('implantes.steps.final.desc')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Bone regeneration -->
    <section class="relative isolate overflow-hidden bg-ocean text-white">
      <Waves fill="#FBF8F4" flip class="absolute inset-x-0 top-[-1px] z-10" />
      <Waves fill="#ffffff" class="absolute inset-x-0 bottom-[-1px] z-10" />
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <Bubbles count={12} seed={33} />
        <svg class="absolute inset-0 h-full w-full opacity-[0.07]"><defs><pattern id="impl-grid" width="64" height="64" patternUnits="userSpaceOnUse"><path d="M64 0H0V64" fill="none" stroke="#8FE3EA" stroke-width=".6" /></pattern></defs><rect width="100%" height="100%" fill="url(#impl-grid)" /></svg>
        <CoralBranch seed={135} color="duo" class="absolute -right-10 bottom-20 h-[260px] w-auto opacity-20" />
      </div>

      <div class="container-k pb-36 pt-32 md:pb-44 md:pt-40">
        <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-6">
            <SectionHeading eyebrow={t('implantes.regeneration.badge')} title={t('implantes.regeneration.title')} description={t('implantes.regeneration.desc')} tone="dark" />
            <ul class="mt-10 space-y-4" data-reveal style="--d:.1s">
              <li class="flex gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-5">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-aqua shadow-[0_0_0_6px_rgba(44,197,210,0.15)]"></span>
                <p class="text-white/75"><strong class="font-semibold text-white">{t('implantes.regeneration.biomaterials.title')}</strong> {t('implantes.regeneration.biomaterials.desc')}</p>
              </li>
              <li class="flex gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-5">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-coral shadow-[0_0_0_6px_rgba(242,97,122,0.15)]"></span>
                <p class="text-white/75"><strong class="font-semibold text-white">{t('implantes.regeneration.autologous.title')}</strong> {t('implantes.regeneration.autologous.desc')}</p>
              </li>
            </ul>
            <p class="mt-8 text-[15px] text-white/60" data-reveal style="--d:.15s">
              <a href={pathFor('cirugia', lang)} class="font-semibold text-aqua-soft underline decoration-aqua/30 underline-offset-4 hover:decoration-aqua">{t('nav.treatments.cirugia')}</a>
              {' · '}
              <a href={pathFor('periodoncia', lang)} class="font-semibold text-aqua-soft underline decoration-aqua/30 underline-offset-4 hover:decoration-aqua">{t('nav.treatments.periodoncia')}</a>
            </p>
          </div>

          <div class="lg:col-span-6" data-reveal="right">
            <div class="rounded-[2rem] border border-white/10 bg-white/[0.05] p-8 backdrop-blur-xl md:p-10">
              <h3 class="text-2xl text-white md:text-3xl">{t('implantes.regeneration.conditions.title')}</h3>
              <ol class="mt-8 space-y-6">
                {conditions.map((c, i) => (
                  <li class="flex items-start gap-5">
                    <span class="font-display flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white text-lg italic text-accent">{i + 1}</span>
                    <div>
                      <p class="font-semibold text-white">{sentence(c.title)}</p>
                      <p class="mt-0.5 text-sm text-white/60">{sentence(c.desc)}</p>
                    </div>
                  </li>
                ))}
              </ol>
              <figure class="mt-10 border-t border-white/10 pt-8">
                <blockquote class="font-display text-lg italic leading-relaxed text-white/85">{t('implantes.regeneration.quote').replace(/^["“]|["”]$/g, '')}</blockquote>
                <figcaption class="mt-3 text-[11px] font-semibold uppercase tracking-[0.2em] text-aqua-soft">{sentence(t('implantes.regeneration.team'))}</figcaption>
              </figure>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="bg-white py-10 md:py-14">
      <CtaBand />
    </div>

    <FaqSection eyebrow={t('implantes.faq.badge')} title={t('implantes.faq.title')} faqs={faqs} />

    <RelatedTreatments current="implantes" />

    <Contact />
  </main>

  <FooterInfo />
</Layout>
