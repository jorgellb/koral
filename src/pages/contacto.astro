---
import { TOWNS } from '../data/towns';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import FooterInfo from '../components/FooterInfo.astro';
import Contact from '../components/Contact.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import CoralBranch from '../components/svg/CoralBranch.astro';
import Bubbles from '../components/svg/Bubbles.astro';
import Waves from '../components/svg/Waves.astro';
import TreatmentIcon from '../components/svg/TreatmentIcon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { consentHtml } from '../i18n/consent';
import { pathFor, absoluteUrl, HTML_LANG, SITE_URL, type TreatmentKey, TOWN_KEYS } from '../i18n/routes';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sendingMsg = t('form.status.sending');
const successMsg = t('contact.form.success');
const errorMsg = t('form.status.error');

const copy = ({
  es: {
    title: 'Contacta con tu dentista',
    emailAction: 'Enviar un email',
    today: 'Hoy',
    openNow: 'Abierto ahora',
    closedNow: 'Cerrado ahora',
    beforeTitle: 'Antes de tu visita',
    beforeDesc: 'Consulta nuestras opciones de financiación al 0 % y descubre los tratamientos que realizamos en la clínica.',
    mapTitle: 'Mapa de Clínica Dental Koral en la Av. de Baria, 4, Vera (Almería)',
  },
  en: {
    title: 'Contact your dentist',
    emailAction: 'Send an email',
    today: 'Today',
    openNow: 'Open now',
    closedNow: 'Closed now',
    beforeTitle: 'Before your visit',
    beforeDesc: 'Have a look at our 0% financing options and the treatments we offer at the clinic.',
    mapTitle: 'Map of Koral Dental Clinic at Av. de Baria 4, Vera (Almería)',
  },
  de: {
    title: 'Kontakt zu Ihrem Zahnarzt',
    emailAction: 'E-Mail senden',
    today: 'Heute',
    openNow: 'Jetzt geöffnet',
    closedNow: 'Jetzt geschlossen',
    beforeTitle: 'Vor Ihrem Besuch',
    beforeDesc: 'Informieren Sie sich über unsere zinsfreie Finanzierung und die Behandlungen, die wir in der Klinik anbieten.',
    mapTitle: 'Karte der Zahnklinik Koral, Av. de Baria 4, Vera (Almería)',
  },
  nl: {
    title: 'Contact met uw tandarts',
    emailAction: 'E-mail sturen',
    today: 'Vandaag',
    openNow: 'Nu open',
    closedNow: 'Nu gesloten',
    beforeTitle: 'Voor uw bezoek',
    beforeDesc: 'Bekijk onze mogelijkheden voor 0% financiering en de behandelingen die we in de kliniek uitvoeren.',
    mapTitle: 'Kaart van Tandkliniek Koral, Av. de Baria 4, Vera (Almería)',
  },
  fr: {
    title: 'Contactez votre dentiste',
    emailAction: 'Envoyer un e-mail',
    today: 'Aujourd’hui',
    openNow: 'Ouvert maintenant',
    closedNow: 'Fermé maintenant',
    beforeTitle: 'Avant votre visite',
    beforeDesc: 'Découvrez nos solutions de financement à 0 % et les traitements que nous réalisons à la clinique.',
    mapTitle: 'Carte de la Clinique Dentaire Koral, Av. de Baria 4, Vera (Almería)',
  },
} as const)[lang];

const stripStar = (s: string) => s.replace(/\*/g, '').trim();
// Some original strings are written in capitals ("¿NECESITAS…?"): show them in sentence case.
// German keeps its capitalised nouns and formal "Sie".
const DE_CASE: Record<string, string> = { 'MÜSSEN SIE UNS KONSULTIEREN?': 'Müssen Sie uns konsultieren?' };
const sentence = (s: string) =>
  s !== s.toUpperCase() ? s : DE_CASE[s] ?? s.toLowerCase().replace(/\p{L}/u, (c) => c.toUpperCase());

const channels = [
  { icon: 'phone', label: stripStar(t('form.phone')), value: '+34 950 39 53 19', action: t('cta.call'), href: 'tel:+34950395319' },
  { icon: 'whatsapp', label: 'WhatsApp', value: '+34 634 68 36 39', action: t('a11y.whatsapp'), href: 'https://wa.me/34634683639', external: true },
  { icon: 'email', label: stripStar(t('form.email')), value: 'koraldentalclinic@gmail.com', action: copy.emailAction, href: 'mailto:koraldentalclinic@gmail.com' },
  {
    icon: 'address',
    label: t('footer.location.title'),
    value: 'Av. de Baria, 4 · 04620 Vera',
    action: t('footer.location.how-to-get'),
    href: 'https://www.google.com/maps/dir/?api=1&destination=Clinica+Dental+Koral+Vera+Almeria',
    external: true,
  },
] as const;

// Opening hours on an 8:00–20:00 timeline. `day` follows Date#getDay (0 = Sunday).
const OPEN_FROM = 8;
const OPEN_TO = 20;
const span = OPEN_TO - OPEN_FROM;
const schedule = [
  { day: 1, label: t('footer.schedule.mon'), from: 10, to: 20 },
  { day: 2, label: t('footer.schedule.tue'), from: 8, to: 16 },
  { day: 3, label: t('footer.schedule.wed'), from: 10, to: 18 },
  { day: 4, label: t('footer.schedule.thu'), from: 8, to: 16 },
  { day: 5, label: t('footer.schedule.fri'), from: 8, to: 16 },
];
const hhmm = (h: number) => `${String(h).padStart(2, '0')}:00`;

const legalRows = [
  ['legal.footer.responsible', 'legal.footer.responsible.desc'],
  ['legal.footer.purpose', 'legal.footer.purpose.desc'],
  ['legal.footer.legalization', 'legal.footer.legalization.desc'],
  ['legal.footer.recipients', 'legal.footer.recipients.desc'],
  ['legal.footer.rights', 'legal.footer.rights.desc'],
  ['legal.footer.additional', 'legal.footer.additional.desc'],
] as const;

const featured: TreatmentKey[] = ['implantes', 'ortodoncia', 'estetica', 'odontopediatria'];
const towns = TOWN_KEYS.map((k) => ({ key: k, name: TOWNS[k].name }));

const field =
  'w-full rounded-2xl border border-ocean-900/10 bg-sand px-5 py-3.5 text-[15px] text-ocean-900 outline-none transition-all placeholder:text-slate-400 hover:border-ocean-900/20 focus:border-accent focus:bg-white focus:ring-4 focus:ring-aqua/15';
const label = 'mb-2 block text-[12px] font-semibold uppercase tracking-[0.14em] text-slate-500';

const url = absoluteUrl(pathFor('contact', lang));
const pageSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${url}#webpage`,
  url,
  name: t('contact.title.meta'),
  description: t('contact.meta.description'),
  inLanguage: HTML_LANG[lang],
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#dentist` },
  mainEntity: { '@id': `${SITE_URL}/#dentist` },
});
---

<Layout title={t('contact.title.meta')} description={t('contact.meta.description')} lang={lang} schema={pageSchema}>
  <Navigation />

  <main id="main">
    <PageHero
      badge={t('contact.channels.title')}
      title={copy.title}
      accent={t('hero.in.vera')}
      subtitle={t('contact.hero.subtitle')}
      breadcrumbs={[{ label: t('nav.contact') }]}
      illustration="contact"
      illustrationTitle={t('nav.contact')}
      highlights={[t('trust.7'), t('trust.6'), 'Av. de Baria, 4 · Vera']}
    />

    <!-- Direct channels -->
    <section class="section-y relative overflow-hidden bg-white">
      <div class="container-k">
        <SectionHeading eyebrow={t('contact.channels.title')} title={sentence(t('contact.channels.subtitle'))} />

        <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {channels.map((c, i) => (
            <li data-reveal style={`--d:${i * 0.07}s`}>
              <a
                href={c.href}
                target={'external' in c ? '_blank' : undefined}
                rel={'external' in c ? 'noopener' : undefined}
                class="group glow-border relative flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-ocean-900/[0.07] bg-white p-7 shadow-[var(--shadow-soft)] transition-all duration-500 hover:-translate-y-1.5 hover:shadow-[var(--shadow-elevated)]"
              >
                <span class="absolute -right-12 -top-12 h-36 w-36 rounded-full bg-[radial-gradient(circle,rgba(44,197,210,0.16)_0%,transparent_70%)] transition-transform duration-700 group-hover:scale-125" aria-hidden="true"></span>
                <span class="relative mb-7 flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-aqua-pale to-white text-accent ring-1 ring-accent/10 transition-all duration-500 group-hover:from-accent group-hover:to-ocean-700 group-hover:text-white">
                  <svg width="34" height="34" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    {c.icon === 'phone' && (
                      <>
                        <path d="M36 32.5v4.4a3 3 0 0 1-3.3 3A30 30 0 0 1 8.1 15.3 3 3 0 0 1 11.1 12h4.4a3 3 0 0 1 3 2.6c.2 1.4.5 2.8 1 4.2a3 3 0 0 1-.7 3.1l-1.9 1.9a24 24 0 0 0 9.4 9.4l1.9-1.9a3 3 0 0 1 3.1-.7c1.4.5 2.8.8 4.2 1a3 3 0 0 1 2.6 3Z" />
                        <path d="M28 8a13 13 0 0 1 12 12M28 14a7 7 0 0 1 6 6" stroke="#F2617A" />
                      </>
                    )}
                    {c.icon === 'whatsapp' && (
                      <>
                        <path d="M24 6a17 17 0 0 0-14.6 25.7L7 41l9.6-2.4A17 17 0 1 0 24 6Z" />
                        <path d="m16.5 24.5 3.5 3.5 6.5-7M24.5 27.5l1 .5 6.5-7" stroke="#F2617A" />
                      </>
                    )}
                    {c.icon === 'email' && (
                      <>
                        <rect x="5" y="11" width="38" height="27" rx="5" />
                        <path d="m6.5 13.5 15.2 11.3a4 4 0 0 0 4.6 0L41.5 13.5" />
                        <circle cx="38" cy="36" r="6" fill="#FFE4E8" stroke="#F2617A" />
                        <path d="M38 33.6c-.6-.8-2.2-.6-2.2.6 0 1 2.2 2.4 2.2 2.4s2.2-1.4 2.2-2.4c0-1.2-1.6-1.4-2.2-.6Z" fill="#F2617A" stroke="none" />
                      </>
                    )}
                    {c.icon === 'address' && (
                      <>
                        <path d="M24 33S13 24.5 13 16a11 11 0 0 1 22 0c0 8.5-11 17-11 17Z" />
                        <circle cx="24" cy="16" r="4" stroke="#F2617A" />
                        <path d="M5 40c3.2-2.4 6.4-2.4 9.6 0s6.4 2.4 9.6 0 6.4-2.4 9.6 0 6.4 2.4 9.2 0" stroke-opacity=".55" />
                      </>
                    )}
                  </svg>
                </span>
                <p class="relative text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">{c.label}</p>
                <p class="relative mt-2 flex-1 text-lg font-semibold leading-snug text-ocean-900" set:html={c.value.replace('@', '<wbr>@')} />
                <span class="relative mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent">
                  {c.action}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Contact form + opening hours -->
    <section class="section-y relative overflow-hidden bg-sand">
      <CoralBranch seed={41} color="coral" class="pointer-events-none absolute -right-10 bottom-0 h-[300px] w-auto opacity-[0.1]" />
      <div class="container-k relative">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-14">
          <div class="lg:col-span-7">
            <SectionHeading eyebrow={t('contact.form.title')} title={sentence(t('contact.hero.title'))} />

            <div class="mt-10 rounded-[2rem] bg-white p-7 shadow-[var(--shadow-card)] ring-1 ring-ocean-900/5 md:p-10" data-reveal style="--d:.1s">
              <form id="simpleContactForm" class="space-y-5" data-type="simple">
                <div>
                  <label for="cf-name" class={label}>{t('form.name')}</label>
                  <input id="cf-name" type="text" name="name" autocomplete="name" placeholder={t('form.placeholder.name')} class={field} required />
                </div>
                <div class="grid gap-5 md:grid-cols-2">
                  <div>
                    <label for="cf-email" class={label}>{t('form.email')}</label>
                    <input id="cf-email" type="email" name="email" autocomplete="email" placeholder={t('form.placeholder.email')} class={field} required />
                  </div>
                  <div>
                    <label for="cf-phone" class={label}>{t('form.phone')}</label>
                    <input id="cf-phone" type="tel" name="phone" autocomplete="tel" placeholder={t('form.placeholder.phone')} class={field} required />
                  </div>
                </div>
                <div>
                  <label for="cf-message" class={label}>{t('contact.form.message')}</label>
                  <textarea id="cf-message" name="message" rows="5" placeholder={t('form.placeholder.message')} class:list={[field, 'resize-y']} required></textarea>
                </div>

                <label class="flex cursor-pointer items-start gap-3 pt-1 text-[13px] leading-relaxed text-slate-500">
                  <input type="checkbox" name="consent" class="mt-0.5 h-5 w-5 shrink-0 rounded border-ocean-900/20 accent-[#0B7C86]" required />
                  <span set:html={consentHtml(lang)} />
                </label>

                <button type="submit" class="btn btn-coral shine-effect w-full !py-4 text-base">
                  {t('contact.form.send')}
                  <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4 20-7Z" /><path d="M22 2 11 13" /></svg>
                </button>
              </form>

              <dl class="mt-9 grid gap-x-8 gap-y-3 border-t border-ocean-900/[0.07] pt-7 text-[12px] leading-relaxed text-slate-500 sm:grid-cols-2">
                {legalRows.map(([term, desc]) => (
                  <div>
                    <dt class="inline font-semibold text-ocean-900">{t(term)}:</dt>
                    <dd class="inline">{t(desc)}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>

          <aside class="space-y-6 lg:col-span-5 lg:pt-4">
            <!-- Opening hours -->
            <div class="relative overflow-hidden rounded-[2rem] bg-ocean p-7 text-white shadow-[var(--shadow-premium)] md:p-9" data-reveal="right">
              <div class="relative flex items-start justify-between gap-4">
                <div class="flex items-center gap-3">
                  <svg class="text-aqua" width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="16" cy="16" r="12.5" /><path d="M16 9v7l4.5 3" /><path d="M16 3.5v2M28.5 16h-2M16 28.5v-2M3.5 16h2" stroke="#FF9AAA" /></svg>
                  <h2 class="text-2xl text-white md:text-3xl">{t('footer.schedule.title')}</h2>
                </div>
                <p class="open-status hidden items-center gap-2 rounded-full bg-white/10 px-3 py-1.5 text-[12px] font-semibold" data-open={copy.openNow} data-closed={copy.closedNow} aria-live="polite">
                  <span class="status-dot h-2 w-2 rounded-full"></span>
                  <span class="status-text"></span>
                </p>
              </div>

              <div class="relative ml-[6.5rem] mr-1 mt-8 h-4 text-[10px] font-semibold tracking-[0.08em] text-white/40" aria-hidden="true">
                {[8, 12, 16, 20].map((h, i, all) => (
                  <span class:list={['tabular absolute top-0', i === 0 ? '' : i === all.length - 1 ? '-translate-x-full' : '-translate-x-1/2']} style={`left:${((h - OPEN_FROM) / span) * 100}%`}>{hhmm(h)}</span>
                ))}
              </div>
              <dl class="relative mt-2 space-y-2.5" id="opening-hours">
                {schedule.map((row) => (
                  <div class="hours-row relative grid grid-cols-[5.75rem_1fr] items-center gap-2 rounded-xl px-1 py-1" data-day={row.day} data-from={row.from} data-to={row.to}>
                    <dt class="text-[14px] text-white/75">{row.label}<span class="today-tag absolute -left-2.5 top-1/2 hidden h-1.5 w-1.5 -translate-y-1/2 rounded-full bg-coral"><span class="sr-only">{copy.today}</span></span></dt>
                    <dd class="relative h-8 rounded-full bg-white/[0.05] ring-1 ring-white/10">
                      <span
                        class="absolute inset-y-1 flex items-center justify-center rounded-full bg-gradient-to-r from-aqua to-accent text-[11.5px] font-semibold text-white"
                        style={`left:${((row.from - OPEN_FROM) / span) * 100}%;right:${((OPEN_TO - row.to) / span) * 100}%`}
                      >
                        <span class="tabular">{hhmm(row.from)}–{hhmm(row.to)}</span>
                      </span>
                    </dd>
                  </div>
                ))}
                <div class="hours-row relative grid grid-cols-[5.75rem_1fr] items-center gap-2 rounded-xl px-1 py-1" data-day="6 0">
                  <dt class="text-[14px] text-white/50">{t('footer.closed')}<span class="today-tag absolute -left-2.5 top-1/2 hidden h-1.5 w-1.5 -translate-y-1/2 rounded-full bg-coral"><span class="sr-only">{copy.today}</span></span></dt>
                  <dd class="flex h-8 items-center justify-center rounded-full border border-dashed border-white/15 text-[12px] font-semibold text-coral-soft">{t('footer.closed.value')}</dd>
                </div>
              </dl>
            </div>

            <!-- Before your visit -->
            <div class="rounded-[2rem] bg-white p-7 shadow-[var(--shadow-soft)] ring-1 ring-ocean-900/5 md:p-9" data-reveal="right" style="--d:.1s">
              <h2 class="text-2xl md:text-3xl">{copy.beforeTitle}</h2>
              <p class="mt-3 text-[15px] leading-relaxed text-slate-600">{copy.beforeDesc}</p>
              <a href={pathFor('pricing', lang)} class="group mt-6 flex items-center gap-4 rounded-2xl bg-coral-pale/60 p-4 transition-colors hover:bg-coral-pale">
                <span class="font-display flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-coral-deep text-lg text-white">0%</span>
                <span class="flex-1 font-semibold text-ocean-900">{t('nav.pricing')}</span>
                <svg class="text-coral-deep transition-transform duration-300 group-hover:translate-x-1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
              <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                {featured.map((key) => (
                  <li>
                    <a href={pathFor(key, lang)} class="group flex items-center gap-3 rounded-2xl border border-ocean-900/[0.07] p-2.5 pr-3 text-[14px] font-semibold text-ocean-900 transition-colors hover:border-accent hover:text-accent">
                      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-aqua-pale text-accent" style="--icon-accent:#F2617A"><TreatmentIcon name={key} size={22} /></span>
                      {t(`nav.treatments.${key}` as any)}
                    </a>
                  </li>
                ))}
              </ul>
              <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold">
                <a href={`${pathFor('home', lang)}#tratamientos`} class="link-u text-accent">{t('related.all')} →</a>
                <a href={pathFor('team', lang)} class="link-u text-accent">{t('team.cta')} →</a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Map -->
    <section class="relative isolate overflow-hidden bg-ocean text-white">
      <Waves fill="#FBF8F4" flip class="absolute inset-x-0 top-[-1px] z-10" />
      <Waves fill="#FBF8F4" class="absolute inset-x-0 bottom-[-1px] z-10" />
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <Bubbles count={10} seed={52} />
      </div>

      <div class="container-k pb-36 pt-32 md:pb-44 md:pt-40">
        <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5">
            <SectionHeading eyebrow={t('areas.eyebrow')} title={t('areas.title')} description={t('areas.desc')} tone="dark" />
            <ul class="mt-8 flex flex-wrap gap-2" data-reveal style="--d:.1s">
              {towns.map((town, i) => (
                <li><a href={pathFor(town.key, lang)} class:list={['inline-block rounded-full px-4 py-2 text-sm transition-colors', i === 0 ? 'bg-coral-deep text-white hover:bg-coral' : 'border border-white/15 bg-white/[0.05] text-white/80 hover:border-aqua hover:text-white']}>{town.name}</a></li>
              ))}
            </ul>
            <address class="mt-10 flex items-start gap-4 not-italic" data-reveal style="--d:.15s">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/[0.07] text-aqua ring-1 ring-white/10">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
              </span>
              <span class="leading-relaxed">
                <span class="block font-semibold text-white">Clínica Dental Koral</span>
                <span class="block text-white/70">Av. de Baria, 4, local · 04620 Vera, Almería</span>
              </span>
            </address>
            <a href="https://www.google.com/maps/dir/?api=1&destination=Clinica+Dental+Koral+Vera+Almeria" target="_blank" rel="noopener" class="btn btn-coral shine-effect mt-8" data-reveal style="--d:.2s">
              {t('footer.location.how-to-get')}
              <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
          </div>

          <div class="lg:col-span-7" data-reveal="scale">
            <div class="relative">
              <div class="absolute -inset-3 rounded-[2.6rem] border border-dashed border-aqua/30" aria-hidden="true"></div>
              <div class="relative overflow-hidden rounded-[2.25rem] bg-ocean-800 shadow-[var(--shadow-premium)] ring-1 ring-white/10">
                <iframe
                  src="https://maps.google.com/maps?q=Cl%C3%ADnica%20Dental%20Koral%2C%20Av.%20de%20Baria%204%2C%2004620%20Vera%2C%20Almer%C3%ADa&z=16&output=embed"
                  title={copy.mapTitle}
                  class="block aspect-[4/5] w-full border-0 sm:aspect-[4/3]"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen
                ></iframe>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Contact />
  </main>

  <FooterInfo />
</Layout>

<script>
  // Highlights today's row and shows whether the clinic is open right now (Spanish time).
  const status = document.querySelector<HTMLElement>('.open-status');
  const rows = document.querySelectorAll<HTMLElement>('#opening-hours .hours-row');
  const parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Madrid', weekday: 'short', hour: 'numeric', minute: 'numeric', hour12: false })
    .formatToParts(new Date())
    .reduce<Record<string, string>>((acc, p) => ({ ...acc, [p.type]: p.value }), {});
  const day = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(parts.weekday);
  const hour = Number(parts.hour) + Number(parts.minute) / 60;
  let open = false;

  rows.forEach((row) => {
    if (!(row.dataset.day || '').split(' ').includes(String(day))) return;
    row.classList.add('bg-white/[0.06]');
    row.querySelector('.today-tag')?.classList.replace('hidden', 'inline-block');
    const from = Number(row.dataset.from);
    const to = Number(row.dataset.to);
    open = hour >= from && hour < to;
  });

  if (status) {
    status.querySelector('.status-text')!.textContent = (open ? status.dataset.open : status.dataset.closed) || '';
    status.querySelector('.status-dot')!.classList.add(open ? 'bg-emerald-400' : 'bg-coral');
    status.classList.replace('hidden', 'inline-flex');
  }
</script>

<script is:inline define:vars={{ sendingMsg, successMsg, errorMsg }}>
  (function () {
    const initForm = () => {
      const form = document.getElementById('simpleContactForm');
      if (!form || form.dataset.bound) return;
      form.dataset.bound = 'true';

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalBtnText = submitBtn ? submitBtn.innerHTML : '';

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = `<span class="flex items-center gap-2">${sendingMsg} <svg class="animate-spin h-5 w-5" viewBox="0 0 24 24" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg></span>`;
        }

        const data = Object.fromEntries(new FormData(form).entries());

        try {
          const response = await fetch('/api/send-email', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(result.error || errorMsg);
          if (window.showToast) window.showToast(successMsg);
          else alert(successMsg);
          form.reset();
        } catch (err) {
          const msg = (err && err.message) || errorMsg;
          if (window.showToast) window.showToast(msg, 'error');
          else alert(msg);
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnText;
          }
        }
      });
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initForm);
    else initForm();
  })();
</script>
