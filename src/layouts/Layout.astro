---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import {
  alternatesFor,
  routeKeyFromPath,
  NOINDEX_ROUTES,
  HTML_LANG,
  OG_LOCALE,
  LANGS,
  SITE_URL,
  absoluteUrl,
  pathFor,
  type Lang,
  type RouteKey,
} from '../i18n/routes';
import '../styles/fonts.css';
import '../styles/global.css';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Toast from '../components/Toast.astro';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  schema?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
}

const urlLang = getLangFromUrl(Astro.url);
const lang = ((Astro.props.lang as Lang) || urlLang) as Lang;
const t = useTranslations(lang);

const {
  title,
  description = t('meta.default.description'),
  schema,
  ogImage = '/og/clinica-dental-koral-vera.jpg',
  ogImageAlt = 'Clínica Dental Koral · Vera, Almería',
} = Astro.props;

const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = absoluteUrl(pathname);
const routeKey = routeKeyFromPath(pathname);
const noindex = Astro.props.noindex || (routeKey ? NOINDEX_ROUTES.includes(routeKey) : false);
const alternates = noindex ? undefined : alternatesFor(pathname);

const fullOgImage = absoluteUrl(ogImage);

// Site-wide entities: the clinic and the website. Pages reference them by @id.
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Dentist',
      '@id': `${SITE_URL}/#dentist`,
      name: 'Clínica Dental Koral',
      alternateName: ['Koral Dental Clinic', 'Zahnklinik Koral', 'Tandkliniek Koral', 'Clinique Dentaire Koral'],
      url: `${SITE_URL}/`,
      logo: `${SITE_URL}/Logo/logokoral.png`,
      image: [`${SITE_URL}/Presentacion/Ana-clinica-koral-vera-almeria.jpg`, fullOgImage],
      description: t('meta.default.description'),
      telephone: '+34950395319',
      email: 'koraldentalclinic@gmail.com',
      priceRange: '€€',
      currenciesAccepted: 'EUR',
      paymentAccepted: 'Cash, Credit Card, Financing',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Av. de Baria, 4, local',
        addressLocality: 'Vera',
        addressRegion: 'Almería',
        postalCode: '04620',
        addressCountry: 'ES',
      },
      geo: { '@type': 'GeoCoordinates', latitude: 37.2372, longitude: -1.8506 },
      hasMap: 'https://www.google.com/maps/place/Cl%C3%ADnica+Dental+Koral/@37.2371629,-1.8531261,17z',
      contactPoint: [
        { '@type': 'ContactPoint', telephone: '+34950395319', contactType: 'customer service', availableLanguage: ['es', 'en', 'de', 'nl', 'fr'] },
        { '@type': 'ContactPoint', telephone: '+34634683639', contactType: 'reservations', availableLanguage: ['es', 'en', 'de', 'nl', 'fr'] },
      ],
      openingHoursSpecification: [
        { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Monday', opens: '10:00', closes: '20:00' },
        { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Tuesday', opens: '08:00', closes: '16:00' },
        { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Wednesday', opens: '10:00', closes: '18:00' },
        { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Thursday', opens: '08:00', closes: '16:00' },
        { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '08:00', closes: '16:00' },
      ],
      areaServed: [
        'Vera', 'Garrucha', 'Mojácar', 'Cuevas del Almanzora', 'Los Gallardos', 'Turre', 'Antas', 'Palomares',
      ].map((name) => ({ '@type': 'City', name })).concat([{ '@type': 'AdministrativeArea', name: 'Levante Almeriense' } as any]),
      medicalSpecialty: ['Dentistry', 'Surgical', 'Pediatric'],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Tratamientos dentales',
        itemListElement: [
          { key: 'implantes', name: 'Implantes dentales Straumann' },
          { key: 'ortodoncia', name: 'Ortodoncia con alineadores transparentes y brackets' },
          { key: 'estetica', name: 'Estética dental y carillas' },
          { key: 'endodoncia', name: 'Endodoncia con microscopio' },
          { key: 'odontopediatria', name: 'Odontopediatría' },
          { key: 'periodoncia', name: 'Periodoncia' },
          { key: 'cirugia', name: 'Cirugía oral' },
          { key: 'rehabilitacion', name: 'Rehabilitación oral' },
          { key: 'armonia', name: 'Armonía orofacial' },
        ].map((s) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: s.name, url: absoluteUrl(pathFor(s.key as RouteKey, 'es')) },
        })),
      },
      founder: {
        '@type': 'Person',
        name: 'Dra. Ana Padilla',
        jobTitle: 'Directora médica · Cirugía, implantología y estética dental',
      },
      sameAs: [
        'https://www.facebook.com/koralclinicadental',
        'https://www.instagram.com/koraldental',
        'https://www.tiktok.com/@koraldental',
      ],
      knowsLanguage: ['es', 'en', 'de', 'nl', 'fr'],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: 'Clínica Dental Koral',
      publisher: { '@id': `${SITE_URL}/#dentist` },
      inLanguage: LANGS.map((l) => HTML_LANG[l]),
    },
  ],
};

---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    {alternates && alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.lang === 'es')!.href} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A1F33" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-normal-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-normal-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-italic-latin.woff2" crossorigin />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Clínica Dental Koral" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Local SEO -->
    <meta name="geo.region" content="ES-AL" />
    <meta name="geo.placename" content="Vera, Almería" />
    <meta name="geo.position" content="37.2372;-1.8506" />
    <meta name="ICBM" content="37.2372, -1.8506" />

    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {schema && <script type="application/ld+json" set:html={schema} />}
  </head>
  <body data-contact-path={pathFor('contact', lang)}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[200] focus:px-5 focus:py-3 focus:rounded-full focus:bg-white focus:text-ocean-900 focus:shadow-xl focus:font-semibold"
    >
      {t('a11y.skip')}
    </a>
    <slot />
    <WhatsAppFloat />
    <CookieBanner />
    <Toast />

    <script>
      // Pages without the appointment form send "book" buttons to the contact page.
      if (!document.getElementById('appointment')) {
        const contactPath = document.body.dataset.contactPath || '/contacto/';
        document.querySelectorAll<HTMLAnchorElement>('a[href="#appointment"]').forEach((a) => {
          a.href = `${contactPath}#appointment`;
        });
      }

      const revealTargets = document.querySelectorAll<HTMLElement>('.fade-up, [data-reveal], .draw, [data-count]');

      const animateCount = (el: HTMLElement) => {
        const target = parseFloat(el.dataset.count || '0');
        const decimals = (el.dataset.count || '').split('.')[1]?.length ?? 0;
        const prefix = el.dataset.prefix || '';
        const suffix = el.dataset.suffix || '';
        const locale = document.documentElement.lang || 'es';
        const duration = 1600;
        const start = performance.now();
        const step = (now: number) => {
          const p = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent =
            prefix +
            (target * eased).toLocaleString(locale, { minimumFractionDigits: decimals, maximumFractionDigits: decimals }) +
            suffix;
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!('IntersectionObserver' in window) || reduceMotion) {
        revealTargets.forEach((el) => el.classList.add('visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              el.classList.add('visible');
              if (el.dataset.count) animateCount(el);
              observer.unobserve(el);
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        );
        revealTargets.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
