---
import { useTranslations, getLangFromUrl } from '../i18n/utils';
import { pathFor } from '../i18n/routes';
import { TEAM } from '../data/team';
import SectionHeading from './ui/SectionHeading.astro';
import CoralBranch from './svg/CoralBranch.astro';
import Picture from './ui/Picture.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative overflow-hidden bg-white">
  <div class="pb-14 pt-10 md:pb-16 md:pt-14">
    <div class="container-k">
      <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading eyebrow={t('team.factor')} title={t('team.title')} />
        <div class="flex items-center gap-3" data-reveal>
          <button type="button" class="team-prev flex h-14 w-14 items-center justify-center rounded-full border border-ocean-900/15 text-ocean-900 transition-all hover:border-ocean-900 hover:bg-ocean-900 hover:text-white disabled:opacity-30" aria-label="←">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
          </button>
          <button type="button" class="team-next flex h-14 w-14 items-center justify-center rounded-full border border-ocean-900/15 text-ocean-900 transition-all hover:border-ocean-900 hover:bg-ocean-900 hover:text-white disabled:opacity-30" aria-label="→">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="team-track mt-14 flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth pb-6 [scrollbar-width:none] md:gap-7" tabindex="0" aria-label={t('team.title')}>
      {TEAM.map((m, i) => (
        <article class="team-card group w-[78vw] max-w-[320px] shrink-0 snap-start sm:w-[300px]" data-reveal style={`--d:${Math.min(i, 4) * 0.06}s`}>
          <div class="relative overflow-hidden rounded-[2rem] bg-sand ring-1 ring-ocean-900/5">
            <Picture
              src={m.image}
              alt={`${m.name} – ${t(m.role)}`}
              width={600}
              height={600}
              class="aspect-[4/5] w-full object-cover saturate-[0.85] transition-all duration-[1.2s] ease-[var(--ease-out-expo)] group-hover:scale-[1.04] group-hover:saturate-100"
            />
            <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-ocean-900/70 to-transparent opacity-0 transition-opacity duration-700 group-hover:opacity-100" aria-hidden="true"></div>
            <CoralBranch seed={90 + i} depth={4} color="white" class="pointer-events-none absolute -bottom-2 right-3 h-24 w-auto translate-y-4 opacity-0 transition-all duration-700 group-hover:translate-y-0 group-hover:opacity-70" />
          </div>
          <h3 class="mt-5 font-sans text-xl font-semibold tracking-tight">{m.name}</h3>
          <p class="mt-1 text-[13px] font-medium uppercase tracking-[0.14em] text-accent">{t(m.role)}</p>
        </article>
      ))}
      <div class="w-px shrink-0" aria-hidden="true"></div>
    </div>

    <div class="container-k mt-8 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="h-[3px] w-full max-w-sm overflow-hidden rounded-full bg-ocean-900/10">
        <div class="team-progress h-full w-1/4 rounded-full bg-gradient-to-r from-aqua to-coral transition-[width] duration-300"></div>
      </div>
      <a href={pathFor('team', lang)} class="link-u text-sm font-semibold text-accent">{t('team.cta')} →</a>
    </div>
  </div>
</section>

<style is:global>
  .team-track {
    padding-inline: max(1.25rem, calc((100vw - 1280px) / 2 + 2rem));
    scroll-padding-inline: max(1.25rem, calc((100vw - 1280px) / 2 + 2rem));
  }
  .team-track::-webkit-scrollbar { display: none; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.team-track').forEach((track) => {
    const section = track.closest('section')!;
    const prev = section.querySelector<HTMLButtonElement>('.team-prev');
    const next = section.querySelector<HTMLButtonElement>('.team-next');
    const progress = section.querySelector<HTMLElement>('.team-progress');
    const step = () => (track.querySelector<HTMLElement>('.team-card')?.offsetWidth ?? 300) + 28;

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const ratio = max > 0 ? track.scrollLeft / max : 1;
      if (progress) progress.style.width = `${Math.max(12, ratio * 100)}%`;
      if (prev) prev.disabled = track.scrollLeft < 8;
      if (next) next.disabled = track.scrollLeft > max - 8;
    };
    prev?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
