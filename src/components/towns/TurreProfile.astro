---
/**
 * Turre — elevation profile of the trip "sierra → sea → clinic". Illustrative
 * heights (no numbers, not to scale); the horizontal axis is the real driving
 * time of the route in src/data/towns.ts, and the coast is placed where the
 * real road geometry reaches its easternmost point. A dashed switchback comes
 * down from the homes on the hills of the sierra to the village.
 */
import { TOWNS } from '../../data/towns';

interface Props {
  title: string;
  labels: { sierra: string; hills: string; coast: string; sea: string; axis: string; start: string; arrive: string };
  lang: string;
  class?: string;
}
const { title, labels, lang, class: className = '' } = Astro.props;

const route = TOWNS.turre.routes[0];
const num = (n: number) => String(n).replace('.', lang === 'en' ? '.' : ',');

// Cumulative distance along the real path → where the road meets the coast
const rad = Math.PI / 180;
const dist = (a: [number, number], b: [number, number]) => {
  const dx = (b[0] - a[0]) * Math.cos(((a[1] + b[1]) / 2) * rad) * 111.32;
  const dy = (b[1] - a[1]) * 110.57;
  return Math.hypot(dx, dy);
};
const cum = route.path.reduce<number[]>((acc, p, i) => [...acc, i ? acc[i - 1] + dist(route.path[i - 1], p) : 0], []);
const total = cum[cum.length - 1];
const eastIdx = route.path.reduce((best, p, i) => (p[0] > route.path[best][0] ? i : best), 0);
const fc = cum[eastIdx] / total;

const W = 1200;
const H = 430;
const X0 = 300; // Turre
const X1 = 1130; // clinic
const base = 330; // sea level
const amp = 210;
const px = (f: number) => X0 + (X1 - X0) * f;
const pyE = (e: number) => base - e * amp;

// Relative elevation along the route (0..1 of the route)
const elev = (f: number) => {
  if (f <= fc) {
    const t = f / fc;
    const s = 1 - t * t * (3 - 2 * t);
    return 0.03 + 0.25 * s + 0.018 * Math.sin(t * Math.PI * 7) * s;
  }
  const t = (f - fc) / (1 - fc);
  return 0.03 + 0.2 * t * t * (3 - 2 * t) + 0.01 * Math.sin(t * Math.PI * 5);
};
const N = 80;
const profilePts = Array.from({ length: N + 1 }, (_, i) => [px(i / N), pyE(elev(i / N))] as const);
const profileD = profilePts.map(([a, b], i) => `${i ? 'L' : 'M'}${a.toFixed(1)} ${b.toFixed(1)}`).join('');

// Sierra silhouette behind Turre
const ridge = [
  [0, 300], [40, 262], [80, 205], [120, 150], [150, 118], [175, 96], [196, 104], [214, 90], [236, 122], [262, 178], [300, pyE(elev(0))],
] as const;
const ridgeD = `M${ridge.map(([a, b]) => `${a} ${b.toFixed(1)}`).join('L')}L300 ${base}L0 ${base}Z`;
const ridge2D = 'M0 330L0 280L60 236L110 210L160 196L210 214L260 248L300 270L330 300L360 330Z';

// Switchback down from the hills of the sierra to the village (illustrative)
const sw = [[120, 162], [178, 176], [132, 200], [206, 214], [160, 238], [236, 250], [196, 270], [300, pyE(elev(0))]] as const;
const swD = sw.map(([a, b], i) => `${i ? 'L' : 'M'}${a} ${b.toFixed(1)}`).join('');

// Minute ticks
const ticks = [0, 5, 10, 15].filter((m) => m < route.min - 1).concat(route.min);
const coastX = px(fc);
const coastY = pyE(elev(fc));
const end = profilePts[N];
const uid = `tur-prof-${Math.random().toString(36).slice(2, 7)}`;
const segA = route.roads.slice(0, 2).join(' · ');
const segB = route.roads.slice(2).join(' · ');
---

<svg viewBox={`0 0 ${W} ${H}`} class:list={['tur-profile', className]} role="img" aria-labelledby={`${uid}-t`}>
  <title id={`${uid}-t`}>{title}</title>
  <defs>
    <linearGradient id={`${uid}-hill`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#8FA98A" stop-opacity=".55" />
      <stop offset="1" stop-color="#8FA98A" stop-opacity=".08" />
    </linearGradient>
    <linearGradient id={`${uid}-road`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#6E8B5E" />
      <stop offset=".5" stop-color="#0B7C86" />
      <stop offset="1" stop-color="#C9304A" />
    </linearGradient>
    <linearGradient id={`${uid}-under`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0B7C86" stop-opacity=".14" />
      <stop offset="1" stop-color="#0B7C86" stop-opacity="0" />
    </linearGradient>
    <pattern id={`${uid}-hatch`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
      <path d="M0 0v7" stroke="#4F6B3A" stroke-opacity=".18" />
    </pattern>
  </defs>

  <!-- Sea band under the coastal stretch -->
  <rect x={coastX - 40} y={base - 2} width={X1 - coastX + 110} height="58" rx="6" fill="#D5F6F8" fill-opacity=".7" />
  {[12, 26, 40].map((o, i) => (
    <path d={`M${coastX - 30} ${base + o}q12-6 24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24 0t24`} fill="none" stroke="#0B7C86" stroke-opacity={0.28 - i * 0.07} />
  ))}
  <text x={coastX + 30} y={base + 48} font-family="Fraunces, Georgia, serif" font-style="italic" font-size="17" fill="#0B7C86">{labels.sea}</text>

  <!-- Sierra -->
  <path d={ridge2D} fill={`url(#${uid}-hatch)`} />
  <path d={ridgeD} fill={`url(#${uid}-hill)`} />
  <path d={ridgeD} fill={`url(#${uid}-hatch)`} />
  <path d={`M${ridge.map(([a, b]) => `${a} ${b.toFixed(1)}`).join('L')}`} fill="none" stroke="#4F6B3A" stroke-width="1.6" stroke-opacity=".7" class="draw-me" pathLength="1" />
  <path d="M207 74l7-12 7 12Z" fill="#4F6B3A" />
  <text x="214" y="50" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-style="italic" font-size="21" fill="#2F4423">{labels.sierra}</text>

  <!-- Switchback from the hills -->
  <path d={swD} fill="none" stroke="#4F6B3A" stroke-width="2.2" stroke-dasharray="5 6" stroke-linecap="round" stroke-linejoin="round" />
  {sw.slice(0, -1).map(([a, b], i) => i % 2 === 0 && <circle cx={a} cy={b} r="3.2" fill="#fff" stroke="#4F6B3A" stroke-width="1.6" />)}
  <text x="20" y="86" font-family="Inter, system-ui, sans-serif" font-size="13" font-weight="600" fill="#4F6B3A">{labels.hills}</text>

  <!-- Route profile -->
  <path d={`${profileD}L${X1} ${base}L${X0} ${base}Z`} fill={`url(#${uid}-under)`} />
  <g class="draw">
    <path id={`${uid}-route`} d={profileD} fill="none" stroke={`url(#${uid}-road)`} stroke-width="5" stroke-linecap="round" stroke-linejoin="round" pathLength="1" style="--dd:.3s" />
  </g>
  <circle r="7" fill="#fff" stroke="#C9304A" stroke-width="2.6" class="tur-car">
    <animateMotion dur="6s" repeatCount="indefinite" begin="2.6s" calcMode="linear" keyPoints="0;1" keyTimes="0;1">
      <mpath href={`#${uid}-route`} />
    </animateMotion>
  </circle>

  <!-- Road labels over each stretch -->
  <g font-family="Inter, system-ui, sans-serif" font-size="12.5" font-weight="600" letter-spacing=".6">
    <text x={(X0 + coastX) / 2} y={pyE(elev(fc / 2)) - 22} text-anchor="middle" fill="#4F6B3A">{segA}</text>
    <text x={(coastX + X1) / 2} y={pyE(elev((fc + 1) / 2)) - 24} text-anchor="middle" fill="#08636B">{segB}</text>
  </g>

  <!-- Stops -->
  <g font-family="Inter, system-ui, sans-serif">
    <circle cx={X0} cy={pyE(elev(0))} r="9" fill="#fff" stroke="#4F6B3A" stroke-width="3.5" />
    <text x={X0 + 16} y={pyE(elev(0)) - 16} font-family="Fraunces, Georgia, serif" font-size="25" fill="#0A1F33">Turre</text>
    <text x={X0} y={pyE(elev(0)) + 34} text-anchor="middle" font-size="11" font-weight="600" letter-spacing="1.4" fill="#4F6B3A">{labels.start.toUpperCase()}</text>

    <circle cx={coastX} cy={coastY} r="7" fill="#fff" stroke="#0B7C86" stroke-width="3" />
    <path d={`M${coastX} ${coastY + 10}V${base - 4}`} stroke="#0B7C86" stroke-dasharray="2 4" />
    <text x={coastX} y={coastY - 18} text-anchor="middle" font-size="12" font-weight="700" letter-spacing="1.6" fill="#08636B">{labels.coast.toUpperCase()}</text>

    <circle cx={end[0]} cy={end[1]} r="30" fill="#F2617A" fill-opacity=".14" class="tur-pulse" />
    <path d={`M${end[0]} ${end[1] + 2}c-7-8.8-11-14.2-11-19.6a11 11 0 0 1 22 0c0 5.4-4 10.8-11 19.6Z`} fill="#C9304A" stroke="#fff" stroke-width="2" />
    <circle cx={end[0]} cy={end[1] - 17} r="4" fill="#fff" />
    <text x={end[0]} y={end[1] - 66} text-anchor="middle" font-family="Fraunces, Georgia, serif" font-style="italic" font-size="25" fill="#0A1F33">Koral · Vera</text>
    <text x={end[0]} y={end[1] - 46} text-anchor="middle" font-size="11" letter-spacing="1.4" fill="#C9304A">{`${labels.arrive.toUpperCase()} · ${num(route.km)} KM`}</text>
  </g>

  <!-- Time axis -->
  <g font-family="Inter, system-ui, sans-serif" class="tabular">
    <path d={`M${X0} 398H${X1}`} stroke="#0A1F33" stroke-opacity=".25" />
    {ticks.map((m) => {
      const tx = X0 + ((X1 - X0) * m) / route.min;
      const last = m === route.min;
      return (
        <g>
          <path d={`M${tx} 391v14`} stroke={last ? '#C9304A' : '#0A1F33'} stroke-opacity={last ? 1 : 0.4} stroke-width={last ? 2 : 1} />
          <text x={tx} y="424" text-anchor="middle" font-size={last ? 14 : 12.5} font-weight={last ? 700 : 500} fill={last ? '#C9304A' : '#475569'}>{m} min</text>
        </g>
      );
    })}
    <text x={X0 - 18} y="402" text-anchor="end" font-size="11.5" letter-spacing="1.2" fill="#64748B">{labels.axis.toUpperCase()}</text>
  </g>
</svg>

<style is:global>
  .tur-profile { display: block; width: 100%; height: auto; }
  .tur-profile .tur-pulse { transform-box: fill-box; transform-origin: center; animation: pulse-ring 2.8s cubic-bezier(0.2, 0.6, 0.4, 1) infinite; }
  @media (prefers-reduced-motion: reduce) {
    .tur-profile .tur-car, .tur-profile .tur-pulse { display: none; }
  }
</style>
