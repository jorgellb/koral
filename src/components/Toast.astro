<div id="toast-container" class="pointer-events-none fixed left-1/2 top-24 z-[100] w-full max-w-md -translate-x-1/2 px-5" role="status" aria-live="polite">
  <div id="toast" class="toast pointer-events-auto flex items-center gap-4 rounded-[1.4rem] border border-ocean-900/[0.06] bg-white p-4 pr-6 shadow-[var(--shadow-premium)]" data-show="false">
    <span id="toast-icon" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl text-white" aria-hidden="true"></span>
    <p id="toast-message" class="text-[15px] font-semibold leading-snug text-ocean-900"></p>
  </div>
</div>

<script is:inline>
  window.showToast = (message, type = 'success') => {
    const toast = document.getElementById('toast');
    const msg = document.getElementById('toast-message');
    const icon = document.getElementById('toast-icon');
    if (!toast || !msg || !icon) return alert(message);
    const ok = type === 'success';
    msg.textContent = message;
    icon.style.background = ok ? '#0B7C86' : '#C9304A';
    icon.innerHTML = ok
      ? '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>'
      : '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 7v6M12 17h.01"/></svg>';
    toast.dataset.show = 'true';
    clearTimeout(window.__toastTimer);
    window.__toastTimer = setTimeout(() => (toast.dataset.show = 'false'), 5000);
  };
</script>

<style is:global>
  .toast {
    opacity: 0;
    transform: translateY(-16px) scale(0.98);
    transition: opacity 0.4s ease, transform 0.6s var(--ease-spring);
  }
  .toast[data-show='true'] {
    opacity: 1;
    transform: none;
  }
</style>
