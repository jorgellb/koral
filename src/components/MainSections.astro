---
import { useTranslations, getLangFromUrl } from '../i18n/utils';
import { ChevronRight, Star, Award, Users } from 'lucide-astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Hero Section -->
<section class="relative min-h-[94vh] flex items-center overflow-hidden bg-primary noise-overlay">
  <div class="absolute inset-0 z-0">
    <img
      src="/Slider imagen/clinica-koral-slider.jpg"
      alt={lang === 'es' ? 'Clinica Dental Koral - Dentista de confianza en Vera, Almeria' : 'Koral Dental Clinic - Trusted dentist in Vera, Almeria'}
      class="w-full h-full object-cover scale-110 animate-[ken-burns_30s_ease-in-out_infinite_alternate] opacity-65"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <!-- Layered overlays: stronger on the left for legibility, fades right to keep photo visible -->
    <div class="absolute inset-0 bg-gradient-to-r from-primary via-primary/75 to-primary/20"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-primary/40 via-transparent to-primary/60"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_15%_45%,rgba(37,99,235,0.18)_0%,transparent_55%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_85%_15%,rgba(201,168,106,0.06)_0%,transparent_50%)]"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10 pt-16 pb-24 md:pt-24 md:pb-16">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      <!-- LEFT: copy -->
      <div class="lg:col-span-7 xl:col-span-7">
        <!-- Trust badge -->
        <div class="fade-up inline-flex items-center gap-3 pl-2 pr-5 py-2 bg-white/[0.06] backdrop-blur-xl rounded-full border border-white/[0.14] mb-10">
          <span class="flex items-center justify-center w-6 h-6 rounded-full bg-accent/20 border border-accent/30">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
            </span>
          </span>
          <span class="text-[11px] font-bold text-white/90 uppercase tracking-[0.24em]">{t('home.hero.badge')}</span>
        </div>

        <!-- Main headline -->
        <h1 class="text-5xl md:text-6xl lg:text-[5.5rem] xl:text-[6rem] text-white font-black mb-8 md:mb-10 leading-[0.95] tracking-[-0.03em] fade-up" style="transition-delay: 0.1s">
          {t('hero.title').split(' ').map((word: string, i: number) => (
            <span class="inline-block" style={`transition-delay: ${i * 0.04}s`}>{word}&nbsp;</span>
          ))}
        </h1>

        <!-- Gold hairline accent -->
        <div class="gold-line max-w-[140px] mb-8 fade-up" style="transition-delay: 0.2s"></div>

        <p class="text-lg md:text-xl text-slate-200/85 mb-10 md:mb-14 leading-relaxed max-w-2xl fade-up font-normal" style="transition-delay: 0.3s">
          {t('hero.subtitle')}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 fade-up" style="transition-delay: 0.4s">
          <a href="#appointment" class="shine-effect relative bg-accent text-white px-9 py-5 rounded-2xl font-bold text-base hover:bg-white hover:text-primary transition-all flex items-center justify-center gap-3 group shadow-[0_18px_40px_-12px_rgba(37,99,235,0.55)] active:scale-[0.98] hover:-translate-y-0.5 ring-1 ring-white/10">
            {t('home.hero.cta.appointment')}
            <ChevronRight class="group-hover:translate-x-1 transition-transform" size={18} />
          </a>
          <a href="#treatments" class="bg-white/[0.04] hover:bg-white/[0.10] text-white px-9 py-5 rounded-2xl font-bold text-base border border-white/[0.16] backdrop-blur-xl transition-all text-center group active:scale-[0.98] hover:-translate-y-0.5 hover:border-white/30">
            {t('home.hero.cta.treatments')}
          </a>
        </div>

        <!-- Trust pillars strip -->
        <div class="grid grid-cols-3 gap-px mt-14 md:mt-16 rounded-2xl overflow-hidden bg-white/[0.06] border border-white/[0.08] backdrop-blur-xl max-w-2xl fade-up" style="transition-delay: 0.6s">
          <div class="px-5 py-5 bg-primary/40">
            <div class="flex items-center gap-2 mb-1.5">
              <Star size={14} class="text-amber-400" fill="currentColor" />
              <span class="text-white font-bold text-sm">5.0</span>
            </div>
            <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-white/50">Google</span>
          </div>
          <div class="px-5 py-5 bg-primary/40">
            <div class="flex items-center gap-2 mb-1.5">
              <Award size={14} class="text-accent" />
              <span class="text-white font-bold text-sm">+10</span>
            </div>
            <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-white/50">{lang === 'es' ? 'años exp.' : lang === 'en' ? 'years exp.' : lang === 'de' ? 'Jahre Erf.' : lang === 'nl' ? 'jaar erv.' : 'ans exp.'}</span>
          </div>
          <div class="px-5 py-5 bg-primary/40">
            <div class="flex items-center gap-2 mb-1.5">
              <Users size={14} class="text-accent" />
              <span class="text-white font-bold text-sm">5</span>
            </div>
            <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-white/50">{lang === 'es' ? 'idiomas' : lang === 'en' ? 'languages' : lang === 'de' ? 'Sprachen' : lang === 'nl' ? 'talen' : 'langues'}</span>
          </div>
        </div>
      </div>

      <!-- RIGHT: floating glass info card -->
      <div class="lg:col-span-5 xl:col-span-5 hidden lg:flex justify-end fade-up" style="transition-delay: 0.5s">
        <div class="relative w-full max-w-sm">
          <!-- Gold accent blob behind -->
          <div class="absolute -inset-6 bg-gradient-to-br from-accent/20 via-accent/5 to-transparent rounded-[3rem] blur-2xl"></div>

          <div class="relative bg-white/[0.06] backdrop-blur-2xl rounded-[2rem] border border-white/[0.14] p-8 shadow-2xl overflow-hidden">
            <!-- Decorative quote -->
            <div class="absolute -top-2 -right-2 text-white/[0.06] text-[140px] leading-none font-display select-none pointer-events-none">"</div>

            <div class="relative">
              <div class="flex items-center gap-1 mb-5">
                {[...Array(5)].map(() => (
                  <Star size={14} class="text-amber-400" fill="currentColor" />
                ))}
              </div>
              <p class="text-white/90 text-base leading-relaxed mb-6 font-light italic font-display">
                "{t('reviews.review1.text')}"
              </p>
              <div class="flex items-center justify-between pt-5 border-t border-white/10">
                <div>
                  <p class="text-white text-sm font-bold">Carmen García</p>
                  <p class="text-white/50 text-[11px] font-medium uppercase tracking-[0.15em] mt-0.5">{t('reviews.review1.treatment')}</p>
                </div>
                <svg class="w-7 h-7 opacity-80" viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 hidden md:flex flex-col items-center gap-3 fade-up" style="transition-delay: 0.8s">
    <span class="text-[10px] font-semibold uppercase tracking-[0.3em] text-white/40">{lang === 'es' ? 'Descubre más' : lang === 'en' ? 'Discover more' : lang === 'de' ? 'Mehr entdecken' : lang === 'nl' ? 'Ontdek meer' : 'Découvrir'}</span>
    <div class="w-6 h-10 border border-white/30 rounded-full flex justify-center p-1.5">
      <div class="w-1 h-1.5 bg-white/60 rounded-full animate-scroll-down"></div>
    </div>
  </div>
</section>

<!-- Presentation Section -->
<section class="section-padding bg-cream relative overflow-hidden" style="background:#faf9f6">
  <!-- Premium decorative elements -->
  <div class="absolute -right-20 top-20 text-slate-200/40 select-none pointer-events-none text-[12vw] font-black uppercase tracking-tighter mix-blend-multiply font-display italic">
    Almería
  </div>
  <div class="absolute -left-10 bottom-10 text-accent/[0.025] select-none pointer-events-none text-[18vw] font-black uppercase tracking-tighter font-display">
    Koral
  </div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-gradient-radial from-accent/[0.03] to-transparent rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="grid lg:grid-cols-12 gap-16 lg:gap-24 items-center">
      <!-- Image column -->
      <div class="lg:col-span-5 fade-up relative">
        <!-- Soft glow behind -->
        <div class="absolute -inset-10 bg-gradient-to-br from-accent/8 via-gold/5 to-transparent rounded-[4rem] -rotate-2 blur-3xl"></div>

        <!-- Decorative gold dot grid -->
        <div class="absolute -top-6 -left-6 grid grid-cols-4 gap-3 opacity-30 pointer-events-none">
          {[...Array(16)].map(() => (
            <span class="w-1 h-1 rounded-full bg-gold"></span>
          ))}
        </div>

        <div class="relative rounded-[2.5rem] overflow-hidden shadow-[0_40px_80px_-20px_rgba(11,18,38,0.25)] border border-white/40 group">
          <img
            src="/Presentacion/Ana-clinica-koral-vera-almeria.jpg"
            alt={lang === 'es' ? 'Dra. Ana Padilla - Directora de Clinica Dental Koral en Vera' : 'Dr. Ana Padilla - Director of Koral Dental Clinic in Vera'}
            class="w-full aspect-[4/5] object-cover scale-[1.03] group-hover:scale-100 transition-transform duration-[2s] ease-out"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary/30 via-transparent to-transparent"></div>

          <!-- Doctor signature overlay -->
          <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
            <p class="font-display italic text-2xl leading-none mb-1.5">Dra. Ana Padilla</p>
            <p class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/70">{lang === 'es' ? 'Directora · Cirugía & Implantología' : lang === 'en' ? 'Director · Surgery & Implantology' : lang === 'de' ? 'Direktorin · Chirurgie' : lang === 'nl' ? 'Directeur · Chirurgie' : 'Directrice · Chirurgie'}</p>
          </div>
        </div>

        <!-- Floating Stats Card -->
        <div class="absolute -bottom-8 -right-4 md:-right-10 bg-white p-7 md:p-8 rounded-[1.75rem] shadow-elevated border border-slate-100 fade-up max-w-[220px]" style="transition-delay: 0.4s">
          <div class="flex items-start gap-3 mb-4">
            <span class="w-9 h-9 bg-accent/8 rounded-xl flex items-center justify-center text-accent shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="m4.93 4.93 14.14 14.14"/><path d="M2 12h20"/><path d="m19.07 4.93-14.14 14.14"/></svg>
            </span>
            <p class="text-accent font-black text-5xl leading-none tracking-tighter">{t('home.presentation.years.value')}</p>
          </div>
          <div class="gold-line mb-3"></div>
          <p class="text-primary font-bold text-[11px] uppercase tracking-[0.2em] leading-snug">{t('home.presentation.years.title')}</p>
          <p class="text-slate-400 text-[11px] font-medium mt-1 leading-snug">{t('home.presentation.years.subtitle')}</p>
        </div>
      </div>

      <!-- Content column -->
      <div class="lg:col-span-7 fade-up" style="transition-delay: 0.2s">
        <span class="eyebrow mb-6">
          <span class="w-6 h-px bg-accent"></span>
          {t('home.presentation.badge')}
        </span>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-primary mb-4 leading-[1.05] tracking-tight mt-4">
          {t('home.presentation.title')}
        </h2>
        <!-- Serif accent under title -->
        <p class="font-display italic text-2xl md:text-3xl text-accent/90 mb-10 leading-tight">{lang === 'es' ? 'donde el detalle marca la diferencia' : lang === 'en' ? 'where every detail matters' : lang === 'de' ? 'wo Details den Unterschied machen' : lang === 'nl' ? 'waar details het verschil maken' : 'où le détail fait la différence'}</p>

        <div class="space-y-7">
          <p class="font-medium text-slate-800 text-xl md:text-[1.4rem] leading-[1.6] border-l-2 border-accent pl-7 py-1">
            {t('home.presentation.lead')}
          </p>
          <p class="text-slate-500 text-lg leading-[1.75] max-w-2xl">
            {t('home.presentation.desc')}
          </p>

          <div class="grid sm:grid-cols-2 gap-5 pt-6">
            <div class="surface-card group p-7">
              <div class="w-12 h-12 bg-accent/8 text-accent rounded-xl flex items-center justify-center mb-5 group-hover:bg-accent group-hover:text-white transition-all duration-500 group-hover:shadow-lg group-hover:shadow-accent/20">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <h3 class="font-bold text-primary text-lg mb-2 tracking-tight">{t('home.presentation.tech.title')}</h3>
              <p class="text-slate-500 text-sm leading-relaxed">{t('home.presentation.tech.desc')}</p>
            </div>
            <div class="surface-card group p-7">
              <div class="w-12 h-12 bg-accent/8 text-accent rounded-xl flex items-center justify-center mb-5 group-hover:bg-accent group-hover:text-white transition-all duration-500 group-hover:shadow-lg group-hover:shadow-accent/20">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              </div>
              <h3 class="font-bold text-primary text-lg mb-2 tracking-tight">{t('home.presentation.team.title')}</h3>
              <p class="text-slate-500 text-sm leading-relaxed">{t('home.presentation.team.desc')}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes ken-burns {
    0% { transform: scale(1); }
    100% { transform: scale(1.15); }
  }
</style>
