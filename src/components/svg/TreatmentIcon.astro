---
/**
 * Line icons for each treatment (48×48 grid). Strokes use `currentColor`;
 * the highlighted detail uses `--icon-accent` (coral by default).
 */
import type { TreatmentKey } from '../../i18n/routes';

interface Props {
  name: TreatmentKey | 'tooth';
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 48, strokeWidth = 1.6, class: className = '' } = Astro.props;

const TOOTH =
  'M16 7c-4.4 0-8 3.4-8 8.6 0 5 2.6 7.9 3.6 13.4.9 5 1.5 11 5 11 3.2 0 3.3-5.6 4.6-9.6.6-1.9 1.6-2.9 2.8-2.9s2.2 1 2.8 2.9c1.3 4 1.4 9.6 4.6 9.6 3.5 0 4.1-6 5-11 1-5.5 3.6-8.4 3.6-13.4C40 10.4 36.4 7 32 7c-3.4 0-5 1.8-8 1.8S19.4 7 16 7Z';
const SPARK = 'M0-5l1.3 3.7L5 0 1.3 1.3 0 5-1.3 1.3-5 0-1.3-1.3Z';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['treatment-icon', className]}
  aria-hidden="true"
  focusable="false"
>
  {name === 'implantes' && (
    <>
      <path d="M15 6c-3.3 0-5.5 2.6-5.5 6 0 3.6 2.4 6 5.4 6h18.2c3 0 5.4-2.4 5.4-6 0-3.4-2.2-6-5.5-6-2.6 0-4.4 1.4-9 1.4S17.6 6 15 6Z" />
      <path d="M19.5 18v4.5h9V18" />
      <path d="M19 22.5h10l-1.2 16.5L24 43l-3.8-4L19 22.5Z" />
      <path d="M18.2 27.2l11.6-1.6M18.6 31.7l10.8-1.6M19 36.2l10-1.6" class="accent" />
    </>
  )}

  {name === 'ortodoncia' && (
    <>
      <path d="M8 12c0-2.8 2.2-5 5-5h4c2.8 0 5 2.2 5 5v12c0 6-1.6 15-4.5 15h-5C9.6 39 8 30 8 24V12Z" />
      <path d="M26 12c0-2.8 2.2-5 5-5h4c2.8 0 5 2.2 5 5v12c0 6-1.6 15-4.5 15h-5C27.6 39 26 30 26 24V12Z" />
      <path d="M3 20h42" class="accent" />
      <rect x="12" y="17" width="6" height="6" rx="1.4" class="accent accent-fill" />
      <rect x="30" y="17" width="6" height="6" rx="1.4" class="accent accent-fill" />
    </>
  )}

  {name === 'estetica' && (
    <>
      <path d={TOOTH} transform="translate(1 5) scale(.86)" vector-effect="non-scaling-stroke" />
      <path d={SPARK} transform="translate(39 8)" class="accent accent-fill" />
      <path d={SPARK} transform="translate(9 6) scale(.6)" class="accent" vector-effect="non-scaling-stroke" />
      <path d="M15 17.5c1.2-2 3-3 5-3.2" />
    </>
  )}

  {name === 'endodoncia' && (
    <>
      <path d={TOOTH} />
      <path d="M18.5 15.6c3-2 8-2 11 0" class="accent" />
      <path d="M20.4 18.5c1 5.6 1 11.4-.8 18.6M27.6 18.5c-1 5.6-1 11.4.8 18.6" class="accent" />
    </>
  )}

  {name === 'odontopediatria' && (
    <>
      <path d={TOOTH} transform="translate(3 6) scale(.82)" vector-effect="non-scaling-stroke" />
      <circle cx="19.6" cy="17.5" r="1.1" fill="currentColor" stroke="none" />
      <circle cx="27.2" cy="17.5" r="1.1" fill="currentColor" stroke="none" />
      <path d="M19.4 21.6c2.3 2.3 5.7 2.3 8 0" />
      <path d="M40 3.5l1.4 3 3.2.4-2.4 2.2.6 3.2-2.8-1.6-2.8 1.6.6-3.2-2.4-2.2 3.2-.4Z" class="accent accent-fill" />
    </>
  )}

  {name === 'periodoncia' && (
    <>
      <path d={TOOTH} />
      <path d="M4 25.5c3.4-3.2 6.6-3.2 9.4 0 1.6 1.8 3.4 2.2 5.2.6M29.4 26.1c1.8 1.6 3.6 1.2 5.2-.6 2.8-3.2 6-3.2 9.4 0" class="accent" />
      <path d="M18.6 26.1c2.4-1.6 4.2-2.2 5.4-2.2s3 .6 5.4 2.2" class="accent" />
    </>
  )}

  {name === 'rehabilitacion' && (
    <>
      <rect x="4" y="9" width="12" height="14" rx="4.5" />
      <rect x="18" y="9" width="12" height="14" rx="4.5" />
      <rect x="32" y="9" width="12" height="14" rx="4.5" />
      <path d="M6 27h36" />
      <path d="M10 23v17M38 23v17" class="accent" />
      <path d="M7.6 31.5h4.8M7.6 35.5h4.8M35.6 31.5h4.8M35.6 35.5h4.8" class="accent" />
    </>
  )}

  {name === 'cirugia' && (
    <>
      <path d={TOOTH} transform="translate(2.4 8.4) scale(.88)" vector-effect="non-scaling-stroke" />
      <path d="M24 13V2.8" class="accent" />
      <path d="M20.2 6.4L24 2.6l3.8 3.8" class="accent" />
    </>
  )}

  {name === 'armonia' && (
    <>
      <path d="M5 28c4.5-6 8.5-9.5 12-9.5 2.6 0 4.6 1.6 7 1.6s4.4-1.6 7-1.6c3.5 0 7.5 3.5 12 9.5-5 6-10.5 9-19 9S10 34 5 28Z" />
      <path d="M5 28c6 1.4 12.6 2 19 2s13-.6 19-2" />
      <path d="M24 3.5c2.6 3.4 4 5.6 4 7.4a4 4 0 0 1-8 0c0-1.8 1.4-4 4-7.4Z" class="accent accent-fill" />
    </>
  )}

  {name === 'tooth' && <path d={TOOTH} />}
</svg>
