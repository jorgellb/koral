---
/**
 * Map of the real driving route from a town to the clinic (OpenStreetMap data
 * in src/data/towns.ts): coastline, road drawn on scroll, a dot that travels
 * along it, origin and clinic markers and a scale bar.
 */
import { TOWNS, CLINIC, COAST } from '../../data/towns';
import type { TownKey } from '../../i18n/routes';

interface Props {
  town: TownKey;
  tone?: 'dark' | 'light';
  seaLabel?: string;
  class?: string;
}

const { town: key, tone = 'dark', seaLabel, class: className = '' } = Astro.props;
const town = TOWNS[key];
const dark = tone === 'dark';

// Bounds of everything we draw
const pts: [number, number][] = [...town.routes.flatMap((r) => r.path), [CLINIC.lon, CLINIC.lat], [town.lon, town.lat]];
let minLon = Math.min(...pts.map((p) => p[0]));
let maxLon = Math.max(...pts.map((p) => p[0]));
let minLat = Math.min(...pts.map((p) => p[1]));
let maxLat = Math.max(...pts.map((p) => p[1]));
const lat0 = ((minLat + maxLat) / 2) * (Math.PI / 180);
const cos = Math.cos(lat0);
const minSpan = 0.028;
const grow = (a: number, b: number, span: number): [number, number] => {
  const mid = (a + b) / 2;
  const half = Math.max(b - a, span) / 2;
  return [mid - half, mid + half];
};
[minLon, maxLon] = grow(minLon, maxLon, minSpan / cos);
[minLat, maxLat] = grow(minLat, maxLat, minSpan);
// padding
const padX = (maxLon - minLon) * 0.2;
const padY = (maxLat - minLat) * 0.2;
minLon -= padX;
maxLon += padX;
minLat -= padY;
maxLat += padY;

const W = 640;
let spanX = (maxLon - minLon) * cos;
let spanY = maxLat - minLat;
let H = Math.round((W * spanY) / spanX);
// keep a pleasant aspect ratio
if (H < 400) {
  [minLat, maxLat] = grow(minLat, maxLat, (400 / W) * spanX);
  spanY = maxLat - minLat;
  H = 400;
} else if (H > 600) {
  [minLon, maxLon] = grow(minLon, maxLon, ((W * spanY) / 600) / cos);
  spanX = (maxLon - minLon) * cos;
  H = 600;
}

const x = (lon: number) => +(((lon - minLon) * cos) / spanX * W).toFixed(1);
const y = (lat: number) => +((maxLat - lat) / spanY * H).toFixed(1);
const line = (path: [number, number][]) => path.map(([lon, lat], i) => `${i ? 'L' : 'M'}${x(lon)} ${y(lat)}`).join('');

const coast = COAST.map(([lat, lon]) => [x(lon), y(lat)] as const);
const coastPath = coast.map(([cx, cy], i) => `${i ? 'L' : 'M'}${cx} ${cy}`).join('');
const seaPath = `${coastPath}L${W * 4} ${coast[coast.length - 1][1]}L${W * 4} ${coast[0][1]}Z`;
const seaVisible = coast.some(([cx, cy]) => cx > 0 && cx < W && cy > -H && cy < H * 2);

const routes = town.routes.map((r) => ({ ...r, d: line(r.path), start: [x(r.path[0][0]), y(r.path[0][1])] as const }));
const clinic = { x: x(CLINIC.lon), y: y(CLINIC.lat) };

// Scale bar: a round number of km close to a fifth of the width
const kmPerPx = ((maxLon - minLon) * 111.32 * cos) / W;
const scaleKm = [0.5, 1, 2, 5].reduce((best, k) => (Math.abs(k / kmPerPx - W / 5) < Math.abs(best / kmPerPx - W / 5) ? k : best), 1);
const scalePx = Math.round(scaleKm / kmPerPx);

const uid = `trm-${key}-${Math.random().toString(36).slice(2, 7)}`;
const c = dark
  ? { land: '#0E2B45', sea: '#0A1F33', grid: '#8FE3EA', coast: '#8FE3EA', text: '#E8F2F5', sub: '#8FE3EA', casing: '#0A1F33' }
  : { land: '#F3ECE3', sea: '#D5F6F8', grid: '#0B7C86', coast: '#0B7C86', text: '#0A1F33', sub: '#0B7C86', casing: '#FFFFFF' };
---

<svg viewBox={`0 0 ${W} ${H}`} class:list={['town-route-map', className]} role="img" aria-labelledby={`${uid}-t`}>
  <title id={`${uid}-t`}>{routes.map((r) => `${r.from} → Clínica Dental Koral: ${r.km} km, ${r.min} min`).join(' · ')}</title>
  <defs>
    <pattern id={`${uid}-dots`} width="14" height="14" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1" fill={c.grid} fill-opacity={dark ? 0.14 : 0.12} />
    </pattern>
    <linearGradient id={`${uid}-road`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2CC5D2" />
      <stop offset="1" stop-color="#F2617A" />
    </linearGradient>
    <radialGradient id={`${uid}-glow`}>
      <stop offset="0" stop-color="#F2617A" stop-opacity=".5" />
      <stop offset="1" stop-color="#F2617A" stop-opacity="0" />
    </radialGradient>
  </defs>

  <rect width={W} height={H} fill={c.land} />
  <rect width={W} height={H} fill={`url(#${uid}-dots)`} />
  {seaVisible && (
    <g>
      <path d={seaPath} fill={c.sea} />
      {[10, 24, 42].map((o, i) => (
        <path d={coast.map(([cx, cy], j) => `${j ? 'L' : 'M'}${cx + o} ${cy}`).join('')} fill="none" stroke={c.coast} stroke-opacity={0.22 - i * 0.05} stroke-dasharray={i === 2 ? '2 7' : undefined} />
      ))}
      <path d={coastPath} fill="none" stroke={c.coast} stroke-opacity=".7" stroke-width="1.5" />
      {seaLabel && (
        <text x={Math.min(W - 24, Math.max(...coast.map((p) => p[0])) + 30)} y={H - 28} text-anchor="end" font-family="Fraunces, Georgia, serif" font-style="italic" font-size="15" fill={c.sub} fill-opacity=".7">{seaLabel}</text>
      )}
    </g>
  )}

  <!-- Secondary routes (e.g. from the beach districts) -->
  {routes.slice(1).map((r) => (
    <g>
      <path d={r.d} fill="none" stroke={c.casing} stroke-width="7" stroke-linecap="round" stroke-linejoin="round" stroke-opacity=".6" />
      <path d={r.d} fill="none" stroke="#2CC5D2" stroke-width="2.5" stroke-dasharray="1 7" stroke-linecap="round" />
    </g>
  ))}

  <!-- Main route -->
  <path d={routes[0].d} fill="none" stroke={c.casing} stroke-width="10" stroke-linecap="round" stroke-linejoin="round" stroke-opacity=".7" />
  <g class="draw">
    <path id={`${uid}-route`} d={routes[0].d} fill="none" stroke={`url(#${uid}-road)`} stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" pathLength="1" style="--dd:.2s" />
  </g>
  <circle r="6" fill="#fff" stroke="#F2617A" stroke-width="2.5" class="route-car">
    <animateMotion dur={`${Math.max(5, routes[0].min * 0.45)}s`} repeatCount="indefinite" begin="2.4s" keyPoints="0;1" keyTimes="0;1" calcMode="linear">
      <mpath href={`#${uid}-route`} />
    </animateMotion>
  </circle>

  <!-- Origins -->
  <g font-family="Inter, system-ui, sans-serif" font-size="13" font-weight="600" fill={c.text}>
    {routes.map((r, i) => {
      const left = r.start[0] > W * 0.6;
      return (
        <g>
          <circle cx={r.start[0]} cy={r.start[1]} r={i === 0 ? 7 : 5.5} fill={c.land} stroke="#2CC5D2" stroke-width="3" />
          <text x={r.start[0] + (left ? -14 : 14)} y={r.start[1] + 4.5} text-anchor={left ? 'end' : 'start'} paint-order="stroke" stroke={c.land} stroke-width="5" stroke-linejoin="round">{r.from}</text>
        </g>
      );
    })}
  </g>

  <!-- Clinic -->
  <g>
    <circle cx={clinic.x} cy={clinic.y} r="38" fill={`url(#${uid}-glow)`} />
    <circle cx={clinic.x} cy={clinic.y} r="12" fill="none" stroke="#F2617A" stroke-width="1.5" class="map-pulse" />
    <path d={`M${clinic.x} ${clinic.y + 2}c-7-8.8-11-14.2-11-19.6a11 11 0 0 1 22 0c0 5.4-4 10.8-11 19.6Z`} fill="#F2617A" stroke="#fff" stroke-width="2" />
    <circle cx={clinic.x} cy={clinic.y - 17} r="4" fill="#fff" />
    <text
      x={clinic.x + (clinic.x > W * 0.7 ? -18 : 18)}
      y={clinic.y - 22}
      text-anchor={clinic.x > W * 0.7 ? 'end' : 'start'}
      font-family="Fraunces, Georgia, serif"
      font-size="20"
      font-style="italic"
      fill={c.text}
      paint-order="stroke"
      stroke={c.land}
      stroke-width="5">Koral</text>
    <text
      x={clinic.x + (clinic.x > W * 0.7 ? -18 : 18)}
      y={clinic.y - 6}
      text-anchor={clinic.x > W * 0.7 ? 'end' : 'start'}
      font-family="Inter, system-ui, sans-serif"
      font-size="10"
      letter-spacing="1.4"
      fill="#F2617A"
      paint-order="stroke"
      stroke={c.land}
      stroke-width="4">AV. DE BARIA, 4 · VERA</text>
  </g>

  <!-- Scale + north -->
  <g transform={`translate(24 ${H - 26})`} font-family="Inter, system-ui, sans-serif" font-size="10" fill={c.sub}>
    <path d={`M0 0h${scalePx}M0 -5v10M${scalePx} -5v10`} stroke={c.sub} stroke-width="1.5" />
    <text x={scalePx / 2} y="-9" text-anchor="middle">{scaleKm} km</text>
  </g>
  <g transform={`translate(${W - 30} 34)`} fill="none" stroke={c.sub} stroke-opacity=".6">
    <circle r="14" />
    <path d="M0-10l4 10-4 10-4-10Z" fill={c.sub} fill-opacity=".3" />
    <text y="-19" text-anchor="middle" font-family="Inter, sans-serif" font-size="9" fill={c.sub} stroke="none">N</text>
  </g>
</svg>

<style is:global>
  .town-route-map { display: block; width: 100%; height: auto; }
  .town-route-map .map-pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse-ring 2.6s cubic-bezier(0.2, 0.6, 0.4, 1) infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .town-route-map .route-car, .town-route-map .map-pulse { display: none; }
  }
</style>
