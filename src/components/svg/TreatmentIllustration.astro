---
/**
 * Hero illustrations for treatment / info pages ("Coral & Mediterranean").
 * One inline SVG (viewBox 480×480): a shared backdrop (halo, blob, rings, coral
 * sprigs, rising bubbles) plus one subject group per `name`.
 * Every id is prefixed `ti-${name}-` so several illustrations can share a page.
 */
type Name =
  | 'implantes'
  | 'ortodoncia'
  | 'estetica'
  | 'endodoncia'
  | 'odontopediatria'
  | 'periodoncia'
  | 'rehabilitacion'
  | 'cirugia'
  | 'armonia'
  | 'team'
  | 'pricing'
  | 'contact'
  | 'legal';

interface Props {
  name: Name;
  class?: string;
  /** Accessible title; when absent the SVG is decorative (aria-hidden). */
  title?: string;
}

const { name, class: className, title } = Astro.props;

const id = (s: string) => `ti-${name}-${s}`;
const url = (s: string) => `url(#${id(s)})`;
const ref = (s: string) => `#${id(s)}`;
const titleId = id('title');

type Pt = [number, number];
const f = (n: number) => Math.round(n * 10) / 10;
const rad = (deg: number) => (deg * Math.PI) / 180;

const rotPt = ([x, y]: Pt, deg: number, [px, py]: Pt = [0, 0]): Pt => {
  const c = Math.cos(rad(deg));
  const s = Math.sin(rad(deg));
  return [px + (x - px) * c - (y - py) * s, py + (x - px) * s + (y - py) * c];
};

/** Catmull-Rom → cubic Bézier through the given points. */
const smooth = (pts: Pt[]) => {
  let d = `M${f(pts[0][0])} ${f(pts[0][1])}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    d += `C${f(p1[0] + (p2[0] - p0[0]) / 6)} ${f(p1[1] + (p2[1] - p0[1]) / 6)} ${f(p2[0] - (p3[0] - p1[0]) / 6)} ${f(p2[1] - (p3[1] - p1[1]) / 6)} ${f(p2[0])} ${f(p2[1])}`;
  }
  return d;
};

/** Four-point sparkle star. */
const star4 = (cx: number, cy: number, r: number) => {
  const k = r * 0.14;
  return `M${cx} ${cy - r}Q${f(cx + k)} ${f(cy - k)} ${cx + r} ${cy}Q${f(cx + k)} ${f(cy + k)} ${cx} ${cy + r}Q${f(cx - k)} ${f(cy + k)} ${cx - r} ${cy}Q${f(cx - k)} ${f(cy - k)} ${cx} ${cy - r}Z`;
};

/** Five-point star. */
const star5 = (cx: number, cy: number, r: number) =>
  Array.from({ length: 10 }, (_, i) => {
    const a = rad(-90 + i * 36);
    const rr = i % 2 ? r * 0.46 : r;
    return `${i ? 'L' : 'M'}${f(cx + rr * Math.cos(a))} ${f(cy + rr * Math.sin(a))}`;
  }).join('') + 'Z';

/** Scalloped seal / badge outline. */
const scallop = (cx: number, cy: number, r: number, n: number) => {
  const pts = Array.from({ length: n }, (_, i): Pt => {
    const a = rad(-90 + (i * 360) / n);
    return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
  });
  const br = f(r * Math.sin(Math.PI / n) * 1.08);
  return `M${f(pts[0][0])} ${f(pts[0][1])}${pts
    .map((_, i) => {
      const p = pts[(i + 1) % n];
      return `A${br} ${br} 0 0 1 ${f(p[0])} ${f(p[1])}`;
    })
    .join('')}Z`;
};

/** Implant screw: tapered body with triangular threads; returns outline + crest lines. */
const screw = (cx: number, y0: number, y1: number, r0: number, r1: number, p: number, t: number) => {
  const rAt = (y: number) => r0 + (r1 - r0) * ((y - y0) / (y1 - y0));
  const n = Math.floor((y1 - 12 - y0 - 6 - p * 1.3) / p) + 1;
  let right = '';
  let left = '';
  let crests = '';
  for (let i = 0; i < n; i++) {
    const y = y0 + 6 + i * p;
    right += `L${f(cx + rAt(y))} ${f(y)}L${f(cx + rAt(y) + t)} ${f(y + p * 0.4)}L${f(cx + rAt(y + p * 0.8))} ${f(y + p * 0.8)}`;
    const yl = y + p / 2;
    crests += `M${f(cx - rAt(yl) - t + 1)} ${f(yl + p * 0.4)}L${f(cx + rAt(y) + t - 1)} ${f(y + p * 0.4)}`;
  }
  for (let i = n - 1; i >= 0; i--) {
    const y = y0 + 6 + p / 2 + i * p;
    left += `L${f(cx - rAt(y + p * 0.8))} ${f(y + p * 0.8)}L${f(cx - rAt(y) - t)} ${f(y + p * 0.4)}L${f(cx - rAt(y))} ${f(y)}`;
  }
  const outline = `M${f(cx - r0)} ${y0}L${f(cx + r0)} ${y0}${right}L${f(cx + r1)} ${y1 - 12}C${f(cx + r1)} ${y1 + 2} ${f(cx - r1)} ${y1 + 2} ${f(cx - r1)} ${y1 - 12}${left}Z`;
  return { outline, crests };
};

/** Front-view lower incisor crown: incisal edge at y=0, cervical at y=h. */
const lowerIncisor = (w: number, h: number) => {
  const a = w / 2;
  return `M${f(-a * 0.9)} 2Q0 -3 ${f(a * 0.9)} 2C${f(a)} 3 ${f(a * 1.04)} 9 ${f(a * 1.02)} 16C${f(a * 0.98)} ${f(h * 0.5)} ${f(a * 0.72)} ${f(h * 0.9)} ${f(a * 0.56)} ${f(h)}Q0 ${f(h * 1.06)} ${f(-a * 0.56)} ${f(h)}C${f(-a * 0.72)} ${f(h * 0.9)} ${f(-a * 0.98)} ${f(h * 0.5)} ${f(-a * 1.02)} 16C${f(-a * 1.04)} 9 ${f(-a)} 3 ${f(-a * 0.9)} 2Z`;
};

/** Side-view posterior crown with `cusps` bumps on top. */
const crownSide = (cx: number, w: number, top: number, bot: number, cusps: number) => {
  const h = bot - top;
  const xl = cx - w * 0.46;
  const xr = cx + w * 0.46;
  const yv = top + h * 0.14;
  const step = (xr - xl) / cusps;
  let d = `M${f(cx - w * 0.36)} ${bot}C${f(cx - w * 0.5)} ${f(bot - h * 0.2)} ${f(cx - w * 0.52)} ${f(top + h * 0.42)} ${f(xl)} ${f(yv)}`;
  for (let i = 0; i < cusps; i++) {
    const x0 = xl + i * step;
    d += `C${f(x0 + step * 0.12)} ${f(top - h * 0.05)} ${f(x0 + step * 0.88)} ${f(top - h * 0.05)} ${f(x0 + step)} ${f(yv)}`;
  }
  return `${d}C${f(cx + w * 0.52)} ${f(top + h * 0.42)} ${f(cx + w * 0.5)} ${f(bot - h * 0.2)} ${f(cx + w * 0.36)} ${bot}Q${cx} ${f(bot + h * 0.06)} ${f(cx - w * 0.36)} ${bot}Z`;
};

/* Molar (two roots), local origin at the cervical centre; crown up to y≈-112, roots to y≈128. */
const MOLAR =
  'M-60 0C-68 -16 -78 -38 -77 -62C-76 -90 -62 -110 -40 -112C-24 -113 -14 -100 0 -100C14 -100 24 -113 40 -112C62 -110 76 -90 77 -62C78 -38 68 -16 60 0C57 36 54 84 45 116C42 128 29 130 25 118C18 84 13 58 0 48C-13 58 -18 84 -25 118C-29 130 -42 128 -45 116C-54 84 -57 36 -60 0Z';
const MOLAR_ENAMEL =
  'M-60 0C-68 -16 -78 -38 -77 -62C-76 -90 -62 -110 -40 -112C-24 -113 -14 -100 0 -100C14 -100 24 -113 40 -112C62 -110 76 -90 77 -62C78 -38 68 -16 60 0L52 -6C58 -22 64 -42 63 -62C62 -84 52 -96 38 -97C26 -98 16 -86 0 -86C-16 -86 -26 -98 -38 -97C-52 -96 -62 -84 -63 -62C-64 -42 -58 -22 -52 -6Z';
const MOLAR_PULP =
  'M-30 -14C-34 -32 -33 -56 -27 -68C-24 -75 -17 -73 -15 -64C-10 -56 10 -56 15 -64C17 -73 24 -75 27 -68C33 -56 34 -32 30 -14C30 -10 28 -8 26 -6C34 24 39 76 37 121L33 121C32 80 24 34 12 -4C6 -8 -6 -8 -12 -4C-24 34 -32 80 -33 121L-37 121C-39 76 -34 24 -26 -6C-28 -8 -30 -10 -30 -14Z';
const MOLAR_GLOSS = 'M-62 -34C-68 -60 -60 -88 -42 -100';
/* Front-view upper central incisor / canine crowns, local origin at the cervical centre (≈124×186). */
const INCISOR =
  'M-40 6C-22 -10 22 -10 40 6C52 14 60 50 62 100C63 130 62 156 56 168C52 176 44 178 34 178C18 180 -18 180 -34 178C-46 178 -54 174 -58 166C-62 150 -63 128 -62 100C-60 50 -52 14 -40 6Z';
const CANINE =
  'M-40 6C-22 -10 22 -10 40 6C52 14 60 50 62 96C63 120 58 140 46 156C34 170 14 182 0 186C-14 182 -34 170 -46 156C-58 140 -63 120 -62 96C-60 50 -52 14 -40 6Z';
/* Baby molar: plumper crown, short splayed roots. */
const BABY =
  'M-58 0C-72 -14 -82 -40 -80 -64C-78 -92 -60 -108 -38 -108C-22 -108 -14 -98 0 -98C14 -98 22 -108 38 -108C60 -108 78 -92 80 -64C82 -40 72 -14 58 0C56 24 52 48 42 64C36 72 28 70 26 60C22 44 14 34 0 32C-14 34 -22 44 -26 60C-28 70 -36 72 -42 64C-52 48 -56 24 -58 0Z';

/* Coral sprig growing upward from (0,0); tips are zero-length round-capped dots. */
const SPRIG =
  'M0 0C1 -14 -3 -28 1 -42C4 -52 3 -62 -1 -72M0 -20C-8 -24 -14 -32 -16 -44M-11 -30C-19 -32 -24 -37 -26 -44M2 -38C10 -41 16 -48 18 -58M2 -54C-4 -58 -8 -62 -10 -68';
const SPRIG_DOTS = 'M-1 -72h0M-16 -44h0M-26 -44h0M18 -58h0M-10 -68h0';

/* ---------- gradients (only the ones a variant uses are emitted) ---------- */
type Stop = [offset: number, color: string, opacity?: number];
type Grad = { stops: Stop[]; radial?: boolean; dir?: 'h' | 'd'; cy?: number; r?: number };
const GRADIENTS: Record<string, Grad> = {
  halo: { radial: true, stops: [[0, '#2CC5D2', 0.3], [0.55, '#2CC5D2', 0.1], [1, '#2CC5D2', 0]] },
  glow: { radial: true, stops: [[0, '#F2617A', 0.22], [1, '#F2617A', 0]] },
  shadow: { radial: true, stops: [[0, '#0A1F33', 0.7], [1, '#0A1F33', 0]] },
  blob: { dir: 'd', stops: [[0, '#1C5175', 0.55], [1, '#143B5C', 0.1]] },
  enamel: { stops: [[0, '#FFFFFF'], [0.55, '#F4FAFB'], [1, '#E3EEF1']] },
  shade: { dir: 'h', stops: [[0.55, '#1C5175', 0], [1, '#1C5175', 0.26]] },
  coral: { stops: [[0, '#FF9AAA'], [1, '#F2617A']] },
  aqua: { stops: [[0, '#8FE3EA'], [1, '#2CC5D2']] },
  bone: { stops: [[0, '#F3ECE3'], [1, '#E6D8C6']] },
  metal: { dir: 'h', stops: [[0, '#1C5175'], [0.3, '#D5F6F8'], [0.44, '#FFFFFF'], [0.66, '#E3EEF1'], [1, '#1C5175']] },
  pink: { stops: [[0, '#FFE4E8'], [1, '#FF9AAA']] },
  lipUp: { stops: [[0, '#F2617A'], [1, '#FF9AAA']] },
  gumFade: { stops: [[0, '#FF9AAA', 0], [0.5, '#FF9AAA', 0.9], [1, '#F2617A']] },
  veneer: { dir: 'd', stops: [[0, '#FFFFFF', 0.8], [0.5, '#D5F6F8', 0.35], [1, '#8FE3EA', 0.2]] },
  frame: { radial: true, cy: 0.35, r: 0.7, stops: [[0, '#1C5175'], [1, '#0E2B45']] },
};
const TOOTH = ['enamel', 'shade'];
const NEEDS: Record<Name, string[]> = {
  implantes: [...TOOTH, 'coral', 'bone', 'metal'],
  ortodoncia: [...TOOTH, 'coral', 'metal'],
  estetica: [...TOOTH, 'gumFade', 'veneer'],
  endodoncia: [...TOOTH, 'bone', 'aqua'],
  odontopediatria: [...TOOTH, 'coral'],
  periodoncia: [...TOOTH, 'coral', 'bone'],
  rehabilitacion: [...TOOTH, 'coral', 'bone', 'metal', 'pink'],
  cirugia: [...TOOTH, 'coral', 'bone', 'metal'],
  armonia: ['coral', 'aqua', 'lipUp'],
  team: ['enamel', 'coral', 'aqua', 'frame'],
  pricing: ['enamel', 'coral', 'aqua', 'bone'],
  contact: ['enamel', 'coral', 'aqua'],
  legal: ['enamel', 'aqua'],
};
const grads = ['halo', 'glow', 'shadow', 'blob', ...NEEDS[name]].map((key) => ({ key, ...GRADIENTS[key] }));

/* ---------- shared backdrop config ---------- */
type Sprig = { x: number; y: number; r: number; s: number; c: 'coral' | 'aqua' };
const DEFAULT_SPRIGS: Sprig[] = [
  { x: 84, y: 426, r: -16, s: 1, c: 'coral' },
  { x: 404, y: 432, r: 14, s: 0.76, c: 'aqua' },
];
const SCENE: Record<Name, { blob: number; sprigs?: Sprig[] }> = {
  implantes: { blob: 0 },
  ortodoncia: { blob: 40 },
  estetica: { blob: 80 },
  endodoncia: { blob: 120 },
  odontopediatria: { blob: 160, sprigs: [{ x: 74, y: 418, r: -20, s: 0.9, c: 'aqua' }, { x: 108, y: 430, r: 8, s: 0.6, c: 'coral' }] },
  periodoncia: { blob: 200 },
  rehabilitacion: { blob: 240 },
  cirugia: { blob: 280, sprigs: [{ x: 66, y: 448, r: -18, s: 0.85, c: 'coral' }, { x: 420, y: 450, r: 16, s: 0.66, c: 'aqua' }] },
  armonia: { blob: 320 },
  team: { blob: 20, sprigs: [{ x: 92, y: 384, r: -26, s: 1.05, c: 'coral' }, { x: 388, y: 384, r: 24, s: 1, c: 'aqua' }, { x: 312, y: 142, r: 36, s: 0.62, c: 'coral' }] },
  pricing: { blob: 100 },
  contact: { blob: 60 },
  legal: { blob: 140, sprigs: [{ x: 150, y: 384, r: -28, s: 1, c: 'coral' }, { x: 404, y: 432, r: 14, s: 0.7, c: 'aqua' }] },
};
const scene = SCENE[name];
const sprigs = scene.sprigs ?? DEFAULT_SPRIGS;

const BUBBLES = [
  { x: 92, y: 152, r: 4, o: -2, fill: false },
  { x: 66, y: 292, r: 6.5, o: -6, fill: true },
  { x: 132, y: 412, r: 3, o: -1, fill: false },
  { x: 390, y: 90, r: 5, o: -4, fill: false },
  { x: 418, y: 232, r: 3.5, o: -3, fill: true },
  { x: 404, y: 352, r: 7, o: -7, fill: false },
  { x: 318, y: 440, r: 3, o: -5, fill: true },
  { x: 170, y: 62, r: 2.5, o: -2.5, fill: true },
];
const bubbleStyle = (b: (typeof BUBBLES)[number]) => `animation-delay:${b.o}s`;

/* ---------- variant geometry ---------- */

// implantes
const implantScrew = screw(240, 262, 388, 21, 14, 15, 8);
const IMPLANT_PORES: [number, number, number][] = [
  [160, 312, 6], [186, 336, 4], [162, 356, 4.5], [192, 374, 3.5], [196, 306, 2.5],
  [300, 316, 5], [324, 338, 6], [318, 302, 3], [298, 366, 4], [320, 368, 3], [290, 346, 2.5],
];

// ortodoncia — lower incisors, slightly mis-aligned, with brackets + wire
const ORTHO_SHAPES = { ta: lowerIncisor(52, 110), tb: lowerIncisor(56, 122) };
const ORTHO = [
  { cx: 158, top: 222, w: 52, h: 110, rot: -6, k: 'ta' },
  { cx: 213, top: 210, w: 56, h: 122, rot: 3.5, k: 'tb' },
  { cx: 268, top: 213, w: 56, h: 122, rot: -2.5, k: 'tb' },
  { cx: 323, top: 224, w: 52, h: 110, rot: 5, k: 'ta' },
];
const orthoTeeth = ORTHO.map((t) => {
  const by = f(t.h * 0.4);
  const [lx, ly] = rotPt([0, by], t.rot, [0, t.h / 2]);
  return { ...t, by, gx: t.cx + lx, gy: t.top + ly };
});
const orthoWire = smooth([
  [orthoTeeth[0].gx - 20, orthoTeeth[0].gy + 2],
  ...orthoTeeth.map((t): Pt => [t.gx, t.gy]),
  [orthoTeeth[3].gx + 20, orthoTeeth[3].gy + 2],
]);
const orthoGuideY = f(orthoTeeth.reduce((s, t) => s + t.gy, 0) / orthoTeeth.length);
const TRAY = 'M128.5 125.9A116 44 0 1 0 351.5 125.9A18 18 0 0 0 316.9 131.4A80 24 0 1 1 163.1 131.4A18 18 0 0 0 128.5 125.9Z';
const trayTicks = [28, 50, 72, 90, 108, 130, 152]
  .map((a) => {
    const c = Math.cos(rad(a));
    const s = Math.sin(rad(a));
    return `M${f(240 + 86 * c)} ${f(138 + 28 * s)}L${f(240 + 110 * c)} ${f(138 + 40 * s)}`;
  })
  .join('');

// estetica — smile arc of six upper front teeth
const SMILE = [
  { cx: 116, top: 200, w: 42, h: 98, canine: true, depth: 0.1 },
  { cx: 160, top: 206, w: 46, h: 90, canine: false, depth: 0.05 },
  { cx: 210, top: 196, w: 58, h: 114, canine: false, depth: 0 },
  { cx: 270, top: 196, w: 58, h: 114, canine: false, depth: 0 },
  { cx: 320, top: 206, w: 46, h: 90, canine: false, depth: 0.05 },
  { cx: 364, top: 200, w: 42, h: 98, canine: true, depth: 0.1 },
].map((t) => ({
  ...t,
  k: t.canine ? 'k' : 'i',
  tf: `translate(${t.cx} ${t.top}) scale(${(t.w / 124).toFixed(3)} ${(t.h / 186).toFixed(3)})`,
}));
const smileGum = (() => {
  let d = 'M88 230';
  SMILE.forEach((t, i) => {
    const y0 = t.top + 0.09 * t.h;
    const lx = t.cx - 0.36 * t.w;
    const rx = t.cx + 0.36 * t.w;
    const c = t.top - 0.02 * t.h;
    if (i === 0) d += `L${f(lx)} ${f(y0)}`;
    d += `C${f(t.cx - 0.2 * t.w)} ${f(c)} ${f(t.cx + 0.2 * t.w)} ${f(c)} ${f(rx)} ${f(y0)}`;
    const n = SMILE[i + 1];
    if (n) {
      const nx = n.cx - 0.36 * n.w;
      const ny = n.top + 0.09 * n.h;
      d += `Q${f((rx + nx) / 2)} ${f(Math.max(y0, ny) + 16)} ${f(nx)} ${f(ny)}`;
    }
  });
  return `${d}L392 230C394 186 332 146 240 144C148 146 86 186 88 230Z`;
})();
const SHADES = ['#FFFFFF', '#F4FAFB', '#E3EEF1', '#F3ECE3', '#E6D8C6'];
const shadeTabs = [100, 95, 90, 85, 80].map((a, i) => ({
  tf: `translate(${f(184 + 236 * Math.cos(rad(a)))} ${f(132 + 236 * Math.sin(rad(a)))}) rotate(${a - 90})`,
  fill: SHADES[i],
}));

// rehabilitacion — implant-supported bridge; shapes built at x=0 and placed with translate
const REHAB_CROWNS = { m: crownSide(0, 64, 112, 200, 3), p: crownSide(0, 56, 112, 200, 2) };
const REHAB_CROWN_POS = [
  { x: 152, k: 'cm' },
  { x: 212, k: 'cp' },
  { x: 268, k: 'cp' },
  { x: 328, k: 'cm' },
];
const rehabScrew = screw(0, 280, 384, 17, 11, 14, 7);

// pricing
const receipt = (() => {
  const x0 = 158;
  const x1 = 322;
  const y = 366;
  const n = 9;
  const step = (x1 - x0) / n;
  let d = `M${x0 + 14} 108L${x1 - 14} 108Q${x1} 108 ${x1} 122L${x1} ${y}`;
  for (let i = 0; i < n; i++) d += `L${f(x1 - step * (i + 0.5))} ${y + 9}L${f(x1 - step * (i + 1))} ${y}`;
  return `${d}L${x0} 122Q${x0} 108 ${x0 + 14} 108Z`;
})();
const BADGE = scallop(336, 124, 44, 16);
const COINS = [384, 371, 358];
---

<svg
  viewBox="0 0 480 480"
  width="100%"
  xmlns="http://www.w3.org/2000/svg"
  class:list={['ti', `ti--${name}`, className]}
  role={title ? 'img' : undefined}
  aria-labelledby={title ? titleId : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable={title ? undefined : 'false'}
>
  {title && <title id={titleId}>{title}</title>}
  <defs>
    {grads.map((g) => {
      const stops = g.stops.map(([o, c, op]) => <stop offset={o} stop-color={c} stop-opacity={op} />);
      return g.radial ? (
        <radialGradient id={id(g.key)} cy={g.cy} r={g.r}>{stops}</radialGradient>
      ) : (
        <linearGradient id={id(g.key)} x2={g.dir ? undefined : '0'} y2={g.dir === 'h' ? undefined : '1'}>{stops}</linearGradient>
      );
    })}
    <g id={id('sprig')} fill="none" stroke-linecap="round">
      <path d={SPRIG} stroke="currentColor" stroke-width="2.4" />
      <path d={SPRIG_DOTS} stroke-width="6" />
    </g>
  </defs>

  {/* ── backdrop: halo, coral glow, organic blob, rings, sprigs ── */}
  <circle cx="240" cy="240" r="212" fill={url('halo')} />
  <circle cx="338" cy="168" r="150" fill={url('glow')} />
  <path
    d="M240 92C318 88 384 140 392 218C400 300 348 380 262 390C176 400 100 352 90 268C80 182 160 96 240 92Z"
    fill={url('blob')}
    transform={`rotate(${scene.blob} 240 240)`}
  />
  <g fill="none" stroke="#8FE3EA">
    <circle cx="240" cy="240" r="172" stroke-opacity=".12" />
    <circle cx="240" cy="240" r="196" stroke-opacity=".28" stroke-width="1.6" stroke-linecap="round" stroke-dasharray=".1 9" />
  </g>
  {sprigs.map((s) => (
    <use
      href={ref('sprig')}
      transform={`translate(${s.x} ${s.y}) rotate(${s.r}) scale(${s.s})`}
      color={s.c === 'coral' ? '#F2617A' : '#2CC5D2'}
      stroke={s.c === 'coral' ? '#FF9AAA' : '#8FE3EA'}
      opacity=".85"
    />
  ))}

  {/* ── subject ── */}
  <g class="ti-float">
    {name === 'implantes' && (
