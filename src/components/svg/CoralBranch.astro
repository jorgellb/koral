---
/**
 * Procedurally grown coral branch (sea-fan style), echoing the coral "K" of the
 * Koral logo. Deterministic: the same `seed` always draws the same coral.
 * With `draw`, branches draw themselves when an ancestor gets `.visible`.
 */
interface Props {
  seed?: number;
  depth?: number;
  spread?: number;
  color?: 'aqua' | 'coral' | 'duo' | 'white' | 'teal';
  draw?: boolean;
  sway?: boolean;
  thickness?: number;
  class?: string;
}

const {
  seed = 7,
  depth = 5,
  spread = 0.62,
  color = 'duo',
  draw = false,
  sway = false,
  thickness = 1,
  class: className = '',
} = Astro.props;

const mulberry32 = (a: number) => () => {
  a |= 0;
  a = (a + 0x6d2b79f5) | 0;
  let t = Math.imul(a ^ (a >>> 15), 1 | a);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const rand = mulberry32(seed * 9973 + 17);

type Segment = { d: string; level: number; width: number };
const segments: Segment[] = [];
const tips: { x: number; y: number }[] = [];
const bounds = { minX: Infinity, maxX: -Infinity, minY: Infinity, maxY: -Infinity };
const track = (x: number, y: number) => {
  bounds.minX = Math.min(bounds.minX, x);
  bounds.maxX = Math.max(bounds.maxX, x);
  bounds.minY = Math.min(bounds.minY, y);
  bounds.maxY = Math.max(bounds.maxY, y);
};

const MIN_ANGLE = -Math.PI + 0.32;
const MAX_ANGLE = -0.32;
const round = (n: number) => Math.round(n * 2) / 2;

const grow = (x: number, y: number, angle: number, length: number, width: number, level: number) => {
  const a = Math.min(MAX_ANGLE, Math.max(MIN_ANGLE, angle));
  const ex = x + Math.cos(a) * length;
  const ey = y + Math.sin(a) * length;
  const bend = (rand() - 0.5) * length * 0.42;
  const cx = (x + ex) / 2 + Math.cos(a + Math.PI / 2) * bend;
  const cy = (y + ey) / 2 + Math.sin(a + Math.PI / 2) * bend;
  segments.push({ d: `M${round(x)} ${round(y)}Q${round(cx)} ${round(cy)} ${round(ex)} ${round(ey)}`, level, width });
  track(x, y);
  track(ex, ey);
  track(cx, cy);

  if (level >= depth) {
    tips.push({ x: round(ex), y: round(ey) });
    return;
  }
  const children = level < 2 && rand() < 0.4 ? 3 : 2;
  for (let i = 0; i < children; i++) {
    const offset = (i - (children - 1) / 2) * spread * (0.75 + rand() * 0.5);
    const jitter = (rand() - 0.5) * 0.3;
    grow(ex, ey, a + offset + jitter, length * (0.66 + rand() * 0.14), Math.max(1, width * 0.7), level + 1);
  }
};

grow(100, 240, -Math.PI / 2 + (rand() - 0.5) * 0.15, 48, 7.5 * thickness, 0);

const pad = 8;
const vb = [
  round(bounds.minX - pad),
  round(bounds.minY - pad),
  round(bounds.maxX - bounds.minX + pad * 2),
  round(bounds.maxY - bounds.minY + pad * 2),
].join(' ');

const levels = Array.from({ length: depth + 1 }, (_, level) => segments.filter((s) => s.level === level));

const uid = `coral-${seed}-${Math.random().toString(36).slice(2, 8)}`;
const palette = {
  aqua: ['#2CC5D2', '#8FE3EA'],
  coral: ['#F2617A', '#FF9AAA'],
  duo: ['#2CC5D2', '#F2617A'],
  white: ['rgba(255,255,255,0.9)', 'rgba(255,255,255,0.55)'],
  teal: ['#0B7C86', '#2CC5D2'],
}[color];
---

<svg
  viewBox={vb}
  class:list={['coral-branch', { draw, 'animate-sway': sway }, className]}
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMax meet"
  fill="none"
>
  <defs>
    <linearGradient id={uid} x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color={palette[0]} />
      <stop offset="1" stop-color={palette[1]} />
    </linearGradient>
  </defs>
  <g stroke={`url(#${uid})`} stroke-linecap="round" stroke-linejoin="round">
    {levels.map((group, level) =>
      draw ? (
        <g stroke-width={group[0]?.width ?? 1} style={`--dd:${0.15 + level * 0.28}s`}>
          {group.map((segment) => <path d={segment.d} pathLength="1" />)}
        </g>
      ) : (
        <path stroke-width={group[0]?.width ?? 1} d={group.map((segment) => segment.d).join('')} />
      ),
    )}
  </g>
  <path
    class="coral-tip"
    stroke={palette[1]}
    stroke-width={3.8 * thickness}
    stroke-linecap="round"
    d={tips.map((tip) => `M${tip.x} ${tip.y}h0`).join('')}
  />
</svg>
