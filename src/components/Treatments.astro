---
import { useTranslations, getLangFromUrl } from '../i18n/utils';
import { pathFor, TREATMENTS } from '../i18n/routes';
import SectionHeading from './ui/SectionHeading.astro';
import TreatmentIcon from './svg/TreatmentIcon.astro';
import TreatmentIllustration from './svg/TreatmentIllustration.astro';
import CoralBranch from './svg/CoralBranch.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const [featured, ...rest] = TREATMENTS;
---

<section id="tratamientos" class="section-y relative overflow-hidden bg-sand">
  <span id="treatments" class="absolute -top-24" aria-hidden="true"></span>
  <CoralBranch seed={44} color="teal" class="pointer-events-none absolute -left-16 top-16 h-[320px] w-auto opacity-[0.08]" />

  <div class="container-k relative">
    <SectionHeading
      eyebrow={t('treatments.services')}
      title={t('treatments.title.main')}
      description={t('treatments.desc.main')}
      split
    />

    <ul class="mt-16 grid gap-4 md:auto-rows-fr md:grid-cols-2 lg:grid-cols-3 lg:gap-5">
      <!-- Featured -->
      <li class="md:row-span-2" data-reveal>
        <a href={pathFor(featured.key, lang)} class="group relative isolate flex h-full min-h-[520px] flex-col overflow-hidden rounded-[2rem] bg-ocean p-8 text-white shadow-[var(--shadow-premium)] lg:p-10">
          <div class="pointer-events-none absolute inset-x-0 top-6 -z-10 mx-auto w-[86%] max-w-[380px] transition-transform duration-[1.2s] ease-[var(--ease-out-expo)] group-hover:scale-105" aria-hidden="true">
            <TreatmentIllustration name="implantes" />
          </div>
          <span class="font-display text-lg italic text-coral-soft">01</span>
          <div class="mt-auto">
            <span class="mb-5 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-white/10 text-aqua ring-1 ring-white/15 backdrop-blur-md">
              <TreatmentIcon name={featured.key} size={32} />
            </span>
            <h3 class="text-3xl text-white lg:text-[2.2rem]">{t(featured.label as any)}</h3>
            <p class="mt-3 max-w-sm text-[15px] leading-relaxed text-white/70">{t(featured.desc as any)}</p>
            <span class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-aqua-soft">
              {t('treatments.more')}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </div>
        </a>
      </li>

      {rest.map((item, i) => (
        <li data-reveal style={`--d:${((i % 3) + 1) * 0.06}s`}>
          <a href={pathFor(item.key, lang)} class="t-card group relative isolate flex h-full flex-col overflow-hidden rounded-[2rem] border border-ocean-900/[0.07] bg-white p-7 shadow-[var(--shadow-soft)] lg:p-8">
            <span class="t-card-bg absolute inset-0 -z-10 bg-ocean opacity-0 transition-opacity duration-500" aria-hidden="true"></span>
            <span class="absolute -right-10 -top-10 -z-10 h-36 w-36 rounded-full bg-[radial-gradient(circle,rgba(44,197,210,0.18)_0%,transparent_70%)] transition-transform duration-700 group-hover:scale-150" aria-hidden="true"></span>

            <div class="flex items-start justify-between">
              <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-aqua-pale text-accent transition-all duration-500 group-hover:bg-white/10 group-hover:text-aqua">
                <TreatmentIcon name={item.key} size={32} />
              </span>
              <span class="font-display text-lg italic text-coral transition-colors duration-500 group-hover:text-coral-soft">{String(i + 2).padStart(2, '0')}</span>
            </div>

            <h3 class="mt-8 text-[1.65rem] text-ocean-900 transition-colors duration-500 group-hover:text-white">{t(item.label as any)}</h3>
            <p class="mt-3 flex-1 text-[15px] leading-relaxed text-slate-600 transition-colors duration-500 group-hover:text-white/70">{t(item.desc as any)}</p>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent transition-colors duration-500 group-hover:text-aqua-soft">
              {t('treatments.more')}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </a>
        </li>
      ))}

      <!-- CTA tile -->
      <li class="md:col-span-2" data-reveal style="--d:.2s">
        <div class="relative isolate flex h-full flex-col justify-between gap-6 overflow-hidden rounded-[2rem] bg-gradient-to-br from-coral-deep to-[#e2566d] p-8 text-white sm:flex-row sm:items-center lg:p-10">
          <CoralBranch seed={52} color="white" class="pointer-events-none absolute -bottom-6 right-6 -z-10 h-[200px] w-auto opacity-25" />
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-white/80">{t('nav.mega.promo.title')}</p>
            <p class="font-display mt-3 text-3xl leading-tight lg:text-[2.1rem]">{t('cta.title')}</p>
            <p class="mt-2 max-w-md text-[15px] text-white/85">{t('nav.mega.promo.desc')}</p>
          </div>
          <a href="#appointment" class="btn shrink-0 bg-white text-coral-deep shadow-xl hover:-translate-y-0.5">
            {t('nav.appointment')}
            <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </li>
    </ul>
  </div>
</section>

<style is:global>
  .t-card {
    transition: transform 0.6s var(--ease-out-expo), box-shadow 0.6s var(--ease-out-expo), border-color 0.4s ease;
  }
  .t-card:hover {
    transform: translateY(-6px);
    border-color: transparent;
    box-shadow: var(--shadow-premium);
  }
  .t-card:hover .t-card-bg { opacity: 1; }
  .t-card:hover .treatment-icon { --icon-accent: #ff9aaa; }
</style>
