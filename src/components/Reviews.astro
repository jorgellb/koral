---
import { useTranslations, getLangFromUrl } from '../i18n/utils';
import SectionHeading from './ui/SectionHeading.astro';
import CoralBranch from './svg/CoralBranch.astro';
import Waves from './svg/Waves.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const reviews = [
  { name: 'Carmen García', n: 1, flag: 'ES' },
  { name: 'Michael Thompson', n: 2, flag: 'GB' },
  { name: 'Hans Müller', n: 3, flag: 'DE' },
  { name: 'Sophie Dubois', n: 4, flag: 'FR' },
  { name: 'Jan van der Berg', n: 5, flag: 'NL' },
  { name: 'María Rodríguez', n: 6, flag: 'ES' },
  { name: 'Peter Schmidt', n: 7, flag: 'DE' },
  { name: 'Emma Williams', n: 8, flag: 'GB' },
].map((r) => ({
  ...r,
  initials: r.name.split(' ').filter((w) => /^[A-ZÁÉÍÓÚÜ]/.test(w)).map((w) => w[0]).slice(0, 2).join(''),
  text: t(`reviews.review${r.n}.text` as any),
  treatment: t(`reviews.review${r.n}.treatment` as any),
  date: t(`reviews.review${r.n}.date` as any),
}));

const googleUrl =
  'https://www.google.com/maps/place/Cl%C3%ADnica+Dental+Koral/@37.2371629,-1.8531261,17z/data=!4m8!3m7!1s0xd7a9df2d98aef17:0x7a9fca6a58f3fc91!8m2!3d37.2371629!4d-1.8505512!9m1!1b1!16s%2Fg%2F11c54_w9jd?entry=ttu';
const star = 'm12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1Z';
---

<section class="relative isolate overflow-hidden bg-ocean text-white">
  <Waves fill="#ffffff" flip class="absolute inset-x-0 top-[-1px] z-10" />
  <Waves fill="#FBF8F4" class="absolute inset-x-0 bottom-[-1px] z-10" />
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <CoralBranch seed={101} color="duo" class="absolute -left-16 bottom-32 h-[240px] w-auto opacity-15" />
    <div class="absolute right-0 top-0 h-[520px] w-[520px] rounded-full bg-[radial-gradient(circle,rgba(44,197,210,0.15)_0%,transparent_65%)]"></div>
    <svg class="absolute right-[8%] top-28 hidden h-56 w-56 text-white/[0.04] lg:block" viewBox="0 0 100 80" fill="currentColor"><path d="M0 80V48C0 20 14 4 40 0l4 10C28 16 22 26 22 40h18v40Zm56 0V48C56 20 70 4 96 0l4 10C84 16 78 26 78 40h18v40Z" /></svg>
  </div>

  <div class="container-k pb-10 pt-32 md:pt-40">
    <div class="grid items-end gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <SectionHeading eyebrow="Google Reviews" title={t('reviews.title')} description={t('reviews.subtitle')} tone="dark" />
      </div>
      <div class="lg:col-span-5" data-reveal style="--d:.15s">
        <a href={googleUrl} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-6 rounded-[1.75rem] border border-white/12 bg-white/[0.05] p-6 backdrop-blur-xl transition-colors hover:bg-white/[0.09] lg:ml-auto lg:max-w-md">
          <div class="text-center">
            <p class="font-display text-6xl leading-none"><span data-count="4.8">4,8</span></p>
            <div class="mt-2 flex justify-center gap-0.5">
              {[0, 1, 2, 3, 4].map(() => <svg width="14" height="14" viewBox="0 0 24 24" fill="#FBBF24" aria-hidden="true"><path d={star} /></svg>)}
            </div>
          </div>
          <div class="h-16 w-px bg-white/15" aria-hidden="true"></div>
          <div class="flex-1">
            <p class="text-sm text-white/60"><span class="font-display text-2xl text-white" data-count="118" data-suffix="+">118+</span> {t('reviews.stat.reviews')}</p>
            <p class="mt-1 text-sm font-semibold text-aqua-soft group-hover:underline">{t('reviews.google.title')} →</p>
          </div>
          <svg class="h-8 w-8 shrink-0" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" /><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" /><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" /><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" /></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="reviews-track flex snap-x snap-mandatory gap-5 overflow-x-auto pb-8 pt-6 [scrollbar-width:none]" tabindex="0" aria-label={t('reviews.title')}>
    {reviews.map((r, i) => (
      <figure class="review-card relative flex w-[84vw] max-w-[400px] shrink-0 snap-start flex-col rounded-[1.75rem] border border-white/10 bg-white/[0.04] p-7 backdrop-blur-md transition-colors duration-500 hover:border-aqua/40 hover:bg-white/[0.07] sm:w-[380px] lg:p-8" data-reveal style={`--d:${Math.min(i, 3) * 0.08}s`}>
        <svg class="absolute right-7 top-7 h-9 w-9 text-coral/40" viewBox="0 0 100 80" fill="currentColor" aria-hidden="true"><path d="M0 80V48C0 20 14 4 40 0l4 10C28 16 22 26 22 40h18v40Zm56 0V48C56 20 70 4 96 0l4 10C84 16 78 26 78 40h18v40Z" /></svg>
        <div class="flex gap-0.5" aria-label="5/5">
          {[0, 1, 2, 3, 4].map(() => <svg width="15" height="15" viewBox="0 0 24 24" fill="#FBBF24" aria-hidden="true"><path d={star} /></svg>)}
        </div>
        <blockquote class="mt-5 flex-1">
          <p class="font-display text-[1.15rem] leading-relaxed text-white/90">“{r.text}”</p>
        </blockquote>
        <figcaption class="mt-7 flex items-center gap-4 border-t border-white/10 pt-5">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-aqua to-accent text-sm font-bold text-white">{r.initials}</span>
          <span class="min-w-0">
            <span class="block truncate font-semibold">{r.name}</span>
            <span class="block truncate text-[11.5px] uppercase tracking-[0.14em] text-white/50">{r.treatment} · {r.date}</span>
          </span>
          <span class="ml-auto rounded-full border border-white/15 px-2 py-0.5 text-[10px] font-semibold tracking-wider text-white/60">{r.flag}</span>
        </figcaption>
      </figure>
    ))}
    <div class="w-px shrink-0" aria-hidden="true"></div>
  </div>

  <div class="h-28 md:h-36" aria-hidden="true"></div>
</section>

<style is:global>
  .reviews-track {
    padding-inline: max(1.25rem, calc((100vw - 1280px) / 2 + 2rem));
    scroll-padding-inline: max(1.25rem, calc((100vw - 1280px) / 2 + 2rem));
  }
  .reviews-track::-webkit-scrollbar { display: none; }
</style>
