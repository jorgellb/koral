---
import { useTranslations, getLangFromUrl } from '../i18n/utils';
import { Star, Quote, ChevronLeft, ChevronRight } from 'lucide-astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Reseñas reales de Google (4.8 estrellas, 118+ reseñas)
const reviews = [
  { 
    name: 'Carmen García', 
    rating: 5, 
    text: t('reviews.review1.text'),
    treatment: t('reviews.review1.treatment'),
    date: t('reviews.review1.date'),
    avatar: 'CG'
  },
  { 
    name: 'Michael Thompson', 
    rating: 5, 
    text: t('reviews.review2.text'),
    treatment: t('reviews.review2.treatment'),
    date: t('reviews.review2.date'),
    avatar: 'MT'
  },
  { 
    name: 'Hans Müller', 
    rating: 5, 
    text: t('reviews.review3.text'),
    treatment: t('reviews.review3.treatment'),
    date: t('reviews.review3.date'),
    avatar: 'HM'
  },
  { 
    name: 'Sophie Dubois', 
    rating: 5, 
    text: t('reviews.review4.text'),
    treatment: t('reviews.review4.treatment'),
    date: t('reviews.review4.date'),
    avatar: 'SD'
  },
  { 
    name: 'Jan van der Berg', 
    rating: 5, 
    text: t('reviews.review5.text'),
    treatment: t('reviews.review5.treatment'),
    date: t('reviews.review5.date'),
    avatar: 'JB'
  },
  { 
    name: 'María Rodríguez', 
    rating: 5, 
    text: t('reviews.review6.text'),
    treatment: t('reviews.review6.treatment'),
    date: t('reviews.review6.date'),
    avatar: 'MR'
  },
  { 
    name: 'Peter Schmidt', 
    rating: 5, 
    text: t('reviews.review7.text'),
    treatment: t('reviews.review7.treatment'),
    date: t('reviews.review7.date'),
    avatar: 'PS'
  },
  { 
    name: 'Emma Williams', 
    rating: 5, 
    text: t('reviews.review8.text'),
    treatment: t('reviews.review8.treatment'),
    date: t('reviews.review8.date'),
    avatar: 'EW'
  }
];
---

<section class="section-padding relative overflow-hidden" style="background:linear-gradient(135deg,#0b1226 0%,#1e293b 50%,#0b1226 100%)">
  <!-- Decorative elements -->
  <div class="absolute inset-0 opacity-[0.12]">
    <div class="absolute top-20 left-10 w-96 h-96 bg-accent rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-80 h-80 bg-white rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-accent/30 rounded-full blur-3xl"></div>
  </div>

  <!-- Subtle noise overlay -->
  <div class="absolute inset-0 opacity-[0.04] pointer-events-none mix-blend-overlay" style="background-image:url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;)"></div>

  <!-- Floating quote marks -->
  <div class="absolute top-32 left-20 opacity-[0.04] rotate-12 hidden lg:block font-display text-[280px] leading-none text-white pointer-events-none">"</div>
  <div class="absolute bottom-32 right-20 opacity-[0.04] -rotate-12 hidden lg:block font-display text-[200px] leading-none text-accent pointer-events-none">"</div>

  <div class="container mx-auto px-6 relative z-10">
    <!-- Header -->
    <div class="text-center mb-16 lg:mb-20 fade-up">
      <span class="inline-flex items-center gap-3 px-5 py-2 bg-white/[0.06] backdrop-blur-md text-white rounded-full text-[10px] font-bold tracking-[0.28em] uppercase mb-8 border border-white/15">
        <div class="flex gap-0.5">
          {[...Array(5)].map(() => (
            <Star size={11} class="fill-amber-400 text-amber-400" />
          ))}
        </div>
        <span class="text-white/90">4.8 · Google</span>
      </span>

      <h3 class="text-4xl md:text-5xl lg:text-[4.5rem] font-black text-white leading-[1.05] tracking-[-0.025em] mb-4">
        {t('reviews.title')}
      </h3>
      <div class="gold-line max-w-[100px] mx-auto mb-6"></div>
      <p class="text-white/65 text-lg max-w-2xl mx-auto font-normal leading-relaxed">
        {t('reviews.subtitle')}
      </p>

      <!-- Stats -->
      <div class="grid grid-cols-3 gap-px mt-14 pt-10 max-w-3xl mx-auto rounded-2xl overflow-hidden bg-white/[0.06] border border-white/10" style="background:rgba(255,255,255,0.04)">
        <div class="text-center px-4 py-6 bg-primary/40">
          <div class="text-4xl md:text-5xl font-black text-accent mb-2 tracking-tighter">118+</div>
          <p class="text-white/55 text-[10px] font-bold uppercase tracking-[0.22em]">{t('reviews.stat.reviews')}</p>
        </div>
        <div class="text-center px-4 py-6 bg-primary/40 relative">
          <div class="text-4xl md:text-5xl font-black text-white mb-2 tracking-tighter flex items-center justify-center gap-2">
            4.8
            <Star size={20} class="fill-amber-400 text-amber-400" />
          </div>
          <p class="text-white/55 text-[10px] font-bold uppercase tracking-[0.22em]">{t('reviews.stat.rating')}</p>
        </div>
        <div class="text-center px-4 py-6 bg-primary/40">
          <div class="text-4xl md:text-5xl font-black text-accent mb-2 tracking-tighter">98%</div>
          <p class="text-white/55 text-[10px] font-bold uppercase tracking-[0.22em]">{t('reviews.stat.recommend')}</p>
        </div>
      </div>
    </div>

    <!-- Reviews Slider -->
    <div class="relative">
      <!-- Navigation buttons -->
      <div class="hidden md:flex absolute -left-6 top-1/2 -translate-y-1/2 z-20">
        <button id="reviews-prev" class="w-14 h-14 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 flex items-center justify-center text-white hover:bg-accent hover:border-accent transition-all cursor-pointer group">
          <ChevronLeft size={24} class="group-hover:-translate-x-1 transition-transform" />
        </button>
      </div>
      <div class="hidden md:flex absolute -right-6 top-1/2 -translate-y-1/2 z-20">
        <button id="reviews-next" class="w-14 h-14 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 flex items-center justify-center text-white hover:bg-accent hover:border-accent transition-all cursor-pointer group">
          <ChevronRight size={24} class="group-hover:translate-x-1 transition-transform" />
        </button>
      </div>

      <div id="reviews-slider-container" class="overflow-hidden rounded-3xl">
        <div id="reviews-slider" class="flex transition-transform duration-700 ease-[cubic-bezier(0.23,1,0.32,1)]">
          {reviews.map((review) => (
            <div class="flex-none w-full md:w-1/2 lg:w-1/3 p-3">
              <div class="h-full bg-white/[0.04] backdrop-blur-md rounded-[1.75rem] p-7 lg:p-8 border border-white/[0.10] hover:bg-white/[0.08] hover:border-accent/40 transition-all duration-500 group relative overflow-hidden">
                <!-- Hover glow effect -->
                <div class="absolute inset-0 bg-gradient-to-br from-accent/0 via-transparent to-accent/15 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

                <!-- Top-right hairline gold accent on hover -->
                <div class="absolute top-0 right-0 w-0 h-px bg-gradient-to-l from-gold via-gold/50 to-transparent group-hover:w-full transition-all duration-700"></div>

                <div class="relative z-10">
                  <!-- Quote icon - decorative, more subtle -->
                  <div class="absolute -top-4 -right-4 text-white/[0.06] text-[120px] leading-none font-display select-none pointer-events-none">"</div>

                  <!-- Stars at top -->
                  <div class="flex gap-0.5 mb-5">
                    {[...Array(review.rating)].map(() => (
                      <Star size={14} class="fill-amber-400 text-amber-400" />
                    ))}
                  </div>

                  <!-- Review text -->
                  <p class="text-white/85 leading-[1.65] mb-7 text-[15px] md:text-base font-light min-h-[110px]">
                    "{review.text}"
                  </p>

                  <!-- Footer -->
                  <div class="flex items-center gap-4 pt-5 border-t border-white/10">
                    <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-accent via-accent to-accent/70 flex items-center justify-center text-white font-bold text-sm shadow-lg shadow-accent/20">
                      {review.avatar}
                    </div>
                    <div class="flex-1 min-w-0">
                      <h4 class="text-white font-semibold text-[15px] truncate">{review.name}</h4>
                      <p class="text-white/45 text-[10px] font-bold uppercase tracking-[0.18em] truncate">{review.treatment} · {review.date}</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Mobile navigation dots -->
      <div class="flex justify-center gap-2 mt-8 md:hidden" id="reviews-dots">
        {reviews.map((_, index) => (
          <button 
            class={`w-2.5 h-2.5 rounded-full transition-all duration-300 ${index === 0 ? 'bg-accent w-8' : 'bg-white/30'}`}
            data-index={index}
          ></button>
        ))}
      </div>

      <!-- Progress bar for desktop -->
      <div class="hidden md:block mt-12 h-1 bg-white/10 rounded-full max-w-md mx-auto overflow-hidden">
        <div id="reviews-progress" class="h-full bg-accent rounded-full transition-all duration-500 w-1/3"></div>
      </div>
    </div>

    <!-- Google badge -->
    <div class="flex justify-center mt-16 fade-up">
      <a
        href="https://www.google.com/maps/place/Cl%C3%ADnica+Dental+Koral/@37.2371629,-1.8531261,17z/data=!4m8!3m7!1s0xd7a9df2d98aef17:0x7a9fca6a58f3fc91!8m2!3d37.2371629!4d-1.8505512!9m1!1b1!16s%2Fg%2F11c54_w9jd?entry=ttu"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-5 pl-6 pr-5 py-4 bg-white rounded-full shadow-2xl shadow-black/30 hover:shadow-accent/30 hover:-translate-y-1 transition-all duration-300 group ring-1 ring-white/40"
      >
        <svg class="w-7 h-7 shrink-0" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        <div class="text-left">
          <p class="text-primary font-bold text-sm leading-tight">{t('reviews.google.title')}</p>
          <p class="text-slate-500 text-[11px] font-medium leading-tight mt-0.5">{t('reviews.google.subtitle')}</p>
        </div>
        <span class="w-9 h-9 rounded-full bg-slate-100 group-hover:bg-accent group-hover:text-white text-slate-400 flex items-center justify-center transition-all">
          <ChevronRight size={16} class="group-hover:translate-x-0.5 transition-transform" />
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  const slider = document.getElementById('reviews-slider');
  const container = document.getElementById('reviews-slider-container');
  const prev = document.getElementById('reviews-prev');
  const next = document.getElementById('reviews-next');
  const progress = document.getElementById('reviews-progress');
  const dots = document.querySelectorAll('#reviews-dots button');
  
  let currentIndex = 0;
  let itemsPerView = 3;
  let totalItems = 8;
  let maxIndex = 0;
  
  const updateItemsPerView = () => {
    if (window.innerWidth < 768) {
      itemsPerView = 1;
    } else if (window.innerWidth < 1024) {
      itemsPerView = 2;
    } else {
      itemsPerView = 3;
    }
    maxIndex = Math.max(0, totalItems - itemsPerView);
    currentIndex = Math.min(currentIndex, maxIndex);
  };

  const updateSlider = () => {
    if (!slider) return;
    const percentage = (currentIndex / totalItems) * 100;
    slider.style.transform = `translateX(-${percentage}%)`;
    
    // Update progress
    if (progress) {
      const progressPercentage = ((currentIndex + itemsPerView) / totalItems) * 100;
      progress.style.width = `${Math.min(100, progressPercentage)}%`;
    }
    
    // Update dots
    dots.forEach((dot, index) => {
      if (index === currentIndex) {
        dot.classList.add('bg-accent', 'w-8');
        dot.classList.remove('bg-white/30');
      } else {
        dot.classList.remove('bg-accent', 'w-8');
        dot.classList.add('bg-white/30');
      }
    });
  };

  const moveSlider = (direction: 'next' | 'prev') => {
    if (direction === 'next') {
      currentIndex = currentIndex >= maxIndex ? 0 : currentIndex + 1;
    } else {
      currentIndex = currentIndex <= 0 ? maxIndex : currentIndex - 1;
    }
    updateSlider();
  };

  // Event listeners
  next?.addEventListener('click', () => moveSlider('next'));
  prev?.addEventListener('click', () => moveSlider('prev'));
  
  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => {
      currentIndex = Math.min(index, maxIndex);
      updateSlider();
    });
  });

  // Auto-play
  let autoPlay = setInterval(() => moveSlider('next'), 5000);
  
  container?.addEventListener('mouseenter', () => clearInterval(autoPlay));
  container?.addEventListener('mouseleave', () => {
    autoPlay = setInterval(() => moveSlider('next'), 5000);
  });

  // Touch support
  let touchStartX = 0;
  let touchEndX = 0;
  
  container?.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });
  
  container?.addEventListener('touchend', (e) => {
    touchEndX = e.changedTouches[0].screenX;
    const diff = touchStartX - touchEndX;
    if (Math.abs(diff) > 50) {
      moveSlider(diff > 0 ? 'next' : 'prev');
    }
  }, { passive: true });

  // Initialize
  updateItemsPerView();
  updateSlider();
  window.addEventListener('resize', () => {
    updateItemsPerView();
    updateSlider();
  });
</script>
