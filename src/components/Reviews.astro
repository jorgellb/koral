---
import { useTranslations, getLangFromUrl } from '../i18n/utils';
import SectionHeading from './ui/SectionHeading.astro';
import CoralBranch from './svg/CoralBranch.astro';
import Waves from './svg/Waves.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const reviews = [
  { name: 'Carmen García', n: 1, flag: 'ES' },
  { name: 'Michael Thompson', n: 2, flag: 'GB' },
  { name: 'Hans Müller', n: 3, flag: 'DE' },
  { name: 'Sophie Dubois', n: 4, flag: 'FR' },
  { name: 'Jan van der Berg', n: 5, flag: 'NL' },
  { name: 'María Rodríguez', n: 6, flag: 'ES' },
  { name: 'Peter Schmidt', n: 7, flag: 'DE' },
  { name: 'Emma Williams', n: 8, flag: 'GB' },
].map((r) => ({
  ...r,
  initials: r.name.split(' ').filter((w) => /^[A-ZÁÉÍÓÚÜ]/.test(w)).map((w) => w[0]).slice(0, 2).join(''),
  text: t(`reviews.review${r.n}.text` as any),
  treatment: t(`reviews.review${r.n}.treatment` as any),
  date: t(`reviews.review${r.n}.date` as any),
}));

const googleUrl =
  'https://www.google.com/maps/place/Cl%C3%ADnica+Dental+Koral/@37.2371629,-1.8531261,17z/data=!4m8!3m7!1s0xd7a9df2d98aef17:0x7a9fca6a58f3fc91!8m2!3d37.2371629!4d-1.8505512!9m1!1b1!16s%2Fg%2F11c54_w9jd?entry=ttu';
const star = 'm12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1Z';
const quote = 'M0 80V48C0 20 14 4 40 0l4 10C28 16 22 26 22 40h18v40Zm56 0V48C56 20 70 4 96 0l4 10C84 16 78 26 78 40h18v40Z';
---

<section class="relative isolate overflow-hidden bg-ocean text-white">
  <Waves fill="#ffffff" flip class="absolute inset-x-0 top-[-1px] z-10" />
  <Waves fill="#FBF8F4" class="absolute inset-x-0 bottom-[-1px] z-10" />
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <CoralBranch seed={101} color="duo" class="absolute -left-16 bottom-32 h-[240px] w-auto opacity-15" />
    <div class="absolute right-0 top-0 h-[520px] w-[520px] rounded-full bg-[radial-gradient(circle,rgba(44,197,210,0.15)_0%,transparent_65%)]"></div>
    <svg class="absolute right-[8%] top-28 hidden h-56 w-56 text-white/[0.04] lg:block" viewBox="0 0 100 80" fill="currentColor"><path d={quote} /></svg>
  </div>

  <div class="container-k pb-10 pt-32 md:pt-40">
    <div class="grid items-end gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <SectionHeading eyebrow="Google Reviews" title={t('reviews.title')} description={t('reviews.subtitle')} tone="dark" />
      </div>
      <div class="lg:col-span-5" data-reveal style="--d:.15s">
        <a href={googleUrl} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-6 rounded-[1.75rem] border border-white/12 bg-white/[0.05] p-6 backdrop-blur-xl transition-colors hover:bg-white/[0.09] lg:ml-auto lg:max-w-md">
          <div class="text-center">
            <p class="font-display text-6xl leading-none"><span data-count="4.8">4,8</span></p>
            <div class="mt-2 flex justify-center gap-0.5">
              {[0, 1, 2, 3, 4].map(() => <svg width="14" height="14" viewBox="0 0 24 24" fill="#FBBF24" aria-hidden="true"><path d={star} /></svg>)}
            </div>
          </div>
          <div class="h-16 w-px bg-white/15" aria-hidden="true"></div>
          <div class="flex-1">
            <p class="text-sm text-white/60"><span class="font-display text-2xl text-white" data-count="118" data-suffix="+">118+</span> {t('reviews.stat.reviews')}</p>
            <p class="mt-1 text-sm font-semibold text-aqua-soft group-hover:underline">{t('reviews.google.title')} →</p>
          </div>
          <svg class="h-8 w-8 shrink-0" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" /><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" /><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" /><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" /></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="reviews-carousel" data-reveal data-interval="5500">
    <div
      class="reviews-track flex snap-x snap-mandatory gap-5 overflow-x-auto pb-6 pt-6 [scrollbar-width:none]"
      tabindex="0"
      role="region"
      aria-roledescription="carousel"
      aria-label={t('reviews.title')}
    >
      {reviews.map((r, i) => (
        <figure
          class="review-card relative flex w-[84vw] max-w-[400px] shrink-0 snap-start flex-col rounded-[1.75rem] border border-white/10 bg-white/[0.04] p-7 backdrop-blur-md sm:w-[380px] lg:p-8"
          aria-roledescription="slide"
          aria-label={`${i + 1} / ${reviews.length}`}
        >
          <svg class="absolute right-7 top-7 h-9 w-9 text-coral/40" viewBox="0 0 100 80" fill="currentColor" aria-hidden="true"><path d={quote} /></svg>
          <div class="flex gap-0.5" role="img" aria-label="5/5">
            {[0, 1, 2, 3, 4].map(() => <svg width="15" height="15" viewBox="0 0 24 24" fill="#FBBF24" aria-hidden="true"><path d={star} /></svg>)}
          </div>
          <blockquote class="mt-5 flex-1">
            <p class="font-display text-[1.15rem] leading-relaxed text-white/90">“{r.text}”</p>
          </blockquote>
          <figcaption class="mt-7 flex items-center gap-4 border-t border-white/10 pt-5">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-aqua to-accent text-sm font-bold text-white">{r.initials}</span>
            <span class="min-w-0">
              <span class="block font-semibold">{r.name}</span>
              <span class="mt-0.5 block text-[11px] uppercase leading-snug tracking-[0.12em] text-white/50">{r.treatment} · {r.date}</span>
            </span>
            <span class="ml-auto shrink-0 rounded-full border border-white/15 px-2 py-0.5 text-[10px] font-semibold tracking-wider text-white/60">{r.flag}</span>
          </figcaption>
        </figure>
      ))}
      <div class="w-px shrink-0" aria-hidden="true"></div>
    </div>

    <!-- Controls -->
    <div class="container-k mt-6 flex flex-wrap items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <button type="button" class="rv-prev rv-btn" aria-label={t('slider.prev')}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
        </button>
        <button type="button" class="rv-next rv-btn" aria-label={t('slider.next')}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
        <button
          type="button"
          class="rv-toggle rv-btn rv-btn-sm"
          aria-pressed="false"
          aria-label={t('slider.pause')}
          data-label-pause={t('slider.pause')}
          data-label-play={t('slider.play')}
        >
          <svg class="rv-icon-pause" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1.2" /><rect x="14" y="5" width="4" height="14" rx="1.2" /></svg>
          <svg class="rv-icon-play" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z" /></svg>
        </button>
      </div>

      <div class="flex items-center gap-5">
        <p class="font-display text-lg tabular text-white/40" aria-live="polite">
          <span class="rv-current text-white">01</span> / {String(reviews.length).padStart(2, '0')}
        </p>
        <ol class="flex items-center gap-2">
          {reviews.map((_, i) => (
            <li>
              <button type="button" class="rv-dot" data-index={i} aria-label={`${t('slider.goto')} ${i + 1}`}>
                <span class="rv-dot-fill"></span>
              </button>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>

  <div class="h-28 md:h-36" aria-hidden="true"></div>
</section>

<style is:global>
  .reviews-track {
    padding-inline: max(1.25rem, calc((100vw - 1280px) / 2 + 2rem));
    scroll-padding-inline: max(1.25rem, calc((100vw - 1280px) / 2 + 2rem));
    cursor: grab;
  }
  .reviews-track.is-dragging { cursor: grabbing; scroll-snap-type: none; user-select: none; }
  .reviews-track::-webkit-scrollbar { display: none; }

  .review-card {
    transition: opacity 0.6s ease, transform 0.7s var(--ease-out-expo), border-color 0.5s ease, background-color 0.5s ease;
  }
  .reviews-carousel.is-ready .review-card:not(.is-visible) { opacity: 0.4; transform: scale(0.96); }
  .review-card.is-visible:hover { border-color: rgba(44, 197, 210, 0.4); background-color: rgba(255, 255, 255, 0.07); }

  .rv-btn {
    display: inline-flex;
    height: 3.5rem;
    width: 3.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.4s var(--ease-out-expo);
  }
  .rv-btn:hover { background: var(--color-coral-deep); border-color: var(--color-coral-deep); }
  .rv-btn:active { transform: scale(0.95); }
  .rv-btn-sm { height: 2.75rem; width: 2.75rem; color: rgba(255, 255, 255, 0.75); }
  .rv-toggle .rv-icon-play { display: none; }
  .rv-toggle[aria-pressed='true'] .rv-icon-play { display: block; }
  .rv-toggle[aria-pressed='true'] .rv-icon-pause { display: none; }

  .rv-dot {
    position: relative;
    display: block;
    height: 6px;
    width: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.25);
    transition: width 0.5s var(--ease-out-expo), background-color 0.3s ease;
  }
  .rv-dot::before { content: ''; position: absolute; inset: -10px -4px; }
  .rv-dot:hover { background: rgba(255, 255, 255, 0.5); }
  .rv-dot.is-active { width: 2.5rem; background: rgba(255, 255, 255, 0.18); }
  .rv-dot-fill {
    position: absolute;
    inset: 0;
    width: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-aqua), var(--color-coral));
  }
  .rv-dot.is-active .rv-dot-fill { width: 100%; }
  .reviews-carousel.is-playing .rv-dot.is-active .rv-dot-fill {
    animation: rv-progress var(--rv-interval, 5500ms) linear forwards;
  }
  @keyframes rv-progress {
    from { width: 0; }
    to { width: 100%; }
  }
  @media (max-width: 640px) {
    .rv-btn { height: 3rem; width: 3rem; }
    .rv-btn-sm { height: 2.5rem; width: 2.5rem; }
    .rv-dot.is-active { width: 1.6rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reviews-carousel.is-ready .review-card:not(.is-visible) { transform: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.reviews-carousel').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.reviews-track')!;
    const cards = [...track.querySelectorAll<HTMLElement>('.review-card')];
    const prev = root.querySelector<HTMLButtonElement>('.rv-prev')!;
    const next = root.querySelector<HTMLButtonElement>('.rv-next')!;
    const toggle = root.querySelector<HTMLButtonElement>('.rv-toggle')!;
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.rv-dot')];
    const current = root.querySelector<HTMLElement>('.rv-current')!;
    const interval = Number(root.dataset.interval) || 5500;
    root.style.setProperty('--rv-interval', `${interval}ms`);

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let wantsPlay = !reduceMotion; // the visitor's choice, via the pause button
    let paused = false; // temporary pause while hovering, focusing, touching or dragging
    let inView = false;
    let timer: number | undefined;

    const padding = () => parseFloat(getComputedStyle(track).scrollPaddingLeft) || 0;
    const maxScroll = () => track.scrollWidth - track.clientWidth;
    const atEnd = () => track.scrollLeft >= maxScroll() - 4;
    const offsetOf = (i: number) =>
      Math.min(maxScroll(), cards[i].getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft - padding());

    const isPlaying = () => wantsPlay && !paused && inView && !document.hidden;

    const restartProgress = () => {
      const fill = dots[index]?.querySelector<HTMLElement>('.rv-dot-fill');
      if (!fill) return;
      fill.style.animation = 'none';
      void fill.offsetWidth;
      fill.style.animation = '';
    };

    const schedule = () => {
      window.clearTimeout(timer);
      const playing = isPlaying();
      root.classList.toggle('is-playing', playing);
      if (playing) {
        restartProgress();
        timer = window.setTimeout(() => (atEnd() ? goTo(0) : goTo(index + 1)), interval);
      }
    };

    const setActive = (i: number) => {
      index = i;
      current.textContent = String(i + 1).padStart(2, '0');
      dots.forEach((dot, d) => {
        dot.classList.toggle('is-active', d === i);
        dot.setAttribute('aria-current', d === i ? 'true' : 'false');
      });
    };

    function goTo(i: number) {
      const target = (i + cards.length) % cards.length;
      track.scrollTo({ left: offsetOf(target), behavior: reduceMotion ? 'auto' : 'smooth' });
      setActive(target);
      schedule();
    }

    // Keep the active dot in sync with manual scrolling and swiping.
    let raf = 0;
    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          let nearest = 0;
          let best = Infinity;
          cards.forEach((_, i) => {
            const d = Math.abs(offsetOf(i) - track.scrollLeft);
            if (d < best) {
              best = d;
              nearest = i;
            }
          });
          if (nearest !== index && !(atEnd() && nearest < index)) setActive(nearest);
        });
      },
      { passive: true },
    );

    prev.addEventListener('click', () => goTo(index - 1));
    next.addEventListener('click', () => (atEnd() ? goTo(0) : goTo(index + 1)));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
    track.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      goTo(index + (e.key === 'ArrowRight' ? 1 : -1));
    });

    const setWantsPlay = (play: boolean) => {
      wantsPlay = play;
      toggle.setAttribute('aria-pressed', String(!play));
      toggle.setAttribute('aria-label', (play ? toggle.dataset.labelPause : toggle.dataset.labelPlay) || '');
      schedule();
    };
    toggle.addEventListener('click', () => setWantsPlay(!wantsPlay));

    const pause = () => {
      paused = true;
      schedule();
    };
    const resume = () => {
      paused = false;
      schedule();
    };
    root.addEventListener('mouseenter', pause);
    root.addEventListener('mouseleave', resume);
    root.addEventListener('focusin', pause);
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) resume();
    });
    let touchTimer: number | undefined;
    track.addEventListener('touchstart', () => {
      window.clearTimeout(touchTimer);
      pause();
    }, { passive: true });
    track.addEventListener('touchend', () => {
      touchTimer = window.setTimeout(resume, 4000);
    }, { passive: true });
    document.addEventListener('visibilitychange', schedule);

    // Drag with the mouse (touch screens already scroll natively).
    let dragging = false;
    let startX = 0;
    let startScroll = 0;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragging = true;
      startX = e.clientX;
      startScroll = track.scrollLeft;
      track.classList.add('is-dragging');
      track.setPointerCapture(e.pointerId);
    });
    track.addEventListener('pointermove', (e) => {
      if (dragging) track.scrollLeft = startScroll - (e.clientX - startX);
    });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      track.classList.remove('is-dragging');
      goTo(index);
    };
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);

    // Cards that are not fully on screen are dimmed.
    const cardObserver = new IntersectionObserver(
      (entries) => entries.forEach((entry) => entry.target.classList.toggle('is-visible', entry.intersectionRatio >= 0.7)),
      { root: track, threshold: [0, 0.7, 1] },
    );
    cards.forEach((card) => cardObserver.observe(card));

    // Autoplay only while the carousel is on screen.
    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        schedule();
      },
      { threshold: 0.3 },
    ).observe(root);

    root.classList.add('is-ready');
    setActive(0);
    setWantsPlay(wantsPlay);
  });
</script>
