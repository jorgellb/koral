---
import { useTranslations, getLangFromUrl } from '../i18n/utils';
import { pathFor } from '../i18n/routes';
import SectionHeading from './ui/SectionHeading.astro';
import CoastMap from './svg/CoastMap.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const towns = ['Vera', 'Garrucha', 'Mojácar', 'Cuevas del Almanzora', 'Turre', 'Antas', 'Los Gallardos', 'Palomares'];
---

<section class="section-y relative overflow-hidden bg-sand !pt-12">
  <div class="container-k">
    <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-6">
        <SectionHeading eyebrow={t('areas.eyebrow')} title={t('areas.title')} description={t('areas.desc')} />

        <ul class="mt-8 flex flex-wrap gap-2" data-reveal style="--d:.1s">
          {towns.map((town, i) => (
            <li class:list={['rounded-full border px-4 py-2 text-sm', i === 0 ? 'border-coral bg-coral text-white' : 'border-ocean-900/10 bg-white text-ocean-900']}>{town}</li>
          ))}
        </ul>

        <div class="mt-10 grid gap-4 sm:grid-cols-2" data-reveal style="--d:.2s">
          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] ring-1 ring-ocean-900/5">
            <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">{t('footer.location.title')}</p>
            <p class="mt-2 font-semibold leading-snug">Av. de Baria, 4, local<br />04620 Vera, Almería</p>
            <a href="https://www.google.com/maps/dir/?api=1&destination=Clinica+Dental+Koral+Vera+Almeria" target="_blank" rel="noopener" class="link-u mt-3 inline-block text-sm font-semibold text-accent">{t('footer.location.how-to-get')} →</a>
          </div>
          <div class="rounded-[1.5rem] bg-white p-6 shadow-[var(--shadow-soft)] ring-1 ring-ocean-900/5">
            <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">{t('footer.schedule.title')}</p>
            <p class="mt-2 text-[14.5px] leading-relaxed">
              <span class="tabular">{t('footer.schedule.mon')} · 10:00–20:00</span><br />
              <span class="tabular">{t('footer.schedule.wed')} · 10:00–18:00</span><br />
              <span class="text-slate-500">{t('footer.schedule.tue')}, {t('footer.schedule.thu')}, {t('footer.schedule.fri')} · 08:00–16:00</span>
            </p>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--d:.3s">
          <a href={pathFor('contact', lang)} class="btn btn-dark">{t('nav.contact')}</a>
          <a href="tel:+34950395319" class="btn btn-outline tabular">+34 950 39 53 19</a>
        </div>
      </div>

      <div class="lg:col-span-6" data-reveal="scale">
        <div class="relative mx-auto max-w-[520px] overflow-hidden rounded-[2.25rem] shadow-[var(--shadow-premium)] ring-1 ring-ocean-900/10">
          <CoastMap seaLabel={t('areas.sea')} />
        </div>
      </div>
    </div>
  </div>
</section>
