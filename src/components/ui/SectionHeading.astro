---
/**
 * Standard section header: eyebrow label, serif title with an optional italic
 * coral accent, and an optional lead paragraph.
 * `split` puts the description to the right of the title on large screens.
 */
interface Props {
  eyebrow?: string;
  title: string;
  accent?: string;
  description?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  as?: 'h1' | 'h2' | 'h3';
  split?: boolean;
  class?: string;
}

const {
  eyebrow,
  title,
  accent,
  description,
  align = 'left',
  tone = 'light',
  as: Tag = 'h2',
  split = false,
  class: className = '',
} = Astro.props;

const dark = tone === 'dark';
const center = align === 'center';
---

<div
  class:list={[
    'section-heading',
    split ? 'grid gap-8 lg:grid-cols-12 lg:items-end' : center ? 'mx-auto max-w-3xl text-center' : 'max-w-3xl',
    className,
  ]}
  data-reveal
>
  <div class:list={[split && 'lg:col-span-7']}>
    {eyebrow && (
      <p class:list={['eyebrow mb-5', { 'eyebrow-light': dark, 'eyebrow-center justify-center': center && !split }]}>{eyebrow}</p>
    )}
    <Tag
      class:list={[
        'text-[2.35rem] leading-[1.06] sm:text-5xl lg:text-[3.6rem]',
        dark ? 'text-white' : 'text-ocean-900',
      ]}
    >
      {title}
      {accent && <span class="accent-italic block sm:inline"> {accent}</span>}
    </Tag>
  </div>
  {description && (
    <p
      class:list={[
        'text-lg leading-relaxed',
        dark ? 'text-white/70' : 'text-slate-600',
        split ? 'lg:col-span-5 lg:pb-2' : 'mt-6',
        center && !split && 'mx-auto max-w-2xl',
      ]}
    >
      {description}
    </p>
  )}
  <slot />
</div>
